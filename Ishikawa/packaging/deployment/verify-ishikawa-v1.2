#!/usr/bin/env bash
set -Eeuo pipefail

# Purpose:
#   Verify every file in one complete Ishikawa v1.2 deployment candidate.
#
# Mental model:
#   Reject links and unexpected files, verify the outer and component checksum
#   manifests, then bind the accepted routing, retrieval, structured-generation,
#   observability, and final database-schema identities.
#
# Inputs or prerequisites:
#   An extracted candidate containing application, database, and SHA256SUMS.
#
# Outputs:
#   One content-free pass or blocked marker. Nothing is installed or changed.
#
# Usage:
#   bash ./verify-ishikawa-v1.2

usage() {
  printf '%s\n' 'Usage: verify-ishikawa-v1.2'
}

fail() {
  printf 'ishikawa_v1_2_verification=blocked;reason=%s\n' "$1" >&2
  exit 1
}

if (( $# > 0 )); then
  [[ $# == 1 && ( "$1" == --help || "$1" == -h ) ]] || fail 'argument_invalid'
  usage
  exit 0
fi

readonly package_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
readonly manifest="$package_root/SHA256SUMS"
readonly application_root="$package_root/application"
readonly database_root="$package_root/database"
readonly routing_module="$application_root/payload/application/python/ishikawa/query_routing.py"
readonly retrieval_service_module="$application_root/payload/application/python/ishikawa/retrieval_service.py"
readonly native_adapters_module="$application_root/payload/application/python/ishikawa/native_adapters.py"
readonly generation_module="$application_root/payload/application/python/ishikawa/generation.py"
readonly observability_module="$application_root/payload/application/python/ishikawa/observability.py"
readonly method_profile="$application_root/payload/config/method_profile.yaml"
readonly final_schema="$database_root/schema.sql"
readonly routing_module_sha256='15e832bf973ea11edccbe0e593546c2d1656dfc39e871870d3c5b58f1e6eaebb'
readonly retrieval_service_module_sha256='b297358b691fdfaf987c89b9e5b5539f083545c22b2be7cbabd1cf1a08b9c6b1'
readonly native_adapters_module_sha256='0a427682f63288baa3faaa1849f74eb3411688112f691531c693e5da83187138'
readonly generation_module_sha256='b72aa72b9c89c5f8aea1efe3ce6e6d47d63aa395efd70223f4737abdae10d11f'
readonly observability_module_sha256='b14cd34e763cbd008ef2eed99011afe04bdb74a6c509e7e91c488e17586d743d'
readonly method_profile_sha256='0d329981f1259e5d5f8138350af538a08a3d70a704241b384da6714f3b17724c'
readonly final_schema_sha256='5cfd397152b726aedc97be84d8a06fc8f21cad6e1a11563e5e9dd3a1f026d568'

for required in awk cmp find grep mktemp rm sha256sum sort; do
  command -v "$required" >/dev/null 2>&1 || fail 'required_command_missing'
done
for directory in "$package_root" "$application_root" "$database_root"; do
  [[ -d "$directory" && ! -L "$directory" ]] || fail 'package_directory_unsafe'
done
for file in \
  "$manifest" \
  "$application_root/SHA256SUMS" \
  "$database_root/SHA256SUMS" \
  "$routing_module" \
  "$retrieval_service_module" \
  "$native_adapters_module" \
  "$generation_module" \
  "$observability_module" \
  "$method_profile" \
  "$final_schema"; do
  [[ -f "$file" && ! -L "$file" && -r "$file" ]] || fail 'package_file_unsafe'
done
find "$package_root" -type l -print -quit | grep -q . && fail 'package_symlink_found'

temporary_root="$(mktemp -d /tmp/ishikawa-v1.2-verification.XXXXXX)"
cleanup() {
  local status="$?"
  trap - EXIT INT TERM
  [[ "$temporary_root" == /tmp/ishikawa-v1.2-verification.* && -d "$temporary_root" ]] \
    && rm -rf -- "$temporary_root"
  exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

(cd -- "$package_root" && find . -type f ! -path './SHA256SUMS' -printf '%P\n' | sort) \
  >"$temporary_root/actual-files.txt"
awk '{print $2}' "$manifest" | sort >"$temporary_root/manifest-files.txt"
cmp -s "$temporary_root/actual-files.txt" "$temporary_root/manifest-files.txt" \
  || fail 'package_inventory_mismatch'

(cd -- "$package_root" && sha256sum --check --strict SHA256SUMS >/dev/null) \
  || fail 'package_checksum_failed'
(cd -- "$application_root" && sha256sum --check --strict SHA256SUMS >/dev/null) \
  || fail 'application_checksum_failed'
(cd -- "$database_root" && sha256sum --check --strict SHA256SUMS >/dev/null) \
  || fail 'database_checksum_failed'

[[ "$(sha256sum "$routing_module" | awk '{print $1}')" == "$routing_module_sha256" ]] \
  || fail 'routing_module_identity_mismatch'
[[ "$(sha256sum "$retrieval_service_module" | awk '{print $1}')" == "$retrieval_service_module_sha256" ]] \
  || fail 'retrieval_service_module_identity_mismatch'
[[ "$(sha256sum "$native_adapters_module" | awk '{print $1}')" == "$native_adapters_module_sha256" ]] \
  || fail 'native_adapters_module_identity_mismatch'
[[ "$(sha256sum "$generation_module" | awk '{print $1}')" == "$generation_module_sha256" ]] \
  || fail 'generation_module_identity_mismatch'
[[ "$(sha256sum "$observability_module" | awk '{print $1}')" == "$observability_module_sha256" ]] \
  || fail 'observability_module_identity_mismatch'
[[ "$(sha256sum "$method_profile" | awk '{print $1}')" == "$method_profile_sha256" ]] \
  || fail 'method_profile_identity_mismatch'
[[ "$(sha256sum "$final_schema" | awk '{print $1}')" == "$final_schema_sha256" ]] \
  || fail 'final_schema_identity_mismatch'

[[ "$(find "$application_root/payload/application/python/ishikawa" -maxdepth 1 -type f -name '*.py' | awk 'END {print NR+0}')" == 48 ]] \
  || fail 'python_module_count_mismatch'
[[ "$(find "$application_root/payload/docs" -maxdepth 1 -type f -name '*.md' | awk 'END {print NR+0}')" == 10 ]] \
  || fail 'operator_document_count_mismatch'

if find "$package_root" -type f \( -name '*.pyc' -o -name '*.pyo' \) -print -quit | grep -q . \
  || find "$package_root" -type d -name __pycache__ -print -quit | grep -q .; then
  fail 'generated_python_file_found'
fi
if find "$package_root" -type f \( -iname '*migration*' -o -iname '*mutation*' -o -iname '*patch*' -o -iname '*repair*' \) -print -quit | grep -q .; then
  fail 'historical_mutation_file_found'
fi

printf 'ishikawa_v1_2_verification=pass;application=final;database_schema=version_4;python_modules=48;operator_documents=10;document_page_routing=bound;structured_generation=bound;historical_mutation_files=0\n'
