#!/usr/bin/env bash
set -Eeuo pipefail

# Purpose:
#   Install one checksum-verified Ishikawa application payload into a new host
#   directory without configuring dependencies or mutating external services.
#
# Mental model:
#   Verify the complete package, reject unsafe paths, copy into a private
#   sibling staging directory, validate the installed shape, and publish the
#   installation with one rename. Never merge with an existing installation.
#
# Inputs or prerequisites:
#   A verified extracted package, Python 3.12 or later, standard GNU host
#   utilities, and one absolute --install-root owned by the operator.
#
# Outputs:
#   A new Ishikawa host directory. No database, service, model endpoint,
#   credential, or source-document state is changed.
#
# Usage:
#   bash ./install-ishikawa --install-root "$HOME/Documents/Ishikawa"

usage() {
  printf '%s\n' 'Usage: install-ishikawa --install-root ABSOLUTE-PATH'
}

fail() {
  printf 'ishikawa_install=blocked;reason=%s\n' "$1" >&2
  exit 1
}

install_root=''
while (( $# > 0 )); do
  case "$1" in
    --install-root)
      (( $# >= 2 )) || fail 'install_root_missing'
      install_root="$2"
      shift 2
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      fail 'arguments_invalid'
      ;;
  esac
done

[[ -n "$install_root" && "$install_root" == /* && "$install_root" != / ]] || \
  fail 'install_root_invalid'
[[ ! -e "$install_root" && ! -L "$install_root" ]] || \
  fail 'install_root_exists'

for required in cp dirname find mkdir mktemp mv python3 readlink rm sha256sum; do
  command -v "$required" >/dev/null 2>&1 || fail 'required_command_missing'
done

readonly bundle_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
readonly payload_root="$bundle_root/payload"
readonly checksum_file="$bundle_root/SHA256SUMS"
[[ -d "$payload_root" && ! -L "$payload_root" ]] || fail 'payload_missing'
[[ -f "$checksum_file" && ! -L "$checksum_file" ]] || fail 'checksum_manifest_missing'

(
  cd -- "$bundle_root"
  sha256sum --check --strict SHA256SUMS >/dev/null
) || fail 'package_checksum_failed'

python3 -B - "$bundle_root" <<'PY' || fail 'package_path_contract_failed'
from pathlib import Path
import sys

root = Path(sys.argv[1]).resolve(strict=True)
allowed_roots = {"README.md", "SHA256SUMS", "install-ishikawa", "payload"}
if {item.name for item in root.iterdir()} != allowed_roots:
    raise SystemExit(1)
manifest_entries = set()
for line in (root / "SHA256SUMS").read_text(encoding="utf-8").splitlines():
    digest, separator, name = line.partition("  ")
    if len(digest) != 64 or separator != "  " or not name or name in manifest_entries:
        raise SystemExit(1)
    manifest_entries.add(name)
actual_files = {
    item.relative_to(root).as_posix()
    for item in root.rglob("*")
    if item.is_file() and item.name != "SHA256SUMS"
}
if manifest_entries != actual_files:
    raise SystemExit(1)
for item in root.rglob("*"):
    if item.is_symlink() or not item.resolve(strict=True).is_relative_to(root):
        raise SystemExit(1)
    if "__pycache__" in item.parts or item.suffix in {".pyc", ".pyo"}:
        raise SystemExit(1)
PY

parent="$(dirname -- "$install_root")"
mkdir -p -- "$parent"
[[ -d "$parent" && ! -L "$parent" ]] || fail 'install_parent_unsafe'
parent="$(readlink -f -- "$parent")"
[[ "$install_root" == "$parent/"* ]] || fail 'install_root_resolution_invalid'

stage="$(mktemp -d "$parent/.ishikawa-install.XXXXXX")"
cleanup() {
  local status="$?"
  trap - EXIT INT TERM
  if [[ "$stage" == "$parent"/.ishikawa-install.* && -d "$stage" ]]; then
    rm -rf -- "$stage"
  fi
  exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

cp -a -- "$payload_root/." "$stage/"
mkdir -p -- \
  "$stage/config/ingestion/pending" \
  "$stage/config/ingestion/completed" \
  "$stage/config/ingestion/rejected" \
  "$stage/corpus/source/organization-wide/policies" \
  "$stage/corpus/source/organization-wide/procedures" \
  "$stage/corpus/source/organization-wide/code-of-conduct" \
  "$stage/corpus/source/external/regulations" \
  "$stage/state/artifacts/sha256" \
  "$stage/state/work" \
  "$stage/state/quarantine" \
  "$stage/state/reports/ingestion" \
  "$stage/state/logs" \
  "$stage/state/run" \
  "$stage/state/backups"

python3 -B - "$stage" <<'PY' || fail 'installed_layout_invalid'
from pathlib import Path
import sys

root = Path(sys.argv[1]).resolve(strict=True)
required_files = (
    "application/python/ishikawa/__init__.py",
    "application/web/package.json",
    "application/web/app/page.js",
    "application/web/app/api/v1/chat/route.js",
    "config/product.yaml",
    "config/deployment.yaml",
    "config/corpus_metadata.csv",
    "config/document_classes.yaml",
    "config/document_catalog.yaml",
    "config/ingestion_dependencies.yaml",
    "config/logging_profile.yaml",
    "scripts/ishikawa-ingest",
    "scripts/ishikawa-create-ingestion-config",
    "scripts/ishikawa-log-control",
    "scripts/ishikawa-observability-retention",
    "scripts/ishikawa-produce-artifacts",
    "scripts/ishikawa-retrieval-api",
    "scripts/ishikawa-stack",
    "systemd/ishikawa-retrieval-api.service",
    "systemd/ishikawa-observability-retention.service",
    "systemd/ishikawa-observability-retention.timer",
    "docs/CHAT_UI.md",
    "docs/OPERATOR_INGESTION.md",
    "docs/SERVICE_OPERATIONS.md",
    "docs/STACK_CONTROL.md",
)
required_directories = (
    "config/ingestion/pending",
    "corpus/source",
    "state/artifacts/sha256",
    "state/work",
    "state/quarantine",
    "state/reports/ingestion",
    "state/logs",
    "state/run",
)
if not all((root / name).is_file() for name in required_files):
    raise SystemExit(1)
if not all((root / name).is_dir() for name in required_directories):
    raise SystemExit(1)
if any(item.is_symlink() for item in root.rglob("*")):
    raise SystemExit(1)
PY

mv -- "$stage" "$install_root"
stage=''
printf 'ishikawa_install=pass;install_root=%s;database_changed=false;service_changed=false;source_documents_copied=false\n' \
  "$install_root"
