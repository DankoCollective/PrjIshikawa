#!/usr/bin/env python3
"""Installed operator command for local Ishikawa logging control."""

from __future__ import annotations

import os
import sys
from pathlib import Path


def main() -> int:
    os.umask(0o077)
    product_root = Path(__file__).resolve(strict=True).parent.parent
    python_root = (product_root / "application" / "python").resolve(strict=True)
    sys.path.insert(0, str(python_root))
    from ishikawa.logging_control import execute_logging_control

    return execute_logging_control(
        sys.argv[1:],
        product_root=product_root,
        output=sys.stdout,
    )


if __name__ == "__main__":
    raise SystemExit(main())
