#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

# Build the external Ishikawa v1.3.1 application candidate on the native AMD64
# host against the exact retained generic runtime image. This helper is invoked
# from a private checksum-bound transfer directory and changes no service,
# database, listener, credential, corpus, or boot state.

readonly script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
readonly repo_root="$(cd -- "$script_dir/../.." && pwd -P)"
readonly application_builder="$repo_root/deployment/scripts/01_build-ishikawa-release.sh"
readonly runtime_root="${ISHIKAWA_RUNTIME_HANDOFF_ROOT:-$repo_root/runtime-handoff}"
readonly runtime_identity="$runtime_root/image-identity.json"
readonly runtime_receipt="$runtime_root/build-receipt.json"
readonly application_current="$repo_root/local/artifacts/ishikawa-v1.3.1-candidate-current"
readonly frozen_hostname='EmceeDanko'
readonly frozen_os_version='24.04'
readonly image_reference='node-next-runtime:24.22.1-next16.4.3-react19.2.9-amd64'

mode="${1:-}"
shift || true
expected_hostname=''
expected_os_version=''
current_stage='argument_validation'
work_root=''

result() {
  printf '\nSCRIPT RESULT\nv1_3_1_application_build=%s\n' "$1"
}

block() {
  local reason="$1" detail="$2" action="$3"
  printf '%s\n' \
    'FAILURE DETAIL' \
    "stage=$current_stage" \
    "reason=$reason" \
    "detail=$detail" \
    "operator_action=$action" >&2
  result blocked >&2
  exit 1
}

unexpected_error() {
  local status="$1" line="$2"
  trap - ERR
  block unexpected_command_failure \
    "An unhandled command failed at application-build helper line ${line} with exit code ${status}." \
    'Review the retained wrapper report and correct the complete failing stage.'
}

cleanup() {
  local status="$?"
  trap - EXIT INT TERM
  if [[ -n "$work_root" && "$work_root" == /tmp/ishikawa-application-build.* \
      && -d "$work_root" && ! -L "$work_root" ]]; then
    rm -rf -- "$work_root"
  fi
  exit "$status"
}
trap cleanup EXIT
trap 'unexpected_error "$?" "$LINENO"' ERR
trap 'current_stage=interrupted; block signal_interrupt "Application build was interrupted." "Review the retained wrapper report and rerun the same command."' INT
trap 'current_stage=interrupted; block signal_termination "Application build received SIGTERM." "Review the retained wrapper report and rerun the same command."' TERM

while (( $# > 0 )); do
  case "$1" in
    --expected-hostname)
      [[ $# -ge 2 ]] || block hostname_missing 'The expected hostname is missing.' 'Supply the exact short hostname.'
      expected_hostname="$2"
      shift 2
      ;;
    --expected-os-version)
      [[ $# -ge 2 ]] || block os_version_missing 'The expected operating-system version is missing.' 'Supply NN.NN.'
      expected_os_version="$2"
      shift 2
      ;;
    --help|-h)
      printf '%s\n' \
        'Usage: build-v1.3.1-application-on-emceedanko --validate-only' \
        '       build-v1.3.1-application-on-emceedanko --run --expected-hostname NAME --expected-os-version NN.NN'
      exit 0
      ;;
    *) block unsupported_argument "Unsupported argument: $1" 'Use --help and rerun.' ;;
  esac
done

[[ "$mode" == --validate-only || "$mode" == --run ]] \
  || block mode_invalid 'Select exactly one execution mode.' 'Use --validate-only or --run.'
if [[ "$mode" == --run ]]; then
  [[ -n "$expected_hostname" && -n "$expected_os_version" ]] \
    || block expected_host_identity_missing \
      'Run mode requires the expected hostname and Ubuntu version.' \
      'Supply both frozen host-identity arguments.'
fi
if [[ -n "$expected_hostname" ]]; then
  [[ "$expected_hostname" =~ ^[A-Za-z0-9][A-Za-z0-9.-]*$ ]] \
    || block hostname_invalid 'The expected hostname is invalid.' 'Correct the hostname.'
fi
if [[ -n "$expected_os_version" ]]; then
  [[ "$expected_os_version" =~ ^[0-9]{2}\.[0-9]{2}$ ]] \
    || block os_version_invalid 'The expected Ubuntu version is invalid.' 'Use NN.NN.'
fi
[[ "$mode" != --run || ( "$expected_hostname" == "$frozen_hostname" \
    && "$expected_os_version" == "$frozen_os_version" ) ]] \
  || block frozen_build_host_changed \
    'The application build is frozen to EmceeDanko on Ubuntu 24.04.' \
    'Restore the frozen native build host or stop for an operator decision.'

current_stage='source_preflight'
# Keep this union aligned with every command required by Script 01 so the
# native helper reports a missing host prerequisite directly instead of
# collapsing it into a nested validation failure.
for command_name in awk bash cmp cp date df diff docker dpkg find grep gzip \
  hostname id install jq kill mkdir mktemp mv nproc python3 readlink rm sed \
  sha256sum sort stat sudo tail tar tee uname; do
  command -v "$command_name" >/dev/null 2>&1 \
    || block "command_missing_${command_name}" \
      "Required command unavailable: ${command_name}." \
      'Restore the named command and rerun.'
done
for required_file in "$application_builder" "$runtime_identity" "$runtime_receipt"; do
  [[ -f "$required_file" && ! -L "$required_file" && -r "$required_file" ]] \
    || block required_file_unsafe \
      "A required build input is missing, unreadable, or a symbolic link: ${required_file}." \
      'Restore the checksum-bound payload and rerun.'
done
bash -n "${BASH_SOURCE[0]}" "$application_builder" \
  || block shell_syntax_invalid \
    'The native helper or application builder failed shell parsing.' \
    'Correct every parse error before execution.'
trap - ERR
set +e
builder_validation="$(bash "$application_builder" --validate-only 2>&1)"
builder_validation_status="$?"
set -e
trap 'unexpected_error "$?" "$LINENO"' ERR
if (( builder_validation_status != 0 )); then
  printf '%s\n' "$builder_validation" >&2
  nested_reason="$(sed -n 's/^reason=\([a-z0-9_]*\)$/\1/p' \
    <<<"$builder_validation" | tail -n 1)"
  block "${nested_reason:-application_builder_validation_failed}" \
    "The application builder validation exited with status ${builder_validation_status}." \
    'Correct the complete nested validation detail before execution.'
fi
grep -Fxq 'script_01_build_ishikawa_release=ready' <<<"$builder_validation" \
  || block application_builder_ready_marker_missing \
    'The application builder omitted its exact ready marker.' \
    'Treat the transferred builder as unvalidated.'
jq -e '
  .schema == "node-next-runtime-image.v1"
  and .architecture == "amd64"
  and .platform == "linux/amd64"
  and .application_in_image == false
  and .generated_next_in_image == false
  and .image_reference == "node-next-runtime:24.22.1-next16.4.3-react19.2.9-amd64"
  and (.image_id | test("^sha256:[0-9a-f]{64}$"))
  and (.config_digest | test("^sha256:[0-9a-f]{64}$"))
  and (.history_sha256 | test("^[0-9a-f]{64}$"))
  and .node == "24.22.1"
  and .npm == "11.19.1"
  and .yarn == "1.22.22"
  and .next == "16.4.3"
  and .react == "19.2.9"
  and .react_dom == "19.2.9"' "$runtime_identity" >/dev/null \
  || block runtime_identity_invalid \
    'The transferred runtime identity does not match the frozen application-build dependency.' \
    'Restore the corrected Script 07 handoff.'
for field in image_id image_reference archive_sha256 architecture platform \
  config_digest history_sha256; do
  [[ "$(jq -r --arg field "$field" '.[$field]' "$runtime_receipt")" \
      == "$(jq -r --arg field "$field" '.[$field]' "$runtime_identity")" ]] \
    || block runtime_receipt_mismatch \
      "The runtime build receipt disagrees with image identity field: ${field}." \
      'Restore the corrected Script 07 handoff.'
done

if [[ "$mode" == --validate-only ]]; then
  printf '%s\n' \
    'purpose=validate_native_amd64_application_build_payload' \
    'runtime_identity=pass;application_source=pass;target_contact=false;target_mutation=false'
  result ready
  exit 0
fi

current_stage='native_host_preflight'
actual_hostname="$(hostname -s)"
[[ "$actual_hostname" == "$expected_hostname" ]] \
  || block build_host_mismatch \
    'The connected host does not match the frozen native application-build host.' \
    'Stop and correct the SSH target.'
os_release_path="$(readlink -f /etc/os-release)"
[[ "$os_release_path" == /* && -f "$os_release_path" && ! -L "$os_release_path" \
    && -r "$os_release_path" ]] \
  || block os_release_unsafe 'The operating-system identity file is unsafe.' 'Correct the host identity.'
# shellcheck disable=SC1090
source "$os_release_path"
[[ "${ID:-}" == ubuntu && "${VERSION_ID:-}" == "$expected_os_version" ]] \
  || block build_os_mismatch \
    'The connected host is not the frozen Ubuntu release.' \
    'Stop and correct the SSH target.'
[[ "$(uname -m)" == x86_64 && "$(dpkg --print-architecture)" == amd64 ]] \
  || block native_amd64_build_host_required \
    'The application build requires a native Linux AMD64 host.' \
    'Run through the approved EmceeDanko wrapper.'
cpu_count="$(nproc)"
memory_available_kib="$(awk '/^MemAvailable:/ {print $2; exit}' /proc/meminfo)"
temporary_available_kib="$(df -Pk /tmp | awk 'NR == 2 {print $4}')"
artifact_available_kib="$(df -Pk "$repo_root" | awk 'NR == 2 {print $4}')"
[[ "$cpu_count" =~ ^[0-9]+$ && "$cpu_count" -ge 2 ]] \
  || block build_cpu_capacity_insufficient 'Fewer than two CPUs are available.' 'Restore host capacity and rerun.'
[[ "$memory_available_kib" =~ ^[0-9]+$ && "$memory_available_kib" -ge 4194304 ]] \
  || block build_memory_capacity_insufficient 'Less than 4 GiB memory is available.' 'Restore host capacity and rerun.'
[[ "$temporary_available_kib" =~ ^[0-9]+$ && "$temporary_available_kib" -ge 1048576 ]] \
  || block temporary_capacity_insufficient 'Less than 1 GiB is available under /tmp.' 'Restore host capacity and rerun.'
[[ "$artifact_available_kib" =~ ^[0-9]+$ && "$artifact_available_kib" -ge 1048576 ]] \
  || block artifact_capacity_insufficient 'Less than 1 GiB is available for the private build payload.' 'Restore host capacity and rerun.'
printf '[HOST] state=pass;os=ubuntu_%s;architecture=amd64;capacity=pass\n' "$expected_os_version"

current_stage='container_access'
docker_command=(docker)
if ! docker info >/dev/null 2>&1; then
  printf '[DOCKER] state=awaiting_attended_sudo\n'
  sudo -v \
    || block sudo_authentication_failed \
      'Attended sudo authentication for Docker failed.' \
      'Authenticate on EmceeDanko and rerun.'
  docker_command=(sudo docker)
  "${docker_command[@]}" info >/dev/null 2>&1 \
    || block docker_access_failed \
      'Docker remained unavailable after attended sudo.' \
      'Restore Docker access and rerun.'
fi
"${docker_command[@]}" image inspect "$image_reference" >/dev/null 2>&1 \
  || block retained_runtime_image_missing \
    'The exact Script 07 runtime-image reference is not loaded on EmceeDanko.' \
    'Rerun corrected Script 07 before the application build.'
expected_image_id="$(jq -r '.image_id' "$runtime_identity")"
actual_image_id="$("${docker_command[@]}" image inspect "$image_reference" --format '{{.Id}}')"
actual_image_architecture="$("${docker_command[@]}" image inspect "$image_reference" --format '{{.Architecture}}')"
[[ "$actual_image_id" == "$expected_image_id" && "$actual_image_architecture" == amd64 ]] \
  || block retained_runtime_image_mismatch \
    'The loaded runtime image differs from the corrected Script 07 handoff.' \
    'Rerun corrected Script 07 and do not build against a stale tag.'
printf '[IMAGE] state=pass;image_id=%s;architecture=amd64\n' "$actual_image_id"

current_stage='application_build'
work_root="$(mktemp -d /tmp/ishikawa-application-build.XXXXXX)" \
  || block workspace_creation_failed 'The private application-build workspace could not be created.' 'Correct /tmp and rerun.'
build_stream="$work_root/application-build.txt"
trap - ERR
set +e
bash "$application_builder" --run 2>&1 | tee "$build_stream"
builder_status="${PIPESTATUS[0]}"
set -e
trap 'unexpected_error "$?" "$LINENO"' ERR
if (( builder_status != 0 )); then
  nested_reason="$(sed -n 's/^reason=\([a-z0-9_]*\)$/\1/p' "$build_stream" | tail -n 1)"
  block "${nested_reason:-application_builder_failed}" \
    "The application builder exited with status ${builder_status}." \
    'Correct the complete retained failure detail and rerun.'
fi
grep -Fxq 'script_01_build_ishikawa_release=pass' "$build_stream" \
  || block application_builder_result_missing \
    'The application builder omitted its standalone pass result.' \
    'Treat the application handoff as unqualified.'

current_stage='handoff_verification'
[[ -d "$application_current" && ! -L "$application_current" ]] \
  || block application_handoff_missing \
    'The application builder did not publish its canonical candidate handoff.' \
    'Review the retained application-build output.'
unsafe_entry="$(find "$application_current" -mindepth 1 ! -type f -print -quit)"
[[ -z "$unsafe_entry" ]] \
  || block application_handoff_type_invalid \
    'The application handoff contains a non-regular entry.' \
    'Do not return the application handoff.'
expected_names="$(printf '%s\n' \
  ISHIKAWA_V1_3_1_SOURCE_SHA256SUMS SHA256SUMS application-license.json \
  application-sbom.cdx.json ishikawa-v1.3.1.tar.gz \
  ishikawa-v1.3.1.tar.gz.sha256 release-receipt.json | sort)"
actual_names="$(find "$application_current" -maxdepth 1 -type f -printf '%f\n' | sort)"
[[ "$actual_names" == "$expected_names" ]] \
  || block application_handoff_inventory_invalid \
    'The application handoff inventory differs from the canonical set.' \
    'Do not return the application handoff.'
(
  cd -- "$application_current"
  sha256sum --check --strict SHA256SUMS >/dev/null
  sha256sum --check --strict ishikawa-v1.3.1.tar.gz.sha256 >/dev/null
) || block application_handoff_checksum_failed \
  'The application handoff failed its checksum manifests.' \
  'Do not return the application handoff.'
jq -e '
  .release == "Ishikawa v1.3.1 candidate"
  and .coding_standard == "pass"
  and .deterministic_archive == true
  and .fresh_install == "pass"
  and .human_ui_validation == "pending_exact_candidate_requalification"' \
  "$application_current/release-receipt.json" >/dev/null \
  || block application_receipt_invalid \
    'The application receipt does not describe the expected unpromoted candidate.' \
    'Do not return the application handoff.'
application_sha256="$(sha256sum -- "$application_current/ishikawa-v1.3.1.tar.gz" | awk '{print $1}')"
printf '[APPLICATION] state=pass;archive_sha256=%s;runtime_image_id=%s\n' \
  "$application_sha256" "$actual_image_id"
printf '[NEXT] gate=return_verified_application_handoff\n'
result pass
