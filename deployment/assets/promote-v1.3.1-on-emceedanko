}

restore_old_runtime() {
  set +e
  if [[ -d "$final_root" && ! -L "$final_root" ]]; then
    stop_new_runtime >/dev/null 2>&1 || { set -e; return 1; }
    if postgresql_status "$final_root" \
        || container_exists "$new_container" \
        || pid_is_api "$(read_pid "$final_root/state/run/emceedanko-v1.3.1.pid" 2>/dev/null || true)" "$final_root"; then
      set -e
      return 1
    fi
  fi
  remove_container "$new_container" >/dev/null 2>&1 || { set -e; return 1; }
  local state_source=''
  if [[ -d "$final_root/state" && ! -L "$final_root/state" ]]; then
    state_source="$final_root/state"
  elif [[ -n "$application_stage" && -d "$application_stage/state" && ! -L "$application_stage/state" ]]; then
    state_source="$application_stage/state"
  fi
  if [[ -d "$rollback_root" && ! -L "$rollback_root" ]]; then
    if [[ -n "$state_source" ]]; then
      rm -rf -- "$rollback_root/state"
      mv -- "$state_source" "$rollback_root/state" || { set -e; return 1; }
    fi
    [[ ! -e "$final_root" && ! -L "$final_root" ]] || rm -rf -- "$final_root"
