start_old_runtime() {
  local pid
  postgresql_status "$old_root" || start_postgresql "$old_root" || return 1
  application_readiness "$old_root" || return 1
  pid="$(read_pid "$old_root/state/run/attended-v1.3.pid" 2>/dev/null || true)"
  if ! pid_is_api "$pid" "$old_root"; then
    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
      return 1
    fi
    rm -f -- "$old_root/state/run/attended-v1.3.pid"
    start_api "$old_root" 'attended-v1.3.pid' || return 1
  fi
  wait_http "http://127.0.0.1:${retrieval_port}/ready" 180 API || return 1
  if ! container_running "$old_container"; then
    remove_container "$old_container" || return 1
    start_old_web || return 1
  fi
  old_runtime_ready && database_inventory_valid
}

start_new_runtime() {
  start_postgresql "$final_root" || return 1
  application_readiness "$final_root" || return 1
  start_api "$final_root" 'emceedanko-v1.3.1.pid' || return 1
