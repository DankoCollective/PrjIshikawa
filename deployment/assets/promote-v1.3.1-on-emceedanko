#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

# Purpose:
#   Promote the exact accepted Ishikawa v1.3.1 application and generic web
#   image into the active EmceeDanko runtime without changing corpus-v3.
# Mental model:
#   Stage and validate immutable v1.3.1 bytes while v1.3 remains ready. At the
#   switch boundary, stop v1.3, move its stopped state into the new versioned
#   application root, and launch v1.3.1 on the accepted ports. Restore v1.3
#   automatically on failed launch. Human acceptance later retires the old
#   root and old image; explicit rollback remains available until acceptance.
# Inputs or prerequisites:
#   Script 07/08 handoffs, all three Script 09 receipts, accepted v1.3,
#   externally managed model tunnels, and attended runtime credentials.
# Outputs:
#   A content-free action receipt. Run mode leaves v1.3.1 active and v1.3 as a
#   rollback source; accept finalizes; rollback restores v1.3.

readonly expected_application_sha256='2dbf08b9e15fb4436e54ce492f2ad430129e794d33a1a45cdc6abf1a7b0b5f69'
readonly expected_old_application_sha256='53da57b745fb4c8be6335896d05bdb6f63f2de3494862b99acca09e156863f3c'
readonly expected_runtime_archive_sha256='af95820f63798b39c6538e3f9b5653d47b07aed1d81625e2382485ff559eff3f'
readonly expected_new_image_id='sha256:79f39435329920c9c834e55cf5e18528540220111ae2a35d779a86d0b539d298'
readonly expected_old_image_id='sha256:368f4381b61bf90ad27aa5a9dd4c10e1de0b4b4666006911e1b6cb4aafcfb8a6'
readonly new_image_reference='node-next-runtime:24.22.1-next16.4.3-react19.2.9-amd64'
readonly old_image_reference='node-24-slim-nextjs-16-4-1:amd64'
readonly old_root="$HOME/Documents/Ishikawa-v1.3-attended"
readonly final_root="$HOME/Documents/Ishikawa-v1.3.1"
readonly rollback_root="$HOME/Documents/Ishikawa-v1.3-retired-for-v1.3.1"
readonly qualification_root="$HOME/Documents/Ishikawa-v1.3.1-qualification"
readonly old_container='ishikawa-v1.3-web'
readonly new_container='ishikawa-v1.3.1-web'
readonly qualification_container='ishikawa-v1.3.1-qualification-web'
readonly historical_v1_2_container='ishikawa-web'
readonly ui_port=3384
readonly retrieval_port=8384
readonly postgresql_port=5432
readonly gemma_base_url='http://127.0.0.1:18000'
readonly nomic_base_url='http://127.0.0.1:18001'
readonly web_tmpfs_bytes=536870912

mode="${1:-}"
shift || true
payload_root=''
result_path=''
expected_hostname='EmceeDanko'
expected_os_version='24.04'
expected_architecture='amd64'
expected_helper_sha256=''
stage='argument_validation'
complete=false
mutation_started=false
rollback_succeeded=false
cleanup_failed=false
application_stage=''
api_pid=''
docker_ready=false
declare -a docker_command=(docker)
gemma_key=''
nomic_key=''
postgresql_password=''

usage() {
  printf '%s\n' \
    'Usage: promote-v1.3.1-on-emceedanko --validate-only' \
    '       promote-v1.3.1-on-emceedanko {--run|--accept|--rollback}' \
    '         --payload-root PATH --result-path PATH' \
    '         --expected-hostname NAME --expected-os-version VERSION' \
    '         --expected-architecture amd64 --expected-helper-sha256 SHA256'
}

emit() { printf '[%s] %s\n' "$1" "$2"; }

write_action_result() {
  local state="$1" reason="${2:-none}" detail="${3:-none}"
  [[ -n "$result_path" ]] || return 0
  {
    printf 'schema=ishikawa.emceedanko-v1.3.1-promotion-action.v1\n'
    printf 'mode=%s\nstate=%s\nreason=%s\ndetail=%s\n' "${mode#--}" "$state" "$reason" "$detail"
    printf 'application_archive_sha256=%s\n' "$expected_application_sha256"
    printf 'runtime_archive_sha256=%s\n' "$expected_runtime_archive_sha256"
    printf 'image_id=%s\n' "$expected_new_image_id"
    printf 'database_mutated=false\nschema_mutated=false\ncorpus_mutated=false\nboot_autostart=false\n'
  } >"$result_path"
  chmod 0600 "$result_path"
}

http_status() {
  curl --silent --show-error --output /dev/null --write-out '%{http_code}' \
    --connect-timeout 2 --max-time 8 "$1" 2>/dev/null || printf 000
}

http_ready() { [[ "$(http_status "$1")" == 200 ]]; }

wait_http() {
  local url="$1" seconds="$2" label="$3" elapsed=0 next_heartbeat=15
  while (( elapsed < seconds )); do
    http_ready "$url" && return 0
    sleep 1
    elapsed=$((elapsed + 1))
    if (( elapsed >= next_heartbeat )); then
      emit "$label" "state=waiting;elapsed_seconds=$elapsed"
      next_heartbeat=$((next_heartbeat + 15))
    fi
  done
  return 1
}

port_listening() {
  ss -H -ltn "( sport = :$1 )" 2>/dev/null | grep -q .
}

prepare_docker() {
  [[ "$docker_ready" == true ]] && return 0
  if ! docker info >/dev/null 2>&1; then
    sudo -v >/dev/null || return 1
    docker_command=(sudo docker)
    "${docker_command[@]}" info >/dev/null 2>&1 || return 1
  fi
  docker_ready=true
}

container_exists() { "${docker_command[@]}" inspect "$1" >/dev/null 2>&1; }
container_running() {
  [[ "$("${docker_command[@]}" inspect --format '{{.State.Running}}' "$1" 2>/dev/null || true)" == true ]]
}

new_container_contract_valid() {
  local operator_identity
  operator_identity="$(id -u):$(id -g)"
  [[ "$("${docker_command[@]}" inspect --format '{{.Image}}' "$new_container" 2>/dev/null || true)" == "$expected_new_image_id" \
      && "$("${docker_command[@]}" inspect --format '{{.Config.User}}' "$new_container" 2>/dev/null || true)" == "$operator_identity" \
      && "$("${docker_command[@]}" inspect --format '{{.HostConfig.ReadonlyRootfs}}' "$new_container" 2>/dev/null || true)" == true \
      && "$("${docker_command[@]}" inspect --format '{{.HostConfig.NetworkMode}}' "$new_container" 2>/dev/null || true)" == host \
      && "$("${docker_command[@]}" inspect --format '{{.HostConfig.RestartPolicy.Name}}' "$new_container" 2>/dev/null || true)" == no \
      && "$("${docker_command[@]}" inspect --format '{{.HostConfig.PidsLimit}}' "$new_container" 2>/dev/null || true)" == 512 \
      && "$("${docker_command[@]}" inspect --format '{{json .HostConfig.CapDrop}}' "$new_container" 2>/dev/null || true)" == '["ALL"]' \
      && "$("${docker_command[@]}" inspect --format '{{json .HostConfig.SecurityOpt}}' "$new_container" 2>/dev/null || true)" == '["no-new-privileges"]' \
      && "$("${docker_command[@]}" inspect --format '{{index .HostConfig.Tmpfs "/opt/nextjs/.next"}}' "$new_container" 2>/dev/null || true)" == *"size=${web_tmpfs_bytes}"* ]]
}

remove_container() {
  local name="$1"
  container_exists "$name" || return 0
  container_running "$name" && "${docker_command[@]}" stop --time 20 "$name" >/dev/null 2>&1 || true
  "${docker_command[@]}" rm --force "$name" >/dev/null 2>&1
}

pid_is_api() {
  local pid="$1" root="$2" command_line=''
  [[ "$pid" =~ ^[0-9]+$ && -r "/proc/$pid/cmdline" ]] || return 1
  command_line="$(tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null || true)"
  [[ "$command_line" == *"$root/scripts/ishikawa-retrieval-api --serve"* ]]
}

read_pid() {
  local pid_file="$1" value=''
  [[ -f "$pid_file" && ! -L "$pid_file" ]] || return 1
  IFS= read -r value <"$pid_file" || return 1
  printf '%s' "$value"
}

stop_api() {
  local root="$1" pid_file="$2" pid=''
  pid="$(read_pid "$pid_file" 2>/dev/null || true)"
  if pid_is_api "$pid" "$root"; then
    kill -TERM "$pid" >/dev/null 2>&1 || return 1
    for _attempt in {1..100}; do
      kill -0 "$pid" 2>/dev/null || break
      sleep 0.1
    done
    kill -0 "$pid" 2>/dev/null && kill -KILL "$pid" >/dev/null 2>&1 || true
  elif [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
    return 1
  fi
  rm -f -- "$pid_file"
}

start_api() {
  local root="$1" pid_name="$2" pid_file stdout_log stderr_log
  pid_file="$root/state/run/$pid_name"
  stdout_log="$root/state/logs/${pid_name%.pid}.stdout"
  stderr_log="$root/state/logs/${pid_name%.pid}.stderr"
  mkdir -p -- "$root/state/run" "$root/state/logs"
  export ISHIKAWA_GEMMA_API_KEY="$gemma_key"
  export ISHIKAWA_NOMIC_API_KEY="$nomic_key"
  export ISHIKAWA_POSTGRESQL_PASSWORD="$postgresql_password"
  setsid bash -c '
    set -Eeuo pipefail
    umask 077
    printf "%s\n" "$$" >"$1"
    shift
    exec "$@"
  ' bash "$pid_file" env PYTHONDONTWRITEBYTECODE=1 \
    "$root/scripts/ishikawa-retrieval-api" --serve \
    </dev/null >>"$stdout_log" 2>>"$stderr_log" &
  api_pid="$!"
  unset ISHIKAWA_GEMMA_API_KEY ISHIKAWA_NOMIC_API_KEY ISHIKAWA_POSTGRESQL_PASSWORD
  for _attempt in {1..40}; do
    [[ -s "$pid_file" ]] && break
    kill -0 "$api_pid" 2>/dev/null || break
    sleep 0.25
  done
  [[ -s "$pid_file" ]] || return 1
  api_pid="$(read_pid "$pid_file")"
  pid_is_api "$api_pid" "$root"
}

postgresql_binary() {
  local name="$1" selected=''
  selected="$(command -v "$name" 2>/dev/null || true)"
  if [[ -z "$selected" ]]; then
    selected="$(find /usr/lib/postgresql -mindepth 3 -maxdepth 3 -type f -path "*/bin/$name" -print 2>/dev/null | sort -V | tail -n 1)"
  fi
  [[ -n "$selected" && -x "$selected" ]] || return 1
  printf '%s' "$selected"
}

postgresql_status() {
  local root="$1" pg_ctl
  pg_ctl="$(postgresql_binary pg_ctl)" || return 1
  "$pg_ctl" -D "$root/state/postgresql/data" status >/dev/null 2>&1
}

start_postgresql() {
  local root="$1" pg_ctl
  pg_ctl="$(postgresql_binary pg_ctl)" || return 1
  mkdir -m 0700 -p -- "$root/state/postgresql/socket"
  "$pg_ctl" -D "$root/state/postgresql/data" \
    -o "-k $root/state/postgresql/socket -h 127.0.0.1 -p $postgresql_port" \
    -l "$root/state/postgresql/postgresql.log" -w start >/dev/null
}

stop_postgresql() {
  local root="$1" pg_ctl
  pg_ctl="$(postgresql_binary pg_ctl)" || return 1
  "$pg_ctl" -D "$root/state/postgresql/data" status >/dev/null 2>&1 || return 0
  "$pg_ctl" -D "$root/state/postgresql/data" -m fast -w stop >/dev/null
}

database_counts() {
  PGPASSWORD="$postgresql_password" PGOPTIONS='-c default_transaction_read_only=on' \
    psql -X -A -t -q -h 127.0.0.1 -p "$postgresql_port" \
      -U rag_retrieval -d rag_catalog -v ON_ERROR_STOP=1 <<'SQL'
SELECT
  current_user::text || ';' || current_setting('transaction_read_only')::text || ';' ||
  (SELECT count(*) FROM rag_search.active_documents)::text || ';' ||
  (SELECT sum(page_count) FROM rag_search.active_documents)::text || ';' ||
  (SELECT count(*) FROM rag_search.active_chunks)::text || ';' ||
  (SELECT count(*) FROM rag_search.active_retrieval_candidates)::text || ';' ||
  (SELECT count(*) FROM rag_search.active_retrieval_candidates WHERE retrieval_scoring_only)::text || ';' ||
  (SELECT count(*) FROM rag_search.active_retrieval_embeddings)::text || ';' ||
  (SELECT count(*) FROM rag_search.active_relationships)::text || ';' ||
  (SELECT count(*) FROM (SELECT DISTINCT source_document_id, target_identity FROM rag_search.active_relationships) AS pairs)::text;
SQL
}

database_inventory_valid() {
  [[ "$(database_counts)" == 'rag_retrieval;on;30;150;786;943;157;943;240;90' ]]
}

check_boot_posture() {
  [[ "$(systemctl --user is-enabled ishikawa-retrieval-api.service 2>/dev/null || true)" != enabled \
      && "$(systemctl is-enabled postgresql.service 2>/dev/null || true)" != enabled \
      && "$(systemctl is-enabled postgresql@16-main.service 2>/dev/null || true)" != enabled ]]
}

configure_application() {
  local root="$1"
  python3 -B - "$root" "$gemma_base_url" "$nomic_base_url" "$ui_port" "$retrieval_port" <<'PY'
from pathlib import Path
import sys
import yaml

root = Path(sys.argv[1]).resolve(strict=True)
gemma, nomic = sys.argv[2:4]
ui_port, retrieval_port = map(int, sys.argv[4:6])
deployment_path = root / "config/deployment.yaml"
runtime_path = root / "config/runtime_dependencies.yaml"
service_path = root / "config/retrieval_service_profile.yaml"
deployment = yaml.safe_load(deployment_path.read_text(encoding="utf-8"))
deployment["web"]["port"] = ui_port
deployment["web"]["retrieval_base_url"] = f"http://127.0.0.1:{retrieval_port}"
deployment["retrieval"]["port"] = retrieval_port
deployment["postgresql"]["port"] = 5432
deployment_path.write_text(yaml.safe_dump(deployment, sort_keys=False), encoding="utf-8")
runtime = yaml.safe_load(runtime_path.read_text(encoding="utf-8"))
runtime["gemma"]["chat_endpoint_url"] = gemma + "/v1/chat/completions"
runtime["gemma"]["tokenization_endpoint_url"] = gemma + "/tokenize"
runtime["gemma"]["health_endpoint_url"] = gemma + "/health"
runtime["nomic"]["embedding_endpoint_url"] = nomic + "/v1/embeddings"
runtime["nomic"]["health_endpoint_url"] = nomic + "/health"
runtime_path.write_text(yaml.safe_dump(runtime, sort_keys=False), encoding="utf-8")
service = yaml.safe_load(service_path.read_text(encoding="utf-8"))
service["network"]["default_port"] = retrieval_port
service_path.write_text(yaml.safe_dump(service, sort_keys=False), encoding="utf-8")
PY
}

application_readiness() {
  local root="$1" marker=''
  marker="$(
    ISHIKAWA_GEMMA_API_KEY="$gemma_key" \
    ISHIKAWA_NOMIC_API_KEY="$nomic_key" \
    ISHIKAWA_POSTGRESQL_PASSWORD="$postgresql_password" \
    PYTHONDONTWRITEBYTECODE=1 "$root/scripts/ishikawa-retrieval-api" --check-readiness
  )" || return 1
  grep -Fxq 'ishikawa_retrieval_api_readiness=pass;configuration=pass;storage=pass;postgresql=pass;gemma=pass;nomic=pass' <<<"$marker"
}

web_configuration() {
  local root="$1"
  PYTHONDONTWRITEBYTECODE=1 PYTHONPATH="$root/application/python" \
    python3 -B - "$root/config/product.yaml" <<'PY'
import sys
from pathlib import Path
from ishikawa.product import validate_product_profile
from ishikawa.yaml_loader import load_restricted_yaml

profile = validate_product_profile(load_restricted_yaml(Path(sys.argv[1]), label="product profile"))
print(profile.display_name)
print(profile.browser_configuration_base64())
PY
}

start_new_web() {
  local values runtime_command started elapsed=0 next_heartbeat=15 logs=''
  local -a config=()
  values="$(web_configuration "$final_root")" || return 1
  mapfile -t config <<<"$values"
  (( ${#config[@]} == 2 )) || return 1
  runtime_command='
set -eu
mkdir -p -- "$HOME" "$TMPDIR"
printf "[RUNTIME] stage=build;state=start\n"
node_modules/.bin/next build
test -f .next/BUILD_ID
test -d .next/server
printf "[RUNTIME] stage=build;state=pass\n"
printf "[RUNTIME] stage=server;state=start\n"
exec node_modules/.bin/next start --hostname "$1" --port "$2"
'
  local operator_uid operator_gid
  operator_uid="$(id -u)"; operator_gid="$(id -g)"
  "${docker_command[@]}" run --detach --name "$new_container" --init \
    --network host --read-only --restart no \
    --security-opt no-new-privileges --cap-drop ALL --pids-limit 512 \
    --user "$operator_uid:$operator_gid" \
    --tmpfs "/opt/nextjs/.next:rw,nosuid,nodev,size=${web_tmpfs_bytes},mode=0700,uid=${operator_uid},gid=${operator_gid}" \
    --env 'HOME=/opt/nextjs/.next/home' --env 'TMPDIR=/opt/nextjs/.next/tmp' \
    --env 'TMP=/opt/nextjs/.next/tmp' --env 'TEMP=/opt/nextjs/.next/tmp' \
    --env 'NEXT_TELEMETRY_DISABLED=1' --env 'NODE_ENV=production' \
    --env "ISHIKAWA_PRODUCT_DISPLAY_NAME=${config[0]}" \
    --env "ISHIKAWA_PRODUCT_UI_CONFIG_BASE64=${config[1]}" \
    --env "ISHIKAWA_RETRIEVAL_BASE_URL=http://127.0.0.1:${retrieval_port}" \
    --mount "type=bind,src=$final_root/application/web/app,dst=/opt/nextjs/app,readonly" \
    --mount "type=bind,src=$final_root/application/web/components,dst=/opt/nextjs/components,readonly" \
    --mount "type=bind,src=$final_root/application/web/lib,dst=/opt/nextjs/lib,readonly" \
    --mount "type=bind,src=$final_root/application/web/public,dst=/opt/nextjs/public,readonly" \
    --mount "type=bind,src=$final_root/application/web/package.json,dst=/opt/nextjs/package.json,readonly" \
    --mount "type=bind,src=$final_root/application/web/next.config.mjs,dst=/opt/nextjs/next.config.mjs,readonly" \
    "$new_image_reference" sh -c "$runtime_command" runtime 127.0.0.1 "$ui_port" >/dev/null || return 1
  started="$(date +%s)"
  emit WEB 'state=building;elapsed_seconds=0'
  while (( elapsed < 300 )); do
    logs="$("${docker_command[@]}" logs --tail 160 "$new_container" 2>&1 || true)"
    grep -Fxq '[RUNTIME] stage=build;state=pass' <<<"$logs" && break
    container_running "$new_container" || return 1
    sleep 1
    elapsed=$(( $(date +%s) - started ))
    if (( elapsed >= next_heartbeat )); then
      emit WEB "state=building;elapsed_seconds=$elapsed"
      next_heartbeat=$((next_heartbeat + 15))
    fi
  done
  grep -Fxq '[RUNTIME] stage=build;state=pass' <<<"$logs" || return 1
  wait_http "http://127.0.0.1:${ui_port}/api/live" 160 WEB || return 1
  wait_http "http://127.0.0.1:${ui_port}/api/ready" 120 WEB || return 1
  [[ "$(http_status "http://127.0.0.1:${ui_port}/")" == 200 \
      && "$(http_status "http://127.0.0.1:${ui_port}/theme-init.js")" == 200 \
      && "$(http_status "http://127.0.0.1:${ui_port}/api/dependencies")" == 200 ]] || return 1
  [[ "$("${docker_command[@]}" inspect --format '{{index .HostConfig.Tmpfs "/opt/nextjs/.next"}}' "$new_container" 2>/dev/null || true)" == *"size=${web_tmpfs_bytes}"* ]]
}

start_old_web() {
  local values operator_uid operator_gid
  local -a config=()
  values="$(web_configuration "$old_root")" || return 1
  mapfile -t config <<<"$values"
  (( ${#config[@]} == 2 )) || return 1
