}

old_runtime_ready() {
  local pid
  pid="$(read_pid "$old_root/state/run/attended-v1.3.pid" 2>/dev/null || true)"
  [[ -d "$old_root" && ! -L "$old_root" ]] \
    && pid_is_api "$pid" "$old_root" \
    && container_running "$old_container" \
    && postgresql_status "$old_root" \
    && http_ready "http://127.0.0.1:${retrieval_port}/ready" \
    && http_ready "http://127.0.0.1:${ui_port}/api/ready" \
    && http_ready "http://127.0.0.1:${ui_port}/" \
    && http_ready "http://127.0.0.1:${ui_port}/theme-init.js" \
    && http_ready "http://127.0.0.1:${ui_port}/api/dependencies"
}

new_runtime_ready() {
  local pid
  pid="$(read_pid "$final_root/state/run/emceedanko-v1.3.1.pid" 2>/dev/null || true)"
  [[ -d "$final_root" && ! -L "$final_root" ]] \
    && pid_is_api "$pid" "$final_root" \
    && container_running "$new_container" \
    && new_container_contract_valid \
    && postgresql_status "$final_root" \
    && http_ready "http://127.0.0.1:${retrieval_port}/ready" \
    && http_ready "http://127.0.0.1:${ui_port}/api/ready" \
    && http_ready "http://127.0.0.1:${ui_port}/" \
    && http_ready "http://127.0.0.1:${ui_port}/theme-init.js" \
    && http_ready "http://127.0.0.1:${ui_port}/api/dependencies"
}

promotion_receipt_valid() {
  local receipt="$1"
  [[ -f "$receipt" && ! -L "$receipt" ]] \
    && grep -Fxq 'schema=ishikawa.emceedanko-v1.3.1-promotion.v1' "$receipt" \
    && grep -Fxq "application_archive_sha256=$expected_application_sha256" "$receipt" \
    && grep -Fxq "runtime_archive_sha256=$expected_runtime_archive_sha256" "$receipt" \
    && grep -Fxq "image_id=$expected_new_image_id" "$receipt" \
    && grep -Fxq 'database_state=moved_unchanged' "$receipt" \
    && grep -Fxq 'ui_port=3384' "$receipt" \
    && grep -Fxq 'retrieval_api_port=8384' "$receipt" \
    && grep -Fxq 'postgresql_port=5432' "$receipt" \
    && grep -Fxq 'production_build_start=pass' "$receipt" \
    && grep -Fxq 'human_ui_acceptance=pending' "$receipt" \
    && grep -Fxq 'rollback_v1_3=available' "$receipt" \
    && grep -Fxq 'database_mutated=false' "$receipt" \
    && grep -Fxq 'schema_mutated=false' "$receipt" \
    && grep -Fxq 'corpus_mutated=false' "$receipt" \
    && grep -Fxq 'boot_autostart=false' "$receipt"
}

acceptance_receipt_valid() {
  local receipt="$1"
  [[ -f "$receipt" && ! -L "$receipt" ]] \
    && grep -Fxq 'schema=ishikawa.emceedanko-v1.3.1-promotion-acceptance.v1' "$receipt" \
    && grep -Fxq "application_archive_sha256=$expected_application_sha256" "$receipt" \
