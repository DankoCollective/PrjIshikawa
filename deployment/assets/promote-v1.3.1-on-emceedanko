read_secret() {
  local label="$1" variable="$2" minimum="$3" maximum="$4" value=''
  printf '\n[INPUT REQUIRED] %s\n[INPUT MODE] Hidden input is active. Paste or type the value, then press Enter.\n' "$label" >/dev/tty
  IFS= read -r -s value </dev/tty || fail secret_input_failed "Could not read $label." 'Rerun interactively.'
  printf '\n' >/dev/tty
  (( ${#value} >= minimum && ${#value} <= maximum )) \
    || fail secret_length_invalid "$label length is outside the accepted range." 'Rerun with the correct secret.'
  [[ "$value" != *$'\n'* && "$value" != *$'\r'* && ! "$value" =~ [[:cntrl:]] ]] \
    || fail secret_format_invalid "$label contains a prohibited control character." 'Rerun with the correct secret.'
  printf -v "$variable" '%s' "$value"
  printf '[INPUT] state=accepted;name=%s\n' "${label// /_}"
}

