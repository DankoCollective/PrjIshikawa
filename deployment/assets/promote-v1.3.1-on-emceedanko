    --env "ISHIKAWA_PRODUCT_UI_CONFIG_BASE64=${config[1]}" \
    --env "ISHIKAWA_RETRIEVAL_BASE_URL=http://127.0.0.1:${retrieval_port}" \
    --mount "type=bind,src=$old_root/application/web/app,dst=/opt/nextjs/app,readonly" \
    --mount "type=bind,src=$old_root/application/web/components,dst=/opt/nextjs/components,readonly" \
