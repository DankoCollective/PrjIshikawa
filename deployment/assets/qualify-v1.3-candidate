#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

# Purpose:
#   Qualify the staged Ishikawa v1.3 application and corpus v3 on one target
#   without touching the accepted database, installed service, or v1.2 files.
#
# Mental model:
#   Verify the target and payload, copy v1.3 into a private workspace, create a
#   disposable PostgreSQL cluster, ingest corpus v3 through the shipped command,
#   start a temporary Retrieval API, run all sixty frontier cases, then remove
#   every temporary process, listener, credential, database, and workspace.
#
# Inputs or prerequisites:
#   A staged v1.3 candidate, staged corpus-v3 archive, checksum-bound evaluator
#   and database installer payload, working loopback Gemma/Nomic forwards, and
#   operator-entered model credentials. The existing v1.2 service must be active.
#
# Outputs or artifact lane:
#   A content-safe result file and one synthetic-only frontier artifact in the
#   caller-owned transfer directory. Candidate, v1.2, and accepted PostgreSQL
#   state remain unchanged.
#
# Usage:
#   qualify-v1.3-candidate --run --payload-root /tmp/PAYLOAD \
#     --result-path /tmp/PAYLOAD/result.txt \
#     --artifact-path /tmp/PAYLOAD/frontier-result.json

readonly pg_port=65438
readonly api_port=1385
readonly api_endpoint="http://127.0.0.1:${api_port}/v1/chat"
readonly expected_documents=30
readonly expected_pages=150
readonly expected_chunks=786
readonly expected_candidates=943
readonly expected_scoring_only=157
readonly expected_embeddings=943
readonly expected_relationship_records=240
readonly expected_relationship_pairs=90
readonly expected_native_tests=486
readonly priority_cases=(R-028 R-012 R-016 R-036 R-048 R-052 R-054)
readonly ingestion_manifest_name='qualification-corpus-v3.yaml'

mode=''
expected_hostname='EmceeDanko'
expected_os_version='24.04'
expected_architecture='amd64'
candidate_root="$HOME/Documents/Ishikawa-v1.3"
corpus_input_root="$HOME/Documents/Ishikawa-v1.3-qualification-inputs"
payload_root=''
result_path=''
artifact_path=''
gemma_base_url='http://127.0.0.1:8000'
nomic_base_url='http://127.0.0.1:8001'
stage='argument_validation'
failure_reason=''
failure_root_cause=''
failure_detail=''
failure_action=''
work_root=''
postgresql_started=false
service_pid=''
active_pid=''
gemma_key=''
nomic_key=''
database_password=''
complete=false
cleanup_failed=false
active_identity_before=''
rollback_identity_before=''
service_state_before=''
listeners_before=''
result_written=false
preservation_boundary_verified=false

usage() {
  sed -n '3,28p' "${BASH_SOURCE[0]}"
}

emit() {
  local tag="$1" message="$2"
  printf '[%s] %s\n' "$tag" "$message"
}

result_marker() {
  printf '\nSCRIPT RESULT\nqualify_v1_3_candidate=%s\n' "$1"
}

fail() {
  failure_reason="$1"
  failure_detail="$2"
  failure_action="$3"
  exit "${4:-1}"
}

unexpected_error() {
  local status="$1" line="$2"
  trap - ERR
  [[ -n "$failure_reason" ]] || {
    failure_reason='unexpected_command_failure'
    failure_detail="An unhandled command failed at target helper line ${line} with exit code ${status}."
    failure_action='Use the retained stage and reason to correct every condition before rerunning Script 05.'
  }
  exit "$status"
}

write_result() {
  local state="$1" cleanup_state='pass'
  [[ "$cleanup_failed" == false ]] || cleanup_state='blocked'
  [[ -n "$result_path" && "$result_path" == /* ]] || return 0
  {
    printf 'target_hostname=%s;os_id=ubuntu;os_version=%s;architecture=%s\n' \
      "$expected_hostname" "$expected_os_version" "$expected_architecture"
    printf 'qualification_database=disposable;postgresql_port=%s;retrieval_api_port=%s\n' \
      "$pg_port" "$api_port"
    printf 'active_v1_2_preserved=%s;accepted_database_contact=false;candidate_mutated=false;boot_autostart_changed=false\n' \
      "$([[ "$preservation_boundary_verified" == true && "$cleanup_failed" == false ]] && printf true || printf false)"
    printf 'cleanup=%s;temporary_postgresql_removed=%s;temporary_api_stopped=%s;qualification_ports_free=%s\n' \
      "$cleanup_state" \
      "$([[ "$cleanup_failed" == false ]] && printf true || printf false)" \
      "$([[ "$cleanup_failed" == false ]] && printf true || printf false)" \
      "$([[ "$cleanup_failed" == false ]] && printf true || printf false)"
    if [[ "$state" == pass ]]; then
      printf 'native_qualification=pass;tests=486\n'
      printf 'corpus_v3_ingestion=pass;documents=30;pages=150;authoritative_chunks=786;retrieval_candidates=943;retrieval_scoring_only=157;embeddings=943;relationship_records=240;relationship_pairs=90\n'
      printf 'frontier_qualification=pass;cases=60/60;required_evidence_returned=60/60;required_evidence_cited=60/60;dependency_failures=0\n'
      printf 'ishikawa_v1_3_emceedanko_disposable_qualification=pass\n'
    else
      printf 'FAILURE DETAIL\n'
      printf 'stage=%s\nreason=%s\ndetail=%s\noperator_action=%s\n' \
        "$stage" "${failure_reason:-unclassified_failure}" \
        "${failure_detail:-The target qualification stopped without a classified detail.}" \
        "${failure_action:-Review the named stage and rerun Script 05 after correcting all reported conditions.}"
      if [[ -n "$failure_root_cause" ]]; then
        printf 'root_cause=%s\n' "$failure_root_cause"
      fi
      printf 'ishikawa_v1_3_emceedanko_disposable_qualification=blocked\n'
    fi
  } >"$result_path"
  result_written=true
}

cleanup() {
  local status="$?" state='blocked' pid=''
  trap - ERR EXIT HUP INT TERM
  set +e
  unset ISHIKAWA_GEMMA_API_KEY ISHIKAWA_NOMIC_API_KEY \
    ISHIKAWA_POSTGRESQL_PASSWORD ISHIKAWA_POSTGRESQL_INGEST_PASSWORD
  gemma_key=''; nomic_key=''; database_password=''
  for pid in "$active_pid" "$service_pid"; do
    if [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then
      kill -TERM "$pid" 2>/dev/null || true
      for _attempt in {1..60}; do
        kill -0 "$pid" 2>/dev/null || break
        sleep 0.25
      done
      if kill -0 "$pid" 2>/dev/null; then
        kill -KILL "$pid" 2>/dev/null || true
        cleanup_failed=true
      fi
      wait "$pid" 2>/dev/null || true
    fi
  done
  active_pid=''; service_pid=''
  if [[ "$work_root" == /tmp/ishikawa-v1.3-qualification.* \
      && -d "$work_root/postgresql" && -n "${pg_ctl:-}" ]]; then
    if "$pg_ctl" -D "$work_root/postgresql" status >/dev/null 2>&1; then
      "$pg_ctl" -D "$work_root/postgresql" -m fast -w stop >/dev/null 2>&1 \
        || cleanup_failed=true
    fi
  fi
  postgresql_started=false
  if ss -H -ltn "( sport = :${api_port} or sport = :${pg_port} )" 2>/dev/null | grep -q .; then
    cleanup_failed=true
  fi
  if [[ -n "$work_root" ]]; then
    if [[ "$work_root" == /tmp/ishikawa-v1.3-qualification.* && -d "$work_root" && ! -L "$work_root" ]]; then
      rm -rf -- "$work_root" || cleanup_failed=true
    else
      cleanup_failed=true
    fi
  fi
  work_root=''
  if [[ -n "$active_identity_before" ]]; then
    [[ -d "$HOME/Documents/Ishikawa" && ! -L "$HOME/Documents/Ishikawa" \
        && "$(stat -Lc '%d:%i' -- "$HOME/Documents/Ishikawa")" == "$active_identity_before" ]] \
      || cleanup_failed=true
  fi
  if [[ -n "$rollback_identity_before" ]]; then
    [[ -d "$HOME/Documents/Ishikawa-before-v1.2" && ! -L "$HOME/Documents/Ishikawa-before-v1.2" \
        && "$(stat -Lc '%d:%i' -- "$HOME/Documents/Ishikawa-before-v1.2")" == "$rollback_identity_before" ]] \
      || cleanup_failed=true
  fi
  if [[ -n "$service_state_before" ]]; then
    [[ "$(systemctl --user is-active ishikawa-retrieval-api.service 2>/dev/null || true)" == "$service_state_before" ]] \
      || cleanup_failed=true
  fi
  if [[ -n "$listeners_before" ]]; then
    [[ "$(ss -H -ltn '( sport = :3000 or sport = :1384 or sport = :5432 )' 2>/dev/null | sort)" == "$listeners_before" ]] \
      || cleanup_failed=true
  fi
  if [[ "$cleanup_failed" == true ]]; then
    status=1
    complete=false
    [[ -n "$failure_reason" ]] || failure_reason='cleanup_or_preservation_proof_failed'
    [[ -n "$failure_detail" ]] || failure_detail='A temporary listener, process, workspace, or preserved v1.2 boundary did not return to its verified initial state.'
    [[ -n "$failure_action" ]] || failure_action='Inspect ports 1385 and 65438 plus the preserved v1.2 service before rerunning Script 05.'
  fi
  [[ "$complete" == true && "$status" -eq 0 ]] && state='pass'
  write_result "$state"
  emit CLEANUP "state=$([[ "$cleanup_failed" == false ]] && printf pass || printf blocked);temporary_postgresql_removed=$([[ "$postgresql_started" == false ]] && printf true || printf false);temporary_api_stopped=$([[ -z "$service_pid" ]] && printf true || printf false);ports_1385_65438_free=$([[ "$cleanup_failed" == false ]] && printf true || printf false)"
  if [[ "$state" == blocked ]]; then
    printf '%s\n' 'FAILURE DETAIL' "stage=$stage" \
      "reason=${failure_reason:-unclassified_failure}" \
      "detail=${failure_detail:-The target qualification stopped without a classified detail.}" \
      "operator_action=${failure_action:-Review the named stage and rerun Script 05.}"
    if [[ -n "$failure_root_cause" ]]; then
      printf 'root_cause=%s\n' "$failure_root_cause"
    fi
  fi
  result_marker "$state"
  [[ "$state" == pass ]] && exit 0
  [[ "$status" -ne 0 ]] && exit "$status"
  exit 1
}

trap 'unexpected_error "$?" "$LINENO"' ERR
trap cleanup EXIT
trap 'stage=interrupted; fail signal_hangup "Qualification received SIGHUP." "Review cleanup and rerun Script 05." 129' HUP
trap 'stage=interrupted; fail signal_interrupt "Qualification was interrupted." "Review cleanup and rerun Script 05." 130' INT
trap 'stage=interrupted; fail signal_termination "Qualification received SIGTERM." "Review cleanup and rerun Script 05." 143' TERM

read_secret() {
  local label="$1" destination="$2" minimum="$3" maximum="$4" reason="$5" value='' bytes=''
  [[ -r /dev/tty && -w /dev/tty ]] \
    || fail interactive_terminal_unavailable 'A controlling terminal is required for protected credential entry.' 'Run Script 05 from an interactive terminal.'
  printf '\n[INPUT REQUIRED] %s\n' "$label" >/dev/tty
  printf '[INPUT MODE] Hidden input is active. Paste or type the value, then press Enter.\n' >/dev/tty
  IFS= read -r -s value </dev/tty \
    || fail secret_entry_failed 'Protected credential input failed.' 'Rerun Script 05 from an interactive terminal.'
  bytes="$(LC_ALL=C printf '%s' "$value" | wc -c | tr -d ' ')"
  [[ "$bytes" =~ ^[0-9]+$ ]] || fail "$reason" 'Credential length validation failed.' 'Re-enter the complete credential.'
  (( bytes >= minimum && bytes <= maximum )) \
    || fail "$reason" 'Credential length is outside the accepted boundary.' 'Re-enter the complete credential.'
  [[ "$value" != *$'\n'* && "$value" != *$'\r'* ]] \
    || fail "$reason" 'Credential contains a line break.' 'Re-enter the credential without a line break.'
  printf -v "$destination" '%s' "$value"
  printf '[INPUT ACCEPTED] %s received.\n' "$label" >/dev/tty
  value=''
}

resolve_pg_binary() {
  local name="$1" destination="$2" candidate='' resolved=''
  [[ "$name" =~ ^[a-z0-9_]+$ && "$destination" =~ ^[a-z_][a-z0-9_]*$ ]] \
    || return 2
  candidate="$(type -P -- "$name" 2>/dev/null || true)"
  if [[ -n "$candidate" && -x "$candidate" ]]; then
    resolved="$(readlink -f -- "$candidate" 2>/dev/null || true)"
    [[ -n "$resolved" && -f "$resolved" && -x "$resolved" ]] || candidate=''
  fi
  if [[ -z "$candidate" && -x "/usr/lib/postgresql/16/bin/$name" ]]; then
    candidate="/usr/lib/postgresql/16/bin/$name"
  fi
  [[ -n "$candidate" && "$candidate" == /* && -x "$candidate" ]] || return 1
  printf -v "$destination" '%s' "$candidate"
}

require_pg_binary() {
  local name="$1" destination="$2"
  resolve_pg_binary "$name" "$destination" \
    || fail "postgresql_binary_missing_${name}" "Required PostgreSQL 16 command is unavailable: ${name}." 'Restore the qualified PostgreSQL 16 runtime before rerunning Script 05.'
}

safe_root_cause() {
  local status="$1" path='' candidate=''
  shift
  for path in "$@"; do
    [[ -f "$path" && ! -L "$path" ]] || continue
    candidate="$(sed -nE \
      -e 's/^ishikawa_ingestion=blocked;reason=([a-z][a-z0-9_]{0,127})$/\1/p' \
      -e 's/^ishikawa_ingest=blocked;reason=([a-z][a-z0-9_]{0,127})$/\1/p' \
      -e 's/^ishikawa_retrieval_api=blocked;reason=([a-z][a-z0-9_]{0,127})$/\1/p' \
      -e 's/^\[INGEST\] state=blocked;exit_code=[0-9]+;reason=([a-z][a-z0-9_]{0,127})$/\1/p' \
      "$path" | tail -n 1)"
    [[ -z "$candidate" ]] || break
  done
  if [[ -z "$candidate" ]]; then
    case "$status" in
      124) candidate='timeout' ;;
      137) candidate='forced_termination' ;;
      143) candidate='terminated' ;;
      *) candidate='unreported_failure' ;;
    esac
  fi
  printf '%s' "$candidate"
}

stream_safe_progress() {
  grep -E \
    '^(\[INGEST\]|case_(start|result)=|canary_|priority_canary_|ishikawa_ingestion=|ishikawa_ingest=|ishikawa_retrieval_api=)' \
    || true
}

wait_with_heartbeat() {
  local pid="$1" label="$2" output="$3" started next now current lines=0
  started="$(date +%s)"; next=$(( started + 25 ))
  while kill -0 "$pid" 2>/dev/null; do
    if [[ -f "$output" ]]; then
      current="$(wc -l <"$output" | tr -d ' ')"
      if [[ "$current" =~ ^[0-9]+$ ]] && (( current > lines )); then
        sed -n "$(( lines + 1 )),${current}p" "$output" \
          | stream_safe_progress
        lines="$current"
      fi
    fi
    now="$(date +%s)"
    if (( now >= next )); then
      emit "$label" "state=running;elapsed_seconds=$(( now - started ))"
      next=$(( now + 25 ))
    fi
    sleep 2
  done
  if [[ -f "$output" ]]; then
    current="$(wc -l <"$output" | tr -d ' ')"
    if [[ "$current" =~ ^[0-9]+$ ]] && (( current > lines )); then
      sed -n "$(( lines + 1 )),${current}p" "$output" \
        | stream_safe_progress
    fi
  fi
  wait "$pid"
}

probe_authenticated_gemma() {
  printf '%s' "$gemma_key" | PYTHONDONTWRITEBYTECODE=1 python3 -B \
    /dev/fd/3 "$gemma_base_url/v1/models" 3<<'PY'
import json
import sys
import urllib.error
import urllib.parse
import urllib.request

url = sys.argv[1]
credential = sys.stdin.buffer.read(4097)
parsed = urllib.parse.urlsplit(url)
if parsed.scheme != "http" or parsed.hostname != "127.0.0.1" or parsed.path != "/v1/models":
    raise SystemExit(2)
request = urllib.request.Request(
    url,
    headers={"Accept": "application/json", "Authorization": "Bearer " + credential.decode("utf-8")},
    method="GET",
)
try:
    with urllib.request.urlopen(request, timeout=30) as response:
        body = response.read(1024 * 1024 + 1)
        if response.status != 200 or response.headers.get_content_type() != "application/json":
            raise SystemExit(1)
except (OSError, TimeoutError, urllib.error.URLError, urllib.error.HTTPError):
    raise SystemExit(1)
document = json.loads(body.decode("utf-8"))
if not isinstance(document, dict) or not isinstance(document.get("data"), list):
    raise SystemExit(1)
PY
}

probe_authenticated_nomic() {
  printf '%s' "$nomic_key" | \
    PYTHONDONTWRITEBYTECODE=1 PYTHONPATH="$work_root/product/application/python" \
    python3 -B /dev/fd/3 "$nomic_base_url" 3<<'PY'
import sys

from ishikawa.native_adapters import (
    EmbeddingEndpoint,
    EmbeddingResponseError,
    EmbeddingTransportError,
    build_query_embedding_request,
    execute_query_embedding_request,
)
from ishikawa.tokenization import (
    TokenizationEndpoint,
    TokenizationResponseError,
    TokenizationTransportError,
    native_tokenization_exchange,
    prepare_tokenization_request,
    validate_tokenization_response,
)

base_url = sys.argv[1]
credential = sys.stdin.buffer.read(1025)
if not 32 <= len(credential) <= 1024:
    print("nomic_preflight=blocked;stage=credential;reason=format_invalid")
    raise SystemExit(1)
key = ""
try:
    key = credential.decode("utf-8")
except UnicodeError:
    print("nomic_preflight=blocked;stage=credential;reason=not_utf8")
    raise SystemExit(1)
try:
    execute_query_embedding_request(
        EmbeddingEndpoint(base_url + "/v1/embeddings", 30, 1024 * 1024),
        build_query_embedding_request("Ishikawa qualification readiness"),
        key,
    )
except (EmbeddingTransportError, EmbeddingResponseError) as error:
    print(f"nomic_preflight=blocked;stage=embedding;reason={error.reason_code}")
    raise SystemExit(1)
except Exception:
    print("nomic_preflight=blocked;stage=embedding;reason=runtime_failure")
    raise SystemExit(1)
try:
    prepared = prepare_tokenization_request(
        TokenizationEndpoint(base_url + "/tokenize", 30, 1024 * 1024),
        model="nomic-ai/nomic-embed-text-v1.5",
        prompt="search_document: Ishikawa qualification readiness",
        api_key=key,
    )
    validate_tokenization_response(
        native_tokenization_exchange(prepared),
        minimum_model_length=2048,
    )
except (TokenizationTransportError, TokenizationResponseError) as error:
    print(f"nomic_preflight=blocked;stage=tokenization;reason={error.reason_code}")
    raise SystemExit(1)
except Exception:
    print("nomic_preflight=blocked;stage=tokenization;reason=runtime_failure")
    raise SystemExit(1)
finally:
    key = ""
print("nomic_preflight=pass;embedding=pass;tokenization=pass;minimum_model_length=2048")
PY
}

validate_loopback_base_url() {
  PYTHONDONTWRITEBYTECODE=1 python3 -B - "$1" <<'PY'
import sys
import urllib.parse
value = urllib.parse.urlsplit(sys.argv[1])
if (
    value.scheme != "http" or value.hostname != "127.0.0.1" or value.port is None
    or value.path not in {"", "/"} or value.query or value.fragment
    or value.username is not None or value.password is not None
):
    raise SystemExit(1)
PY
}

if [[ "${1:-}" == --self-test ]]; then
  [[ "$#" -eq 1 ]] || { result_marker blocked; exit 2; }
  validate_loopback_base_url 'http://127.0.0.1:8000'
  ! validate_loopback_base_url 'https://example.invalid:8000'
  missing_pg_binary=''
  ! resolve_pg_binary ishikawa_intentionally_missing_pg_binary missing_pg_binary
  [[ -z "$missing_pg_binary" ]]
  trap - EXIT HUP INT TERM
  printf '%s\n' 'qualify_v1_3_candidate_self_test=pass'
  result_marker pass
  exit 0
fi

mode="${1:-}"
shift || true
while (( $# > 0 )); do
  case "$1" in
    --expected-hostname) expected_hostname="${2:-}"; shift 2 ;;
    --expected-os-version) expected_os_version="${2:-}"; shift 2 ;;
    --expected-architecture) expected_architecture="${2:-}"; shift 2 ;;
    --candidate-root) candidate_root="${2:-}"; shift 2 ;;
    --corpus-input-root) corpus_input_root="${2:-}"; shift 2 ;;
    --payload-root) payload_root="${2:-}"; shift 2 ;;
    --result-path) result_path="${2:-}"; shift 2 ;;
    --artifact-path) artifact_path="${2:-}"; shift 2 ;;
    --gemma-base-url) gemma_base_url="${2:-}"; shift 2 ;;
    --nomic-base-url) nomic_base_url="${2:-}"; shift 2 ;;
    --help|-h) usage; exit 0 ;;
    *) fail argument_invalid "Unsupported target-helper argument: $1." 'Use the Script 05 wrapper instead of invoking the helper directly.' 2 ;;
  esac
done
[[ "$mode" == --run ]] \
  || fail mode_invalid 'The target helper accepts only --run or --self-test.' 'Invoke it through Script 05.' 2
[[ "$expected_hostname" =~ ^[A-Za-z0-9][A-Za-z0-9.-]*$ \
    && "$expected_os_version" =~ ^[0-9]{2}\.[0-9]{2}$ \
    && "$expected_architecture" == amd64 ]] \
  || fail target_expectation_invalid 'Expected target identity values are invalid.' 'Correct Script 05 target parameters.' 2
for path in "$candidate_root" "$corpus_input_root" "$payload_root" "$result_path" "$artifact_path"; do
  [[ "$path" == /* ]] || fail path_invalid 'Every target helper path must be absolute.' 'Invoke the helper through Script 05.' 2
done
[[ "$result_path" == "$payload_root/"* && "$artifact_path" == "$payload_root/"* \
    && "$result_path" != "$artifact_path" ]] \
  || fail output_path_invalid 'Result and artifact paths must be distinct children of the payload root.' 'Invoke the helper through Script 05.' 2
validate_loopback_base_url "$gemma_base_url" \
  || fail gemma_base_url_invalid 'Gemma must use a bounded IPv4 loopback HTTP base URL.' 'Correct the --gemma-base-url value.' 2
validate_loopback_base_url "$nomic_base_url" \
  || fail nomic_base_url_invalid 'Nomic must use a bounded IPv4 loopback HTTP base URL.' 'Correct the --nomic-base-url value.' 2

stage='preflight'
for command_name in awk bash chmod cp curl date find grep hostname id kill mkdir mktemp paste python3 readlink rm sed sha256sum sleep sort ss stat systemctl tar timeout tr uname wc; do
  command -v "$command_name" >/dev/null 2>&1 \
    || fail "command_missing_${command_name}" "Required target command is unavailable: ${command_name}." 'Restore the required host prerequisite and rerun Script 05.'
done
pg_initdb=''; pg_ctl=''; pg_createdb=''; pg_psql=''
require_pg_binary initdb pg_initdb
require_pg_binary pg_ctl pg_ctl
require_pg_binary createdb pg_createdb
require_pg_binary psql pg_psql
readonly pg_initdb pg_ctl pg_createdb pg_psql

actual_hostname="$(hostname -s)"
actual_architecture="$(uname -m)"
[[ "$actual_architecture" == x86_64 ]] && actual_architecture=amd64
os_id=''; os_version=''
while IFS='=' read -r key value; do
  value="${value%\"}"; value="${value#\"}"
  case "$key" in ID) os_id="$value" ;; VERSION_ID) os_version="$value" ;; esac
done </etc/os-release
[[ "$actual_hostname" == "$expected_hostname" && "$os_id" == ubuntu \
    && "$os_version" == "$expected_os_version" && "$actual_architecture" == "$expected_architecture" ]] \
  || fail target_identity_mismatch "Expected ${expected_hostname}/Ubuntu ${expected_os_version}/${expected_architecture}; observed ${actual_hostname}/${os_id} ${os_version}/${actual_architecture}." 'Use the reviewed EmceeDanko target.'

for path in "$candidate_root" "$corpus_input_root" "$payload_root"; do
  [[ -d "$path" && ! -L "$path" ]] \
    || fail required_directory_unsafe "Required target directory is missing or unsafe: ${path}." 'Rerun Script 04 or restore the transferred qualification payload.'
done
for path in \
  "$candidate_root/scripts/ishikawa-ingest" \
  "$candidate_root/scripts/ishikawa-retrieval-api" \
  "$corpus_input_root/qualification-corpus-v3.tar.gz" \
  "$corpus_input_root/qualification-corpus-v3.tar.gz.sha256" \
  "$payload_root/create-corpus-v3-ingestion-config.py" \
  "$payload_root/evaluate-frontier.py" \
  "$payload_root/candidate-SHA256SUMS" \
  "$payload_root/native-tests/run-local-validation-tests.sh" \
  "$payload_root/database/install-schema" \
  "$payload_root/database/schema.sql" \
  "$payload_root/database/SHA256SUMS" \
  "$payload_root/SHA256SUMS"; do
  [[ -f "$path" && ! -L "$path" && -r "$path" ]] \
