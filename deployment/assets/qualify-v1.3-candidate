stage='temporary_postgresql'
database_password="$(PYTHONDONTWRITEBYTECODE=1 python3 -B -c 'import secrets; print(secrets.token_urlsafe(48))')"
"$pg_initdb" -D "$work_root/postgresql" --username="$(id -un)" \
