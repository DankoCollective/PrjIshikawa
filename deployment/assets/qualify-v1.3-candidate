PYTHONDONTWRITEBYTECODE=1 python3 -B - \
  "$candidate_root" "$payload_root/candidate-SHA256SUMS" <<'PY' \
  || fail staged_candidate_inventory_failed 'The staged candidate contains an unexpected or missing regular file.' 'Restage the exact Script 01 application with Script 04 before qualification.'
import pathlib
import sys

root = pathlib.Path(sys.argv[1]).resolve(strict=True)
manifest = pathlib.Path(sys.argv[2]).resolve(strict=True)
expected = set()
for line in manifest.read_text(encoding="utf-8").splitlines():
    digest, separator, name = line.partition("  ")
    if len(digest) != 64 or separator != "  " or not name or name in expected:
        raise SystemExit(1)
    expected.add(name)
actual = {
    item.relative_to(root).as_posix()
    for item in root.rglob("*")
    if item.is_file()
}
if expected != actual or any(item.is_symlink() for item in root.rglob("*")):
    raise SystemExit(1)
PY
(cd -- "$corpus_input_root" && sha256sum --check --strict qualification-corpus-v3.tar.gz.sha256 >/dev/null) \
