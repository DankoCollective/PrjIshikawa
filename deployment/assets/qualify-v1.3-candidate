else
  grep -E '^nomic_preflight=blocked;stage=(credential|embedding|tokenization);reason=[a-z][a-z0-9_]{0,95}$' \
    "$work_root/nomic-preflight.stdout" || true
  nomic_preflight_stage="$(sed -n 's/^nomic_preflight=blocked;stage=\([a-z]*\);reason=[a-z0-9_]*$/\1/p' "$work_root/nomic-preflight.stdout" | tail -n 1)"
  nomic_preflight_reason="$(sed -n 's/^nomic_preflight=blocked;stage=[a-z]*;reason=\([a-z0-9_]*\)$/\1/p' "$work_root/nomic-preflight.stdout" | tail -n 1)"
  failure_root_cause="nomic_${nomic_preflight_stage:-unknown}_${nomic_preflight_reason:-unreported_failure}"
  fail nomic_preflight_failed \
