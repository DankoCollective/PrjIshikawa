  fail ingestion_publication_failed \
    "The shipped target-side publication failed;root_cause=${failure_root_cause};exit_code=${ingestion_status}." \
    'Correct the named Nomic, extraction, tokenization, or PostgreSQL root cause before rerunning Script 05.'
fi
active_pid=''
grep -Fxq 'ishikawa_ingestion=pass;exit_code=0' "$work_root/ingest-publish.stdout" \
  || fail ingestion_publication_marker_missing 'The ingestion command exited without its exact pass marker.' 'Treat the run as blocked and rerun after reviewing the ingestion stage.'

stage='database_qualification'
database_counts="$("$pg_psql" -X -A -t -q -h "$work_root/socket" -p "$pg_port" -d rag_catalog -v ON_ERROR_STOP=1 <<'SQL'
SELECT
  (SELECT count(*) FROM rag_search.active_documents)::text || ';' ||
  (SELECT sum(page_count) FROM rag_search.active_documents)::text || ';' ||
  (SELECT count(*) FROM rag_search.active_chunks)::text || ';' ||
  (SELECT count(*) FROM rag_search.active_retrieval_candidates)::text || ';' ||
  (SELECT count(*) FROM rag_search.active_retrieval_candidates WHERE retrieval_scoring_only)::text || ';' ||
  (SELECT count(*) FROM rag_search.active_retrieval_embeddings)::text || ';' ||
  (SELECT count(*) FROM rag_search.active_relationships)::text || ';' ||
  (SELECT count(*) FROM (
    SELECT DISTINCT source_document_id, target_identity
    FROM rag_search.active_relationships
  ) AS relationship_pairs)::text;
SQL
)" || fail database_inventory_query_failed 'The disposable corpus inventory query failed.' 'Inspect the ingestion result and schema before rerunning.'
expected_counts="${expected_documents};${expected_pages};${expected_chunks};${expected_candidates};${expected_scoring_only};${expected_embeddings};${expected_relationship_records};${expected_relationship_pairs}"
[[ "$database_counts" == "$expected_counts" ]] \
  || fail database_inventory_mismatch "Expected corpus inventory ${expected_counts}; observed ${database_counts:-none}." 'Do not accept the ingestion; restore the exact v1.3 and corpus-v3 inputs.'
emit DATABASE 'state=pass;documents=30;pages=150;authoritative_chunks=786;retrieval_candidates=943;retrieval_scoring_only=157;embeddings=943;relationship_records=240;relationship_pairs=90'

stage='temporary_retrieval_api'
ISHIKAWA_GEMMA_API_KEY="$gemma_key" \
ISHIKAWA_NOMIC_API_KEY="$nomic_key" \
ISHIKAWA_POSTGRESQL_PASSWORD="$database_password" \
PYTHONDONTWRITEBYTECODE=1 \
  "$work_root/product/scripts/ishikawa-retrieval-api" --serve \
  >"$work_root/service.stdout" 2>"$work_root/service.stderr" &
service_pid="$!"
ready=false; ready_started="$(date +%s)"; next_ready_heartbeat=$(( ready_started + 25 ))
for _attempt in {1..300}; do
  kill -0 "$service_pid" 2>/dev/null || break
  ready_status="$(curl -sS -o /dev/null -w '%{http_code}' --connect-timeout 1 --max-time 5 "http://127.0.0.1:${api_port}/ready" 2>/dev/null || true)"
  if [[ "$ready_status" == 200 ]]; then ready=true; break; fi
  now="$(date +%s)"
  if (( now >= next_ready_heartbeat )); then
    emit API "state=starting;elapsed_seconds=$(( now - ready_started ))"
    next_ready_heartbeat=$(( now + 25 ))
  fi
  sleep 1
done
if [[ "$ready" != true ]]; then
  service_status=1
  if kill -0 "$service_pid" 2>/dev/null; then
    service_status=124
  else
    wait "$service_pid" || service_status="$?"
  fi
  failure_root_cause="$(safe_root_cause "$service_status" \
    "$work_root/service.stdout" "$work_root/service.stderr")"
  [[ "$failure_root_cause" != unreported_failure ]] \
    || failure_root_cause='readiness_failed_without_service_marker'
  fail temporary_retrieval_api_not_ready \
    "The private v1.3 Retrieval API did not reach readiness on port 1385;root_cause=${failure_root_cause};exit_code=${service_status}." \
    'Correct the named service, model, database, or configuration root cause before rerunning Script 05.'
fi
emit API "state=pass;readiness=ready;bind=127.0.0.1:${api_port};active_v1_2_port_1384=unchanged"

stage='frontier_qualification'
emit FRONTIER 'state=start;cases=60;r001_first=true;priority_canaries=7'
priority_args=()
for case_id in "${priority_cases[@]}"; do priority_args+=(--priority-case-id "$case_id"); done
frontier_work_artifact="$work_root/frontier-result.json"
PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 timeout --signal=TERM --kill-after=30s 7200s \
  python3 -B "$payload_root/evaluate-frontier.py" --run \
    --cases "$corpus_root/frontier-cases.json" \
    --endpoint "$api_endpoint" --output "$frontier_work_artifact" \
    --expected-hostname "$expected_hostname" \
    --expected-os-version "$expected_os_version" \
    --expected-architecture "$expected_architecture" \
    "${priority_args[@]}" \
  >"$work_root/frontier.stdout" 2>"$work_root/frontier.stderr" &
active_pid="$!"
wait_with_heartbeat "$active_pid" FRONTIER "$work_root/frontier.stdout" \
  || {
    active_pid=''
    frontier_reason="$(sed -n 's/^v1_3_complete_api_evaluation=blocked;reason=\([a-z0-9_]*\)$/\1/p' "$work_root/frontier.stdout" | tail -n 1)"
    failure_root_cause="${frontier_reason:-evaluator_exit}"
    failed_cases="$(awk -F'[=;]' '$1=="case_result" && ($4!=$6 || $8!="1/1" || $10!="1/1") {if(n++) printf ","; printf "%s(actual=%s,expected=%s,returned=%s,cited=%s)",$2,$4,$6,$8,$10}' "$work_root/frontier.stdout")"
    fail frontier_gate_failed "The sixty-question frontier gate failed;root_cause=${frontier_reason:-evaluator_exit};failed_cases=${failed_cases:-unfinished_case}." 'Use the named case result to correct the dependency or application boundary before rerunning Script 05.'
  }
active_pid=''
grep -Fxq 'v1_3_complete_api_evaluation=pass' "$work_root/frontier.stdout" \
  || fail frontier_pass_marker_missing 'The evaluator exited without its exact pass marker.' 'Treat the run as blocked and inspect the final case results.'
grep -Fxq 'complete_api_cases=60;expected_status_matches=60/60;required_evidence_returned=60/60;required_evidence_cited=60/60;dependency_failures=0' "$work_root/frontier.stdout" \
  || fail frontier_summary_invalid 'The frontier result did not satisfy all sixty status/evidence/citation requirements.' 'Use the exact case result lines to correct every failure before rerunning.'
PYTHONDONTWRITEBYTECODE=1 python3 -B - "$frontier_work_artifact" <<'PY' \
  || fail frontier_artifact_invalid 'The synthetic qualification artifact failed final self-validation.' 'Do not accept the run; restore the evaluator and rerun Script 05.'
import json
import pathlib
import sys
artifact = json.loads(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"))
summary = artifact["summary"]
assert artifact["artifact_kind"] == "ishikawa_v1_3_complete_api_qualification"
assert artifact["synthetic_content_only"] is True
assert summary["acceptance_gate"] == "pass"
assert summary["case_count"] == 60
assert summary["expected_status_match_count"] == 60
assert summary["required_evidence_returned_count"] == 60
assert summary["required_evidence_cited_count"] == 60
assert summary["dependency_failure_count"] == 0
PY
[[ ! -e "$artifact_path" && ! -L "$artifact_path" ]] \
  || fail artifact_path_exists 'The caller-owned target artifact path already exists.' 'Use a fresh Script 05 transfer directory.'
cp -- "$frontier_work_artifact" "$artifact_path"
chmod 0600 "$artifact_path"
emit FRONTIER "state=pass;cases=60/60;artifact_sha256=$(sha256sum -- "$artifact_path" | awk '{print $1}')"

stage='acceptance'
complete=true
emit SUMMARY 'state=pass;corpus_v3_ingestion=pass;frontier_60=pass;next_gate=attended_v1_3_human_ui_validation'
