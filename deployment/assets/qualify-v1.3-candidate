    'Correct the named Nomic credential, embedding, tokenization, model, or forwarded-endpoint condition before rerunning Script 05.'
fi
emit AUTHENTICATION 'state=pass;nomic_authenticated=true;embedding_contract=pass;tokenization_contract=pass'
