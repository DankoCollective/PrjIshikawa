start_web() {
  local run_index="$1"
  local log_path="$candidate_root/state/logs/v1.3.1-web-${run_index}.log"
  local started elapsed=0 next_heartbeat=15 log_text='' build_bytes=''
  local runtime_command='
set -eu
mkdir -p -- "$HOME" "$TMPDIR"
printf "[RUNTIME] stage=build;state=start\n"
node_modules/.bin/next build
test -f .next/BUILD_ID
test -d .next/server
printf "[RUNTIME] stage=build;state=pass\n"
printf "[RUNTIME] stage=server;state=start\n"
exec node_modules/.bin/next start --hostname "$1" --port "$2"
'
  "${docker_command[@]}" run --detach --name "$container_name" --init \
    --network host --read-only --restart no \
    --security-opt no-new-privileges --cap-drop ALL --pids-limit 512 \
    --user "$operator_uid:$operator_gid" \
    --tmpfs "/opt/nextjs/.next:rw,nosuid,nodev,size=${web_tmpfs_bytes},mode=0700,uid=${operator_uid},gid=${operator_gid}" \
    --env 'HOME=/opt/nextjs/.next/home' --env 'TMPDIR=/opt/nextjs/.next/tmp' \
    --env 'TMP=/opt/nextjs/.next/tmp' --env 'TEMP=/opt/nextjs/.next/tmp' \
    --env 'NEXT_TELEMETRY_DISABLED=1' --env 'NODE_ENV=production' \
    --env "ISHIKAWA_PRODUCT_DISPLAY_NAME=${web_config[0]}" \
    --env "ISHIKAWA_PRODUCT_UI_CONFIG_BASE64=${web_config[1]}" \
    --env "ISHIKAWA_RETRIEVAL_BASE_URL=http://127.0.0.1:${retrieval_port}" \
    --mount "type=bind,src=$candidate_root/application/web/app,dst=/opt/nextjs/app,readonly" \
    --mount "type=bind,src=$candidate_root/application/web/components,dst=/opt/nextjs/components,readonly" \
    --mount "type=bind,src=$candidate_root/application/web/lib,dst=/opt/nextjs/lib,readonly" \
    --mount "type=bind,src=$candidate_root/application/web/public,dst=/opt/nextjs/public,readonly" \
    --mount "type=bind,src=$candidate_root/application/web/package.json,dst=/opt/nextjs/package.json,readonly" \
    --mount "type=bind,src=$candidate_root/application/web/next.config.mjs,dst=/opt/nextjs/next.config.mjs,readonly" \
    "$expected_image_reference" sh -c "$runtime_command" runtime 127.0.0.1 "$ui_port" >/dev/null \
    || fail candidate_web_container_start_failed 'Docker could not create the exact production web container.' 'Correct the reported container boundary and rerun Script 09.'
  started="$(date +%s)"
  emit WEB "state=building;run=$run_index;elapsed_seconds=0"
  while (( elapsed < 300 )); do
    log_text="$("${docker_command[@]}" logs --tail 160 "$container_name" 2>&1 || true)"
    printf '%s\n' "$log_text" >"$log_path"
    grep -Fxq '[RUNTIME] stage=build;state=pass' <<<"$log_text" && break
    container_running || fail candidate_web_build_failed "The production build container exited;$(safe_log_detail "$log_path" web)." 'Inspect the protected web log digest and correct the exact build boundary.'
    sleep 1
    elapsed=$(( $(date +%s) - started ))
    if (( elapsed >= next_heartbeat )); then
      emit WEB "state=building;run=$run_index;elapsed_seconds=$elapsed"
      next_heartbeat=$((next_heartbeat + 15))
    fi
  done
  grep -Fxq '[RUNTIME] stage=build;state=pass' <<<"$log_text" \
    || fail candidate_web_build_timeout "The production build exceeded 300 seconds;$(safe_log_detail "$log_path" web)." 'Correct the build capacity or application boundary before retrying.'
  wait_http "http://127.0.0.1:${ui_port}/api/live" 160 WEB \
    || fail candidate_web_liveness_failed "The production server did not become live;$(safe_log_detail "$log_path" web)." 'Correct the production start boundary.'
  wait_http "http://127.0.0.1:${ui_port}/api/ready" 120 WEB \
    || fail candidate_web_readiness_failed "The production server did not proxy ready;$(safe_log_detail "$log_path" web)." 'Correct the UI-to-API boundary.'
  [[ "$(http_status "http://127.0.0.1:${ui_port}/")" == 200 \
      && "$(http_status "http://127.0.0.1:${ui_port}/theme-init.js")" == 200 \
      && "$(http_status "http://127.0.0.1:${ui_port}/api/dependencies")" == 200 ]] \
    || fail candidate_web_surface_failed 'Home, static asset, or dependency proxy did not return HTTP 200.' 'Correct the exact production UI surface.'
  build_bytes="$("${docker_command[@]}" exec "$container_name" du -sb /opt/nextjs/.next 2>/dev/null | awk '{print $1}' || true)"
  [[ "$build_bytes" =~ ^[0-9]+$ && "$build_bytes" -gt 0 && "$build_bytes" -lt "$web_tmpfs_bytes" ]] \
    || fail candidate_web_build_capacity_unverified 'The generated .next bytes did not fit the bounded tmpfs contract.' 'Correct the build footprint before qualification.'
  [[ "$("${docker_command[@]}" inspect --format '{{index .HostConfig.Tmpfs "/opt/nextjs/.next"}}' "$container_name" 2>/dev/null || true)" == *"size=${web_tmpfs_bytes}"* ]] \
    || fail candidate_web_tmpfs_contract_missing 'The running container omitted the exact bounded .next tmpfs.' 'Correct the production container contract.'
  web_build_seconds="$(( $(date +%s) - started ))"
  web_build_bytes="$build_bytes"
}

