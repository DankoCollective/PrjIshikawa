mkdir -p -- "$user_unit_root"
units_installed=true
for unit_name in "${unit_names[@]}"; do
  install -m 0644 -- "$install_root/systemd/$unit_name" "$user_unit_root/$unit_name"
done
systemctl --user daemon-reload >/dev/null 2>&1 || fail user_manager_reload_failed
for unit_name in "${unit_names[@]}"; do
  [[ "$(systemctl --user is-enabled "$unit_name" 2>/dev/null || true)" != enabled ]] \
    || fail installed_unit_boot_enabled
done
[[ "$(loginctl show-user "$USER" --property=Linger --value 2>/dev/null || true)" != yes ]] \
  || fail user_lingering_enabled_after_install
printf '[UNITS] state=pass;installed=true;enabled=false;lingering=false\n'

trap - EXIT INT TERM
rm -rf -- "$temporary_root"
printf 'ishikawa_deployment=apply;state=pass;install_root=%s;plan_sha256=%s;boot_enabled=false;database_changed=false\n' \
  "$install_root" "$reviewed_plan_sha256"
printf '\nSCRIPT RESULT\nishikawa_deployment_apply=pass\n'
