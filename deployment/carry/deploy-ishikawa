#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

# Purpose:
#   Inventory, install, initialize, operate, and remove one portable Ishikawa
#   demo deployment through a single operator entrypoint.
#
# Mental model:
#   Verify immutable package bytes before every mutation. Keep application,
#   image, database, user-unit, and runtime transitions explicit. Generate a
#   complete non-secret installation plan, bind apply to its reviewed SHA-256,
#   refuse drift, and roll back only objects created by a failed action.
#
# Inputs or prerequisites:
#   A deployment-ready package, Ubuntu 26.04 AMD64, reviewed native
#   prerequisites, attended sudo where stated, and action-specific credentials.
#
# Outputs or artifact lane:
#   inventory writes only to the selected output directory; installation uses
#   $HOME/Documents/Ishikawa and $HOME/.config/systemd/user; schema setup uses
#   the named local PostgreSQL cluster. Boot enablement and lingering stay off.
#
# Usage:
#   bash ./deploy-ishikawa --help

usage() {
  printf '%s\n' \
    'Usage: deploy-ishikawa verify' \
    '       deploy-ishikawa inventory --output-dir /tmp/NAME [port and host options]' \
    '       deploy-ishikawa plan --output-plan FILE [port and host options]' \
    '       deploy-ishikawa apply --plan-file FILE --plan-sha256 SHA256' \
    '       deploy-ishikawa install-schema' \
    '       deploy-ishikawa start|status|stop' \
    '       deploy-ishikawa remove --confirm-empty-installation' \
    '' \
    'Options for inventory, plan, and install-schema where applicable:' \
    '  --expected-hostname NAME' \
    '  --expected-os-version VERSION       Default: 26.04' \
    '  --postgresql-port PORT              Default: 5432' \
    '  --retrieval-port PORT               Default: 8384' \
    '  --web-port PORT                     Default: 3384' \
    '  --gemma-port PORT                   Default: 8000' \
    '  --nomic-port PORT                   Default: 8001' \
    'Options for plan:' \
    '  --output-plan FILE                  New absolute plan path' \
    'Options for apply:' \
    '  --plan-file FILE                    Reviewed plan path' \
    '  --plan-sha256 SHA256                Reviewed plan identity' \
    'Options for inventory only:' \
    '  --protected-source-root PATH        Optional protected corpus root check' \
    '  --use-sudo-inspection               Attended Docker/PostgreSQL inspection'
}

fail() {
  printf '%s\n' \
    'FAILURE DETAIL' \
    "action=${action:-argument_validation}" \
    "reason=$1" \
    'operator_action=Correct the reported condition and rerun the same command.' \
    '' \
    'SCRIPT RESULT' \
    "ishikawa_deployment_${action:-command}=blocked" >&2
  exit 1
}

fail_for_signal() {
  local failure_reason="$1" signal_status="$2"
  printf '%s\n' \
    'FAILURE DETAIL' \
    "action=${action:-argument_validation}" \
    "reason=$failure_reason" \
    'operator_action=Review cleanup state, correct the interruption cause, and rerun.' \
    '' \
    'SCRIPT RESULT' \
    "ishikawa_deployment_${action:-command}=blocked" >&2
  exit "$signal_status"
}

(( $# >= 1 )) || { usage >&2; exit 2; }
action="$1"
shift
readonly action_argument_count="$#"
case "$action" in
  verify|inventory|plan|apply|install-schema|start|status|stop|remove) ;;
  --help|-h) usage; exit 0 ;;
  *) usage >&2; exit 2 ;;
esac

readonly carry_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
readonly verifier="$carry_root/verify-deployment"
readonly inspector="$carry_root/inspect-native-prerequisites"
readonly application_archive="$carry_root/ishikawa-v1.3.1.tar.gz"
readonly image_archive="$carry_root/node-next-runtime-amd64.tar"
readonly image_identity="$carry_root/runtime-image-identity.json"
readonly package_receipt="$carry_root/deployment-package-receipt.json"
readonly image_reference='node-next-runtime:24.22.1-next16.4.3-react19.2.9-amd64'
readonly install_root="$HOME/Documents/Ishikawa"
readonly user_unit_root="$HOME/.config/systemd/user"
readonly temporary_base="${TMPDIR:-/tmp}"
readonly -a unit_names=(
  ishikawa-observability-retention.service
  ishikawa-observability-retention.timer
  ishikawa-retrieval-api.service
)

[[ -f "$verifier" && ! -L "$verifier" ]] || fail verifier_missing
[[ "$temporary_base" == /tmp || "$temporary_base" == /tmp/* ]] \
  || fail temporary_directory_invalid
[[ -d "$temporary_base" && ! -L "$temporary_base" && -w "$temporary_base" ]] \
  || fail temporary_directory_unsafe

if [[ "$action" == verify ]]; then
  (( $# == 0 )) || fail arguments_invalid
  exec bash "$verifier"
fi

expected_hostname=''
expected_os_version='26.04'
postgresql_port='5432'
retrieval_port='8384'
web_port='3384'
gemma_port='8000'
nomic_port='8001'
output_dir=''
output_plan=''
plan_file=''
reviewed_plan_sha256=''
protected_source_root=''
use_sudo_inspection=false
confirm_remove=false
expected_hostname_supplied=false
expected_os_version_supplied=false
postgresql_port_supplied=false
retrieval_port_supplied=false
web_port_supplied=false
gemma_port_supplied=false
nomic_port_supplied=false
output_dir_supplied=false
output_plan_supplied=false
plan_file_supplied=false
reviewed_plan_sha256_supplied=false
protected_source_root_supplied=false
while (( $# > 0 )); do
  case "$1" in
    --expected-hostname) expected_hostname="${2:-}"; expected_hostname_supplied=true; shift 2 ;;
    --expected-os-version) expected_os_version="${2:-}"; expected_os_version_supplied=true; shift 2 ;;
    --postgresql-port) postgresql_port="${2:-}"; postgresql_port_supplied=true; shift 2 ;;
    --retrieval-port) retrieval_port="${2:-}"; retrieval_port_supplied=true; shift 2 ;;
    --web-port) web_port="${2:-}"; web_port_supplied=true; shift 2 ;;
    --gemma-port) gemma_port="${2:-}"; gemma_port_supplied=true; shift 2 ;;
    --nomic-port) nomic_port="${2:-}"; nomic_port_supplied=true; shift 2 ;;
    --protected-source-root) protected_source_root="${2:-}"; protected_source_root_supplied=true; shift 2 ;;
    --use-sudo-inspection) use_sudo_inspection=true; shift ;;
    --output-dir) output_dir="${2:-}"; output_dir_supplied=true; shift 2 ;;
    --output-plan) output_plan="${2:-}"; output_plan_supplied=true; shift 2 ;;
    --plan-file) plan_file="${2:-}"; plan_file_supplied=true; shift 2 ;;
    --plan-sha256) reviewed_plan_sha256="${2:-}"; reviewed_plan_sha256_supplied=true; shift 2 ;;
    --confirm-empty-installation) confirm_remove=true; shift ;;
    *) fail arguments_invalid ;;
  esac
done

if [[ "$action" == apply ]]; then
  [[ "$plan_file_supplied" == true && "$reviewed_plan_sha256_supplied" == true \
      && "$expected_hostname_supplied" == false \
      && "$expected_os_version_supplied" == false \
      && "$postgresql_port_supplied" == false \
      && "$retrieval_port_supplied" == false && "$web_port_supplied" == false \
      && "$gemma_port_supplied" == false && "$nomic_port_supplied" == false \
      && "$output_dir_supplied" == false && "$output_plan_supplied" == false \
      && "$protected_source_root_supplied" == false \
      && "$use_sudo_inspection" == false && "$confirm_remove" == false ]] \
    || fail arguments_invalid
  [[ "$plan_file" == /* && -f "$plan_file" && ! -L "$plan_file" \
      && -r "$plan_file" ]] || fail reviewed_plan_invalid
  [[ "$reviewed_plan_sha256" =~ ^[0-9a-f]{64}$ ]] \
    || fail reviewed_plan_sha256_invalid
  for required_command in awk python3 sha256sum; do
    command -v "$required_command" >/dev/null 2>&1 \
      || fail "command_missing_${required_command}"
  done
  actual_plan_sha256="$(sha256sum -- "$plan_file" | awk '{print $1}')"
  [[ "$actual_plan_sha256" == "$reviewed_plan_sha256" ]] \
    || fail reviewed_plan_sha256_mismatch
  mapfile -t reviewed_plan_values < <(python3 -B - "$plan_file" <<'PY'
import json
import sys
from pathlib import Path

plan = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
if plan.get("schema") != "ishikawa.installation-plan.v1":
    raise SystemExit(1)
target = plan.get("target", {})
ports = plan.get("ports", {})
values = (
    target.get("hostname"),
    target.get("os_version"),
    ports.get("postgresql"),
    ports.get("retrieval"),
    ports.get("web"),
    ports.get("gemma"),
    ports.get("nomic"),
)
if not isinstance(values[0], str) or not isinstance(values[1], str):
    raise SystemExit(1)
if any(type(value) is not int for value in values[2:]):
    raise SystemExit(1)
print(*values, sep="\n")
PY
  ) || fail reviewed_plan_invalid
  (( ${#reviewed_plan_values[@]} == 7 )) || fail reviewed_plan_invalid
  expected_hostname="${reviewed_plan_values[0]}"
  expected_os_version="${reviewed_plan_values[1]}"
  postgresql_port="${reviewed_plan_values[2]}"
  retrieval_port="${reviewed_plan_values[3]}"
  web_port="${reviewed_plan_values[4]}"
  gemma_port="${reviewed_plan_values[5]}"
  nomic_port="${reviewed_plan_values[6]}"
fi

if [[ "$action" == inventory ]]; then
  [[ -n "$output_dir" ]] || fail output_directory_required
  [[ "$confirm_remove" == false && "$output_plan_supplied" == false \
      && "$plan_file_supplied" == false \
      && "$reviewed_plan_sha256_supplied" == false ]] || fail arguments_invalid
  printf '[VERIFY] state=start;mutation=false\n'
  bash "$verifier" >/dev/null || fail carry_verification_failed
  printf '[VERIFY] state=pass;release=v1.3.1;mutation=false\n'
  arguments=(
    --expected-os-version "$expected_os_version"
    --expected-architecture amd64
    --postgresql-port "$postgresql_port"
    --retrieval-port "$retrieval_port"
    --web-port "$web_port"
    --gemma-port "$gemma_port"
    --nomic-port "$nomic_port"
    --output-dir "$output_dir"
  )
  [[ -z "$expected_hostname" ]] || arguments+=(--expected-hostname "$expected_hostname")
  [[ -z "$protected_source_root" ]] \
    || arguments+=(--protected-source-root "$protected_source_root")
  [[ "$use_sudo_inspection" == false ]] || arguments+=(--use-sudo-inspection)
  exec bash "$inspector" "${arguments[@]}"
fi

if [[ "$action" == start || "$action" == status || "$action" == stop ]]; then
  (( action_argument_count == 0 )) || fail arguments_invalid
  [[ -x "$install_root/scripts/ishikawa-stack" ]] || fail application_not_installed
  exec "$install_root/scripts/ishikawa-stack" "$action"
fi

if [[ "$action" == install-schema ]]; then
  [[ "$expected_hostname_supplied" == false && "$expected_os_version_supplied" == false \
      && "$retrieval_port_supplied" == false && "$web_port_supplied" == false \
      && "$gemma_port_supplied" == false && "$nomic_port_supplied" == false \
      && "$output_dir_supplied" == false && "$protected_source_root_supplied" == false \
      && "$output_plan_supplied" == false && "$plan_file_supplied" == false \
      && "$reviewed_plan_sha256_supplied" == false \
      && "$use_sudo_inspection" == false && "$confirm_remove" == false ]] \
    || fail arguments_invalid
  [[ "$postgresql_port" =~ ^[0-9]+$ && "$postgresql_port" -ge 1 \
      && "$postgresql_port" -le 65535 ]] || fail port_invalid
  for required in bash chmod dropdb jq pg_isready psql python3 rm sleep sudo systemctl tar; do
    command -v "$required" >/dev/null 2>&1 || fail "command_missing_${required}"
  done
  bash "$verifier" >/dev/null || fail carry_verification_failed
  [[ "$(jq -r '.release_state' "$package_receipt")" == deployment_ready ]] \
    || fail carry_not_final
  [[ -f "$install_root/config/deployment.yaml" && ! -L "$install_root/config/deployment.yaml" ]] \
    || fail application_not_installed
  installed_postgresql_port="$(python3 -B - "$install_root/config/deployment.yaml" <<'PY'
import sys
from pathlib import Path
import yaml
value = yaml.safe_load(Path(sys.argv[1]).read_text(encoding="utf-8"))
print(value.get("postgresql", {}).get("port", "invalid"))
PY
)" || fail installed_configuration_invalid
  [[ "$installed_postgresql_port" == "$postgresql_port" ]] \
    || fail postgresql_port_mismatch
  ingest_password="${ISHIKAWA_POSTGRESQL_INGEST_PASSWORD-}"
  retrieval_password="${ISHIKAWA_POSTGRESQL_PASSWORD-}"
  for selected_password in "$ingest_password" "$retrieval_password"; do
    [[ ${#selected_password} -ge 16 && ${#selected_password} -le 256 ]] \
      || fail database_credential_invalid
    [[ "$selected_password" != *$'\n'* && "$selected_password" != *$'\r'* ]] \
      || fail database_credential_invalid
    [[ ! "$selected_password" =~ [[:cntrl:]] ]] || fail database_credential_invalid
  done
  [[ "$ingest_password" != "$retrieval_password" ]] || fail database_credentials_not_distinct
  temporary_schema_root="$(mktemp -d "$temporary_base/ishikawa-schema-install.XXXXXX")"
  postgresql_started=false
  database_mutation_started=false
  setup_token="$(python3 -B - <<'PY'
import secrets
print(secrets.token_hex(16))
PY
)"
  cleanup_schema() {
    local status="$?"
    trap - EXIT INT TERM
    if (( status != 0 )) && [[ "$database_mutation_started" == true ]]; then
      marker_count="$(sudo -u postgres -- psql --no-psqlrc --port "$postgresql_port" \
        --tuples-only --no-align \
        --dbname=postgres --command="SELECT count(*) FROM pg_roles WHERE rolname IN ('rag_owner','rag_ingest','rag_retrieval') AND shobj_description(oid, 'pg_authid') = 'ishikawa-setup:${setup_token}'" \
        2>/dev/null || true)"
      if [[ "$marker_count" == 3 ]]; then
        sudo -u postgres -- psql --no-psqlrc --port "$postgresql_port" --dbname=postgres \
          --set=ON_ERROR_STOP=1 --command="SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname = 'rag_catalog' AND pid <> pg_backend_pid()" \
          >/dev/null 2>&1 || true
        sudo -u postgres -- dropdb --port "$postgresql_port" --if-exists rag_catalog \
          >/dev/null 2>&1 || true
        sudo -u postgres -- psql --no-psqlrc --port "$postgresql_port" --dbname=postgres \
          --set=ON_ERROR_STOP=1 \
          --command='DROP ROLE IF EXISTS rag_retrieval, rag_ingest, rag_owner' \
          >/dev/null 2>&1 || true
      fi
    fi
    if [[ "$postgresql_started" == true ]]; then
      sudo systemctl stop postgresql@16-main.service >/dev/null 2>&1 || true
    fi
    [[ "$temporary_schema_root" == "$temporary_base"/ishikawa-schema-install.* \
        && -d "$temporary_schema_root" ]] && rm -rf -- "$temporary_schema_root"
    exit "$status"
  }
  trap cleanup_schema EXIT
  trap 'fail_for_signal signal_interrupt 130' INT
  trap 'fail_for_signal signal_termination 143' TERM
  tar --no-same-owner --no-same-permissions -xzf "$application_archive" \
    -C "$temporary_schema_root" \
    || fail application_extraction_failed
  chmod 0755 "$temporary_schema_root" \
    "$temporary_schema_root/ishikawa-v1.3.1" \
    "$temporary_schema_root/ishikawa-v1.3.1/database" \
    "$temporary_schema_root/ishikawa-v1.3.1/database/install-schema"
  chmod 0644 "$temporary_schema_root/ishikawa-v1.3.1/database/"{README.md,SHA256SUMS,schema.sql}
  printf '[DATABASE] state=preflight;mutation=false\n'
  sudo -v || fail privilege_authorization_failed
  [[ "$(systemctl is-enabled postgresql.service 2>/dev/null || true)" != enabled ]] \
    || fail postgresql_boot_enabled
  [[ "$(systemctl is-enabled postgresql@16-main.service 2>/dev/null || true)" != enabled ]] \
    || fail postgresql_cluster_boot_enabled
  [[ "$(systemctl is-active postgresql@16-main.service 2>/dev/null || true)" != active ]] \
    || fail postgresql_cluster_already_active
  sudo systemctl start postgresql@16-main.service >/dev/null 2>&1 \
    || fail postgresql_start_failed
  postgresql_started=true
  for (( attempt = 0; attempt < 80; attempt += 1 )); do
    pg_isready --quiet --host 127.0.0.1 --port "$postgresql_port" && break
    sleep 0.25
  done
  pg_isready --quiet --host 127.0.0.1 --port "$postgresql_port" \
    || fail postgresql_readiness_failed
  preflight_counts="$(sudo -u postgres -- psql --no-psqlrc --port "$postgresql_port" \
    --tuples-only --no-align \
    --dbname=postgres --set=ON_ERROR_STOP=1 <<'SQL'
SELECT count(*) FROM pg_roles WHERE rolname IN ('rag_owner','rag_ingest','rag_retrieval');
SELECT count(*) FROM pg_database WHERE datname = 'rag_catalog';
SELECT count(*) FROM pg_available_extensions WHERE name = 'vector';
SQL
)" || fail database_preflight_failed
  [[ "$preflight_counts" == $'0\n0\n1' ]] || fail database_target_not_clean
  printf '[DATABASE] state=creating;roles=3;database=rag_catalog;schema=5\n'
  database_mutation_started=true
  if ! ISHIKAWA_SETUP_INGEST_PASSWORD="$ingest_password" \
      ISHIKAWA_SETUP_RETRIEVAL_PASSWORD="$retrieval_password" \
      ISHIKAWA_SETUP_TOKEN="$setup_token" python3 -B - <<'PY' \
      | sudo -u postgres -- psql --no-psqlrc --port "$postgresql_port" --dbname=postgres \
          --set=ON_ERROR_STOP=1 >/dev/null
import os

def literal(value: str) -> str:
    return "'" + value.replace("'", "''") + "'"

ingest = literal(os.environ["ISHIKAWA_SETUP_INGEST_PASSWORD"])
retrieval = literal(os.environ["ISHIKAWA_SETUP_RETRIEVAL_PASSWORD"])
marker = literal("ishikawa-setup:" + os.environ["ISHIKAWA_SETUP_TOKEN"])
print("BEGIN;")
print("CREATE ROLE rag_owner NOLOGIN;")
print(f"CREATE ROLE rag_ingest LOGIN PASSWORD {ingest};")
print(f"CREATE ROLE rag_retrieval LOGIN PASSWORD {retrieval};")
print(f"COMMENT ON ROLE rag_owner IS {marker};")
print(f"COMMENT ON ROLE rag_ingest IS {marker};")
print(f"COMMENT ON ROLE rag_retrieval IS {marker};")
print("COMMIT;")
print("CREATE DATABASE rag_catalog OWNER rag_owner;")
print("\\connect rag_catalog")
print("CREATE EXTENSION vector;")
PY
  then
    fail database_creation_failed
  fi
  sudo -u postgres -- env PGPORT="$postgresql_port" bash \
    "$temporary_schema_root/ishikawa-v1.3.1/database/install-schema" \
    --database rag_catalog --owner-role rag_owner \
    --ingest-role rag_ingest --retrieval-role rag_retrieval \
    || fail schema_install_failed
  sudo -u postgres -- psql --no-psqlrc --port "$postgresql_port" --dbname=postgres \
    --set=ON_ERROR_STOP=1 \
    --command='COMMENT ON ROLE rag_owner IS NULL; COMMENT ON ROLE rag_ingest IS NULL; COMMENT ON ROLE rag_retrieval IS NULL' \
    >/dev/null || fail database_setup_marker_cleanup_failed
  database_mutation_started=false
  printf '[DATABASE] state=pass;database=rag_catalog;schema=5;roles=least_privilege\n'
  printf '\nSCRIPT RESULT\nishikawa_deployment_install_schema=pass\n'
  exit 0
fi

if [[ "$action" == remove ]]; then
  [[ "$confirm_remove" == true && "$action_argument_count" == 1 \
      && "$output_plan_supplied" == false && "$plan_file_supplied" == false \
      && "$reviewed_plan_sha256_supplied" == false ]] \
    || fail explicit_empty_removal_confirmation_required
  [[ -d "$install_root" && ! -L "$install_root" ]] || fail application_not_installed
  [[ "$(cd -- "$install_root" && pwd -P)" == "$(cd -- "$HOME/Documents" && pwd -P)/Ishikawa" ]] \
    || fail installation_path_unsafe
  stack_status="$("$install_root/scripts/ishikawa-stack" status 2>/dev/null || true)"
  grep -Fxq 'ishikawa_stack=status;state=stopped;boot_enabled=false' <<<"$stack_status" \
    || fail stack_must_be_stopped
  find "$install_root/corpus/source" -type f -print -quit | grep -q . \
    && fail source_documents_present
  find "$install_root/config/ingestion" -type f -print -quit | grep -q . \
    && fail ingestion_records_present
  find "$install_root/state" -type f -print -quit | grep -q . \
    && fail runtime_state_present
  for unit_name in "${unit_names[@]}"; do
    [[ "$(systemctl --user is-active "$unit_name" 2>/dev/null || true)" != active ]] \
      || fail user_unit_active
    [[ "$(systemctl --user is-enabled "$unit_name" 2>/dev/null || true)" != enabled ]] \
      || fail user_unit_enabled
  done
  for unit_name in "${unit_names[@]}"; do rm -f -- "$user_unit_root/$unit_name"; done
  systemctl --user daemon-reload >/dev/null 2>&1 || fail user_manager_reload_failed
  rm -rf -- "$install_root"
  printf 'ishikawa_deployment=remove;state=application_removed;database_removed=false;image_removed=false\n'
  printf '\nSCRIPT RESULT\nishikawa_deployment_remove=pass\n'
  exit 0
fi

[[ "$action" == plan || "$action" == apply ]] || fail arguments_invalid
if [[ "$action" == plan ]]; then
  [[ "$output_plan_supplied" == true && -n "$output_plan" \
      && "$output_plan" == /* && "$plan_file_supplied" == false \
      && "$reviewed_plan_sha256_supplied" == false \
      && "$output_dir_supplied" == false \
      && "$protected_source_root_supplied" == false \
      && "$use_sudo_inspection" == false && "$confirm_remove" == false ]] \
    || fail arguments_invalid
  [[ ! -e "$output_plan" && ! -L "$output_plan" \
      && -d "$(dirname -- "$output_plan")" \
      && ! -L "$(dirname -- "$output_plan")" ]] \
    || fail output_plan_path_invalid
fi
(( EUID != 0 )) || fail non_root_operator_required
[[ "$HOME" == /* && "$install_root" == "$HOME/Documents/Ishikawa" ]] \
  || fail operator_home_invalid
[[ -z "$expected_hostname" || "$expected_hostname" =~ ^[A-Za-z0-9][A-Za-z0-9.-]*$ ]] \
  || fail expected_hostname_invalid
[[ "$expected_os_version" =~ ^[0-9]{2}\.[0-9]{2}$ ]] || fail expected_os_version_invalid
for selected_port in "$postgresql_port" "$retrieval_port" "$web_port" "$gemma_port" "$nomic_port"; do
  [[ "$selected_port" =~ ^[0-9]+$ && "$selected_port" -ge 1 && "$selected_port" -le 65535 ]] \
    || fail port_invalid
done
[[ "$(printf '%s\n' "$postgresql_port" "$retrieval_port" "$web_port" "$gemma_port" "$nomic_port" \
  | sort -u | awk 'END {print NR}')" == 5 ]] || fail ports_collide
for required in awk bash cmp cp docker find grep hostname id install jq loginctl \
  mkdir mktemp mv python3 rm sha256sum sort sudo systemctl tar; do
  command -v "$required" >/dev/null 2>&1 || fail "command_missing_${required}"
done
printf '[PREFLIGHT] state=start;mutation=false\n'
bash "$verifier" >/dev/null || fail carry_verification_failed
[[ "$(jq -r '.release_state' "$package_receipt")" == deployment_ready ]] \
  || fail carry_not_final
if [[ "$action" == plan ]]; then
  [[ ! -e "$install_root" && ! -L "$install_root" ]] || fail installation_exists
  for unit_name in "${unit_names[@]}"; do
    [[ ! -e "$user_unit_root/$unit_name" && ! -L "$user_unit_root/$unit_name" ]] \
      || fail user_unit_target_exists
  done
else
  [[ ! -L "$install_root" ]] || fail installation_path_unsafe
fi
[[ "$(loginctl show-user "$USER" --property=Linger --value 2>/dev/null || true)" != yes ]] \
  || fail user_lingering_enabled
[[ "$(systemctl is-enabled postgresql.service 2>/dev/null || true)" != enabled ]] \
  || fail postgresql_boot_enabled
[[ "$(systemctl is-enabled postgresql@16-main.service 2>/dev/null || true)" != enabled ]] \
  || fail postgresql_cluster_boot_enabled
systemctl cat postgresql@16-main.service >/dev/null 2>&1 \
  || fail postgresql_cluster_unit_missing
systemctl --user show-environment >/dev/null 2>&1 || fail user_manager_unavailable
printf '[PREFLIGHT] state=pass;carry=verified;target_paths=free;boot_enabled=false\n'

inventory_parent="$(mktemp -d "$temporary_base/ishikawa-install-inventory.XXXXXX")"
inventory_root="$inventory_parent/inventory"
inventory_arguments=(
