#!/usr/bin/env bash
set -Eeuo pipefail

# Purpose:
#   Install the reviewed PostgreSQL 16, pgvector, and Psycopg packages from a
#   local directory on Tech without using a network repository.
#
# Mental model:
#   1. Confirm Ubuntu 26.04 AMD64 and the seven exact carried package versions.
#   2. Present the carried .deb files to APT as a temporary SHA-256-backed,
#      file-only catalog.
#   3. Simulate the seven-package request and refuse removals, downgrades, or
#      upgrades of anything already installed on Tech.
#   4. With --apply, install that plan while blocking service auto-start, then
#      leave PostgreSQL stopped and disabled at boot.
#
# Usage:
#   bash ./install-native-prerequisites \
#     --package-directory /pce/import/deb/debs --plan
#   bash ./install-native-prerequisites \
#     --package-directory /pce/import/deb/debs --apply

umask 077

execution_action=""
package_directory_path=""
temporary_runtime_directory=""
service_start_policy_installed=false
package_application_started=false
script_result_emitted=false

required_package_version_pins=(
  'python3-psycopg=3.3.2-1build1'
  'postgresql-common=293.pgdg26.04+1'
  'postgresql-client-common=293.pgdg26.04+1'
  'libpq5=18.6-1.pgdg26.04+2'
  'postgresql-client-16=16.15-1.pgdg26.04+2'
  'postgresql-16=16.15-1.pgdg26.04+2'
  'postgresql-16-pgvector=0.8.7-1.pgdg26.04+1'
)

emit_script_result() {
  if [[ "$script_result_emitted" == false ]]; then
    printf '\nSCRIPT RESULT\ninstall-native-prerequisites=%s\n' "$1"
    script_result_emitted=true
  fi
}

fail_with_detail() {
  printf '\nFAILURE DETAIL\nreason=%s\ndetail=%s\n' "$1" "$2" >&2
  emit_script_result "blocked;reason=$1"
  exit 1
}

handle_unexpected_error() {
  local exit_status=$?
  local line_number="$1"
  if [[ "$script_result_emitted" == false ]]; then
    printf '\nFAILURE DETAIL\nreason=unexpected_error\ndetail=Command failed at line %s with status %s.\n' \
      "$line_number" "$exit_status" >&2
    emit_script_result 'blocked;reason=unexpected_error'
  fi
  exit "$exit_status"
}

handle_signal() {
  emit_script_result "blocked;reason=$1"
  exit "$2"
}

cleanup_temporary_state() {
  local exit_status=$?
  trap - EXIT
  if [[ "$service_start_policy_installed" == true ]]; then
    sudo rm -f -- /usr/sbin/policy-rc.d >/dev/null 2>&1 || true
  fi
  if [[ "$package_application_started" == true ]]; then
    sudo systemctl stop postgresql@16-main.service postgresql.service \
      >/dev/null 2>&1 || true
    sudo systemctl disable postgresql@16-main.service postgresql.service \
      >/dev/null 2>&1 || true
  fi
  if [[ -n "$temporary_runtime_directory" \
    && "$temporary_runtime_directory" == /tmp/native-prerequisite-install.* ]]; then
    rm -rf -- "$temporary_runtime_directory"
  fi
  exit "$exit_status"
}
trap cleanup_temporary_state EXIT
trap 'handle_unexpected_error "$LINENO"' ERR
trap 'handle_signal interrupted 130' INT
trap 'handle_signal terminated 143' TERM

while (($#)); do
  case "$1" in
    --package-directory)
      (($# >= 2)) \
        || fail_with_detail invalid_arguments '--package-directory requires a directory.'
      [[ -z "$package_directory_path" ]] \
        || fail_with_detail invalid_arguments \
          '--package-directory was provided more than once.'
      package_directory_path="$2"
      [[ -n "$package_directory_path" ]] \
        || fail_with_detail invalid_arguments \
          '--package-directory requires a directory.'
      shift 2
      ;;
    --plan|--apply)
      [[ -z "$execution_action" ]] \
        || fail_with_detail invalid_arguments 'Select one action.'
      execution_action="${1#--}"
      shift
      ;;
    --help) sed -n '4,18p' "$0"; exit 0 ;;
    *) fail_with_detail invalid_arguments "Unsupported argument: $1" ;;
  esac
done

[[ -n "$package_directory_path" && -n "$execution_action" ]] \
  || fail_with_detail invalid_arguments \
    '--package-directory and --plan or --apply are required.'
(( EUID != 0 )) \
  || fail_with_detail root_operator_forbidden 'Run as the Tech operator, not root.'

for command_name in apt-get awk dpkg dpkg-deb dpkg-query find grep install ln \
  mktemp python3 readlink rm sha256sum sort stat sudo systemctl tee; do
  command -v "$command_name" >/dev/null \
    || fail_with_detail missing_command "Missing command: $command_name"
done

operating_system_id="$(awk -F= '$1=="ID" {gsub(/\"/,"",$2); print $2}' /etc/os-release)"
operating_system_version="$(awk -F= '$1=="VERSION_ID" {gsub(/\"/,"",$2); print $2}' /etc/os-release)"
[[ "$operating_system_id" == ubuntu && "$operating_system_version" == 26.04 ]] \
  || fail_with_detail target_os_wrong \
    "Expected Ubuntu 26.04; observed $operating_system_id $operating_system_version."
[[ "$(dpkg --print-architecture)" == amd64 ]] \
  || fail_with_detail target_architecture_wrong 'Expected AMD64.'

[[ -d "$package_directory_path" ]] \
  || fail_with_detail package_directory_missing \
    "Missing directory: $package_directory_path"
package_directory_path="$(readlink -f -- "$package_directory_path")" \
  || fail_with_detail package_directory_unreadable \
    "Could not resolve directory: $package_directory_path"
mapfile -d '' package_archive_paths < <(
  find "$package_directory_path" -maxdepth 1 -type f -name '*.deb' -print0 | sort -z
)
[[ "${#package_archive_paths[@]}" == 97 ]] \
  || fail_with_detail package_archive_count_wrong \
    "Expected 97 .deb files; observed ${#package_archive_paths[@]}."

declare -A carried_package_versions=()
for package_archive_path in "${package_archive_paths[@]}"; do
  package_name="$(dpkg-deb -f "$package_archive_path" Package)"
  package_architecture="$(dpkg-deb -f "$package_archive_path" Architecture)"
  [[ "$package_architecture" == amd64 || "$package_architecture" == all ]] \
    || fail_with_detail package_architecture_wrong \
      "Wrong architecture in ${package_archive_path##*/}: $package_architecture"
  [[ -z "${carried_package_versions[$package_name]+present}" ]] \
    || fail_with_detail duplicate_package "More than one .deb provides $package_name."
  carried_package_versions[$package_name]="$(dpkg-deb -f "$package_archive_path" Version)"
done
for package_version_pin in "${required_package_version_pins[@]}"; do
  package_name="${package_version_pin%%=*}"
  expected_version="${package_version_pin#*=}"
  [[ "${carried_package_versions[$package_name]:-missing}" == "$expected_version" ]] \
    || fail_with_detail direct_package_wrong \
      "Expected $package_version_pin; found ${carried_package_versions[$package_name]:-missing}."
done
[[ -z "$(dpkg --audit)" ]] \
  || fail_with_detail dpkg_state_unclean 'dpkg reports an incomplete transaction.'
printf '[READINESS] state=pass;package_archives=97;os=ubuntu-26.04;architecture=amd64\n'

# Build a private file-only catalog so APT retains compatible packages that
# are already installed instead of forcing every clean-system closure file.
temporary_runtime_directory="$(mktemp -d /tmp/native-prerequisite-install.XXXXXX)"
mkdir -p \
  "$temporary_runtime_directory/package-repository" \
  "$temporary_runtime_directory/package-manager-configuration" \
  "$temporary_runtime_directory/source-list-parts" \
  "$temporary_runtime_directory/package-lists/partial" \
  "$temporary_runtime_directory/package-cache/archives/partial" \
  "$temporary_runtime_directory/package-manager-log"
for package_archive_path in "${package_archive_paths[@]}"; do
  ln -s "$package_archive_path" \
    "$temporary_runtime_directory/package-repository/${package_archive_path##*/}"
done
(
  # APT requires a strong package hash before it will fetch from the temporary
  # catalog. This describes the local files; it does not perform transfer
  # verification or contact a network service.
  for package_archive_path in \
    "$temporary_runtime_directory/package-repository"/*.deb; do
    dpkg-deb -f "$package_archive_path"
    package_archive_sha256="$(sha256sum "$package_archive_path" | awk '{print $1}')"
    printf 'Filename: %s\nSize: %s\nSHA256: %s\n\n' \
      "${package_archive_path##*/}" \
      "$(stat -Lc '%s' "$package_archive_path")" \
      "$package_archive_sha256"
  done
) > "$temporary_runtime_directory/package-repository/Packages"
printf 'deb [trusted=yes] file:%s ./\n' \
  "$temporary_runtime_directory/package-repository" \
  > "$temporary_runtime_directory/sources.list"

local_package_manager_options=(
  -o 'Dir::Etc::main=/dev/null'
  -o "Dir::Etc::parts=$temporary_runtime_directory/package-manager-configuration"
  -o "Dir::Etc::sourcelist=$temporary_runtime_directory/sources.list"
  -o "Dir::Etc::sourceparts=$temporary_runtime_directory/source-list-parts"
  -o "Dir::State::lists=$temporary_runtime_directory/package-lists"
  -o "Dir::Cache=$temporary_runtime_directory/package-cache"
  -o "Dir::Log=$temporary_runtime_directory/package-manager-log"
  -o 'APT::Sandbox::User=root'
  -o 'Acquire::Languages=none'
)

printf '[CATALOG] action=load;source=file;network_sources=none\n'
apt-get "${local_package_manager_options[@]}" update >/dev/null \
  || fail_with_detail local_catalog_failed 'APT could not load the local package catalog.'
printf '[PLAN] action=simulate\n'
apt-get "${local_package_manager_options[@]}" --simulate --no-remove \
  --no-install-recommends install "${required_package_version_pins[@]}" \
  | tee "$temporary_runtime_directory/plan.txt" \
  || fail_with_detail dependency_plan_failed \
    'The seven packages do not resolve against Tech.'
grep -Eq '^Remv |DOWNGRADED|^Inst [^ ]+ \[[^]]+\]' \
  "$temporary_runtime_directory/plan.txt" \
  && fail_with_detail installed_package_change_planned \
    'The plan would change an installed Tech package.'
printf '[PLAN] state=pass;installed_package_changes=0\n'

if [[ "$execution_action" == plan ]]; then
  emit_script_result plan_pass
  exit 0
fi

[[ ! -e /usr/sbin/policy-rc.d ]] \
  || fail_with_detail existing_service_policy '/usr/sbin/policy-rc.d already exists.'
for service_unit_name in postgresql.service postgresql@16-main.service; do
  [[ "$(systemctl is-active "$service_unit_name" 2>/dev/null || true)" != active ]] \
    || fail_with_detail postgresql_already_active "$service_unit_name is active."
  [[ "$(systemctl is-enabled "$service_unit_name" 2>/dev/null || true)" != enabled ]] \
    || fail_with_detail postgresql_already_enabled "$service_unit_name is enabled."
done

printf '[PRIVILEGE] action=attended_sudo\n'
sudo -v || fail_with_detail sudo_failed 'Attended sudo validation failed.'
printf '#!/bin/sh\nexit 101\n' > "$temporary_runtime_directory/policy-rc.d"
sudo install -m 0755 "$temporary_runtime_directory/policy-rc.d" /usr/sbin/policy-rc.d
service_start_policy_installed=true
package_application_started=true

printf '[INSTALL] action=apply;source=file;network_sources=none\n'
sudo env DEBIAN_FRONTEND=noninteractive apt-get "${local_package_manager_options[@]}" \
  --yes --no-remove --no-install-recommends \
  install "${required_package_version_pins[@]}" \
  || fail_with_detail package_install_failed 'Local package installation failed.'
sudo rm -f -- /usr/sbin/policy-rc.d
service_start_policy_installed=false
sudo systemctl stop postgresql@16-main.service postgresql.service >/dev/null 2>&1 || true
sudo systemctl disable postgresql@16-main.service postgresql.service >/dev/null 2>&1 \
  || fail_with_detail postgresql_disable_failed 'Could not disable PostgreSQL boot units.'

[[ -z "$(dpkg --audit)" ]] \
  || fail_with_detail dpkg_state_unclean 'dpkg is incomplete after installation.'
for package_version_pin in "${required_package_version_pins[@]}"; do
  package_name="${package_version_pin%%=*}"
  expected_version="${package_version_pin#*=}"
  [[ "$(dpkg-query -W -f='${Version}' "$package_name")" == "$expected_version" ]] \
    || fail_with_detail installed_version_wrong "Installed version is wrong: $package_name"
done
python3 -c 'import psycopg; assert psycopg.__version__ == "3.3.2"' \
  || fail_with_detail psycopg_import_failed 'Psycopg 3.3.2 import failed.'
command -v pg_lsclusters >/dev/null \
  || fail_with_detail missing_installed_command \
    'postgresql-common did not install pg_lsclusters.'
postgresql_cluster_summary="$(
  pg_lsclusters --no-header \
    | awk '$1=="16" && $2=="main" {print $1,$2,$3,$4}'
)"
[[ "$postgresql_cluster_summary" == '16 main 5432 down' ]] \
  || fail_with_detail postgresql_cluster_wrong \
    "Expected '16 main 5432 down'; observed '${postgresql_cluster_summary:-missing}'."
for service_unit_name in postgresql.service postgresql@16-main.service; do
  [[ "$(systemctl is-active "$service_unit_name" 2>/dev/null || true)" != active ]] \
    || fail_with_detail postgresql_active_after_install "$service_unit_name is active."
  [[ "$(systemctl is-enabled "$service_unit_name" 2>/dev/null || true)" != enabled ]] \
    || fail_with_detail postgresql_enabled_after_install "$service_unit_name is enabled."
done
package_application_started=false
printf '[VALIDATION] state=pass;postgresql=16.15;pgvector=0.8.7;psycopg=3.3.2;boot=disabled\n'
emit_script_result pass
