#!/usr/bin/env bash
set -Eeuo pipefail

# Purpose:
#   Prove that the captured Ubuntu 26.04 AMD64 native-package shelf installs
#   and operates without downloading anything or contacting Tech.
#
# Mental model:
#   1. Verify the captured shelf and its checksums.
#   2. Select the already-local Ubuntu 26.04 AMD64 Docker image.
#   3. Write one small proof program into the shelf evidence directory.
#   4. Run that mounted program in a disposable `--network none` container.
#   5. Prove package health, exact pins, Psycopg, PostgreSQL 16, and pgvector.
#   6. Retain the log and a concise qualification receipt.
#
# Inputs or prerequisites:
#   - The shelf produced by capture-native-prerequisites.
#   - The ubuntu:26.04 image already present in the local Docker daemon.
#   - Docker access directly or through attended sudo.
#
# Outputs:
#   - A new qualification-<UTC timestamp>/ directory inside the shelf.
#   - No package installation on the work laptop and no Tech contact.
#
# Usage:
#   bash ./qualify-native-prerequisites
#   bash ./qualify-native-prerequisites --shelf /path/to/shelf

umask 077

PROGRAM_NAME="qualify-native-prerequisites"
SHELF_DIR="$PWD"
FORCE_SUDO_DOCKER=false
DOCKER_IMAGE="ubuntu:26.04"
RESULT_EMITTED=false

usage() {
  cat <<'USAGE'
Usage: qualify-native-prerequisites [--shelf DIRECTORY] [--sudo-docker]

Qualify a captured native-package shelf in a disposable, network-disabled
Ubuntu 26.04 AMD64 container. The script never pulls an image or queries a
network service.

Options:
  --shelf DIRECTORY  Captured shelf root. Default: current directory.
  --sudo-docker      Require attended sudo for Docker.
  --help             Show this help.
USAGE
}

emit_result() {
  local result_value="$1"
  if [[ "$RESULT_EMITTED" == false ]]; then
    printf '\nSCRIPT RESULT\n%s=%s\n' "$PROGRAM_NAME" "$result_value"
    RESULT_EMITTED=true
  fi
}

fail() {
  local failure_reason="$1"
  local failure_detail="$2"
  printf '\nFAILURE DETAIL\nreason=%s\ndetail=%s\n' \
    "$failure_reason" "$failure_detail" >&2
  emit_result "blocked;reason=${failure_reason}"
  exit 1
}

on_unexpected_error() {
  local failure_status=$?
  local failure_line="${BASH_LINENO[0]:-unknown}"
  trap - ERR
  printf '\nFAILURE DETAIL\nreason=unexpected_command_failure\nline=%s\nexit_status=%s\n' \
    "$failure_line" "$failure_status" >&2
  emit_result "blocked;reason=unexpected_command_failure"
  exit "$failure_status"
}
trap on_unexpected_error ERR

# Step 1 — Parse the bounded CLI and verify the immutable capture boundary.
while (($# > 0)); do
  case "$1" in
    --shelf)
      (($# >= 2)) || fail "invalid_arguments" "--shelf requires a directory."
      SHELF_DIR="$2"
      shift 2
      ;;
    --sudo-docker)
      FORCE_SUDO_DOCKER=true
      shift
      ;;
    --help)
      usage
      exit 0
      ;;
    *)
      fail "invalid_arguments" "Unsupported argument: $1"
      ;;
  esac
done

for required_command in \
  awk bash chmod date docker find grep mkdir readlink sha256sum sort sudo tail wc xargs; do
  command -v "$required_command" >/dev/null 2>&1 \
    || fail "missing_command" "Required command is unavailable: ${required_command}"
done

[[ -d "$SHELF_DIR" ]] || fail "shelf_missing" "Shelf directory does not exist: ${SHELF_DIR}"
SHELF_DIR="$(readlink -f "$SHELF_DIR")"

for required_path in \
  debs capture-summary.env deb-checksums.sha256 package-manifest.tsv \
  shelf-checksums.sha256 repository-metadata/postgresql-signing-key.fingerprint; do
  [[ -e "$SHELF_DIR/$required_path" ]] \
    || fail "shelf_path_missing" "Required shelf path is absent: ${required_path}"
done

grep -Fxq 'capture_status=downloaded_pending_offline_qualification' \
  "$SHELF_DIR/capture-summary.env" \
  || fail "capture_state_wrong" "Shelf is not pending offline qualification."
grep -Fxq 'target_release=resolute' "$SHELF_DIR/capture-summary.env" \
  || fail "target_release_wrong" "Shelf target release is not resolute."
grep -Fxq 'target_architecture=amd64' "$SHELF_DIR/capture-summary.env" \
  || fail "target_architecture_wrong" "Shelf target architecture is not amd64."
grep -Fxq 'postgresql_major=16' "$SHELF_DIR/capture-summary.env" \
  || fail "postgresql_major_wrong" "Shelf PostgreSQL major is not 16."
grep -Fxq 'B97B0AFCAA1A47F044F244A07FCC7D46ACCC4CF8' \
  "$SHELF_DIR/repository-metadata/postgresql-signing-key.fingerprint" \
  || fail "pgdg_key_identity_wrong" "Shelf PGDG signing-key identity is wrong."

printf '[SHELF] action=verify_origin_checksums\n'
(cd "$SHELF_DIR" && sha256sum --check --status deb-checksums.sha256) \
  || fail "deb_checksum_failure" "A captured package no longer matches its checksum."
(cd "$SHELF_DIR" && sha256sum --check --status shelf-checksums.sha256) \
  || fail "shelf_checksum_failure" "A captured shelf file no longer matches its checksum."

captured_package_count="$(find "$SHELF_DIR/debs" -maxdepth 1 -type f -name '*.deb' | wc -l | awk '{print $1}')"
recorded_package_count="$(awk -F= '$1 == "captured_package_count" {print $2}' "$SHELF_DIR/capture-summary.env")"
[[ "$captured_package_count" =~ ^[0-9]+$ && "$captured_package_count" == "$recorded_package_count" ]] \
  || fail "package_count_mismatch" "Captured and recorded package counts differ."
printf '[SHELF] state=pass;packages=%s\n' "$captured_package_count"

# Step 2 — Select the local Docker daemon and inspect only the local image.
DOCKER_COMMAND=(docker)
if [[ "$FORCE_SUDO_DOCKER" == true ]]; then
  printf '[DOCKER] mode=attended_sudo\n'
  sudo -v || fail "sudo_validation_failed" "Attended sudo validation failed."
  DOCKER_COMMAND=(sudo docker)
elif ! docker info >/dev/null 2>&1; then
  printf '[DOCKER] direct_access=unavailable;fallback=attended_sudo\n'
  sudo -v || fail "sudo_validation_failed" "Direct Docker failed and sudo validation failed."
  DOCKER_COMMAND=(sudo docker)
fi

"${DOCKER_COMMAND[@]}" info >/dev/null 2>&1 \
  || fail "docker_access_failed" "The selected Docker command cannot contact the local daemon."
"${DOCKER_COMMAND[@]}" image inspect "$DOCKER_IMAGE" >/dev/null 2>&1 \
  || fail "qualification_image_missing" "ubuntu:26.04 is not present in the local Docker daemon."

image_operating_system="$("${DOCKER_COMMAND[@]}" image inspect "$DOCKER_IMAGE" --format '{{.Os}}')"
image_architecture="$("${DOCKER_COMMAND[@]}" image inspect "$DOCKER_IMAGE" --format '{{.Architecture}}')"
image_identifier="$("${DOCKER_COMMAND[@]}" image inspect "$DOCKER_IMAGE" --format '{{.Id}}')"
[[ "$image_operating_system" == linux && "$image_architecture" == amd64 ]] \
  || fail "qualification_image_wrong" "Expected linux/amd64; observed ${image_operating_system}/${image_architecture}."
[[ "$image_identifier" == sha256:* ]] \
  || fail "qualification_image_identity_missing" "Docker returned no immutable image identity."
printf '[DOCKER] state=pass;image=ubuntu:26.04;platform=linux/amd64\n'

# Step 3 — Write the exact proof program that the container executes by path.
run_timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
qualification_name="qualification-${run_timestamp}"
qualification_dir="$SHELF_DIR/$qualification_name"
[[ ! -e "$qualification_dir" ]] \
  || fail "qualification_output_exists" "Qualification output already exists: ${qualification_name}"
mkdir -p "$qualification_dir"
chmod 0755 "$qualification_dir"

container_proof_path="$qualification_dir/container-proof.sh"
cat > "$container_proof_path" <<'CONTAINER_PROOF'
#!/usr/bin/env bash
set -Eeuo pipefail

# Mental model:
#   Install only the mounted package closure with repositories disabled, then
#   prove the frozen Python/PostgreSQL/pgvector identities and behavior.

export DEBIAN_FRONTEND=noninteractive

stop_postgresql() {
  if [[ -f /tmp/pgdata/postmaster.pid ]]; then
    su postgres -s /bin/sh -c \
      '/usr/lib/postgresql/16/bin/pg_ctl -D /tmp/pgdata -m fast -w stop' \
      >/dev/null 2>&1 || true
  fi
}
trap stop_postgresql EXIT

# Prevent package post-install hooks from starting services in the container.
printf '#!/bin/sh\nexit 101\n' > /usr/sbin/policy-rc.d
chmod 0755 /usr/sbin/policy-rc.d

# APT has no repository or package-list source. Every candidate is a mounted
# absolute .deb path from the captured shelf.
mkdir -p /tmp/empty-apt-sources /tmp/empty-apt-lists/partial
mapfile -d '' package_files < <(
  find /shelf/debs -maxdepth 1 -type f -name '*.deb' -print0 | sort -z
)
(( ${#package_files[@]} > 0 ))

offline_apt_options=(
  -o Dir::Etc::sourcelist=/dev/null
  -o Dir::Etc::sourceparts=/tmp/empty-apt-sources
  -o Dir::State::lists=/tmp/empty-apt-lists
  -o APT::Sandbox::User=root
)

printf '[INSTALL] action=simulate;packages=%s\n' "${#package_files[@]}"
apt-get "${offline_apt_options[@]}" --simulate --no-install-recommends install \
  "${package_files[@]}"
printf '[INSTALL] action=apply\n'
apt-get "${offline_apt_options[@]}" --yes --no-install-recommends install \
  "${package_files[@]}"

dpkg_audit_output="$(dpkg --audit)"
[[ -z "$dpkg_audit_output" ]] || {
  printf '%s\n' "$dpkg_audit_output" >&2
  exit 31
}
apt-get "${offline_apt_options[@]}" check

expected_packages=(
  'python3-psycopg=3.3.2-1build1'
  'postgresql-common=293.pgdg26.04+1'
  'postgresql-client-common=293.pgdg26.04+1'
  'libpq5=18.6-1.pgdg26.04+2'
  'postgresql-client-16=16.15-1.pgdg26.04+2'
  'postgresql-16=16.15-1.pgdg26.04+2'
  'postgresql-16-pgvector=0.8.7-1.pgdg26.04+1'
)
for expected_package in "${expected_packages[@]}"; do
  package_name="${expected_package%%=*}"
  expected_version="${expected_package#*=}"
  installed_version="$(dpkg-query -W -f='${Version}' "$package_name")"
  [[ "$installed_version" == "$expected_version" ]]
done
printf '[PACKAGES] exact_direct_versions=pass\n'

python3 - <<'PYTHON_PROOF'
import psycopg

assert psycopg.__version__ == "3.3.2", psycopg.__version__
print("[PSYCOPG] version=3.3.2;state=pass")
PYTHON_PROOF

# Use a private Unix socket and explicitly disable TCP listeners.
install -d -o postgres -g postgres -m 0700 /tmp/pgdata
install -d -o postgres -g postgres -m 0775 /tmp/pgsocket
su postgres -s /bin/sh -c \
  '/usr/lib/postgresql/16/bin/initdb -D /tmp/pgdata --no-locale --encoding=UTF8' \
  > /tmp/postgresql-initdb.txt
su postgres -s /bin/sh -c \
  "/usr/lib/postgresql/16/bin/pg_ctl -D /tmp/pgdata -o '-k /tmp/pgsocket -c listen_addresses= -p 55432' -w start" \
  > /tmp/postgresql-start.txt

cat > /tmp/pgvector-proof.sql <<'SQL_PROOF'
\set ON_ERROR_STOP on
CREATE EXTENSION vector;
SELECT extversion FROM pg_extension WHERE extname = 'vector';
SELECT current_setting('listen_addresses') = '';
CREATE TABLE vector_proof (id integer PRIMARY KEY, embedding vector(3));
INSERT INTO vector_proof VALUES (1, '[1,2,3]'), (2, '[3,2,1]');
SELECT id FROM vector_proof ORDER BY embedding <-> '[1,2,3]' LIMIT 1;
SQL_PROOF
su postgres -s /bin/sh -c \
  '/usr/lib/postgresql/16/bin/psql -X -h /tmp/pgsocket -p 55432 -d postgres -v ON_ERROR_STOP=1 -Atqf /tmp/pgvector-proof.sql' \
  > /tmp/pgvector-proof.txt

grep -Fxq '0.8.7' /tmp/pgvector-proof.txt
grep -Fxq 't' /tmp/pgvector-proof.txt
grep -Fxq '1' /tmp/pgvector-proof.txt
printf '[POSTGRESQL] major=16;pgvector=0.8.7;tcp=false;query=pass\n'
printf '[QUALIFICATION] state=pass;network_mode=none;apt_sources=empty\n'
CONTAINER_PROOF
chmod 0644 "$container_proof_path"
bash -n "$container_proof_path" \
  || fail "container_proof_syntax_failure" "Generated proof script failed syntax validation."

# Step 4 — Execute the mounted proof file. No stdin transport or network probe
# is involved, and Docker cannot pull because the immutable local image ID is
# used rather than a tag.
printf '[QUALIFICATION] action=offline_container_install;network_mode=none\n'
if ! "${DOCKER_COMMAND[@]}" run --rm \
  --network none \
  --platform linux/amd64 \
  --mount "type=bind,src=$SHELF_DIR,dst=/shelf,readonly" \
  "$image_identifier" \
  bash "/shelf/${qualification_name}/container-proof.sh" \
  > "$qualification_dir/container-proof.log" 2>&1; then
  tail -n 160 "$qualification_dir/container-proof.log" >&2 || true
  fail "offline_qualification_failed" "Disposable local-file-only qualification failed."
fi

grep -Fq '[QUALIFICATION] state=pass;network_mode=none;apt_sources=empty' \
  "$qualification_dir/container-proof.log" \
  || fail "qualification_result_missing" "Container proof emitted no success result."

# Step 5 — Publish a concise receipt without claiming the pending advisory and
# license reviews have passed.
cat > "$qualification_dir/qualification-summary.env" <<SUMMARY
qualification_status=offline_installation_and_operation_pass
target_release=resolute
target_architecture=amd64
captured_package_count=${captured_package_count}
psycopg_version=3.3.2
postgresql_major=16
pgvector_version=0.8.7
postgresql_tcp_listener=false
container_network_mode=none
apt_sources=empty
closure_advisory_review=pending
license_review=pending
tech_contact_performed=false
SUMMARY

cat > "$qualification_dir/qualification-environment.env" <<ENVIRONMENT
qualification_image_id=${image_identifier}
qualification_image_os=${image_operating_system}
qualification_image_architecture=${image_architecture}
ENVIRONMENT

(
  cd "$qualification_dir"
  find . -type f ! -name qualification-checksums.sha256 -print0 \
    | sort -z | xargs -0 sha256sum > qualification-checksums.sha256
)

printf '[QUALIFICATION] state=pass;report=%s\n' "$qualification_dir"
printf '[NEXT] closure_advisory_review=pending;license_review=pending\n'

trap - ERR
emit_result pass
