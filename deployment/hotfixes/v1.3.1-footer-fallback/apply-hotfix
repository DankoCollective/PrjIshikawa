#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

# Purpose:
#   Apply the bounded Ishikawa v1.3.1 document-footer fallback correction.
#
# Mental model:
#   Verify the exact accepted v1.3.1 footer recognizer, retain one rollback
#   copy, atomically publish the corrected recognizer, and run focused behavior
#   checks. No corpus, database, configuration, service, or credential changes.
#
# Usage:
#   bash ./apply-hotfix --apply
#   ISHIKAWA_ROOT=/alternate/path bash ./apply-hotfix --apply

readonly mode="${1:-}"
readonly bundle_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
readonly ishikawa_root="${ISHIKAWA_ROOT:-$HOME/Documents/Ishikawa}"
readonly relative_target='application/python/ishikawa/document_footer.py'
readonly target="$ishikawa_root/$relative_target"
readonly replacement="$bundle_root/payload/document_footer.py"
readonly verifier="$bundle_root/verify-hotfix.py"
readonly state_root="$ishikawa_root/state/hotfixes/v1.3.1-footer-fallback"
readonly backup="$state_root/document_footer.py.original"
readonly receipt="$state_root/receipt.txt"
readonly expected_original_sha256='113350e53490e6984f4f05289be6f5d2bfb463f172f064ba94eee96db8825c58'
readonly expected_replacement_sha256='58c7fd2ed773e8e68fa0d5c97e32928e2540f473312d0849e9304165c00a7119'

result() { printf '\nSCRIPT RESULT\nishikawa_v1_3_1_footer_fallback_hotfix=%s\n' "$1"; }

block() {
  printf '%s\n' 'FAILURE DETAIL' "reason=$1" "detail=$2" "operator_action=$3" >&2
  result blocked >&2
  exit 1
}

verify_installed() {
  PYTHONDONTWRITEBYTECODE=1 PYTHONPATH="$ishikawa_root/application/python" \
    python3 "$verifier" >/dev/null
}

[[ "$mode" == '--apply' ]] \
  || block supported_mode_required 'Use exactly --apply.' 'Rerun this command with --apply.'

for command_name in awk chmod date install mkdir mv python3 rm sha256sum; do
  command -v "$command_name" >/dev/null 2>&1 \
    || block required_command_missing "Required command is unavailable: $command_name." \
      'Restore the named command and rerun the hotfix.'
done

[[ -d "$ishikawa_root" && ! -L "$ishikawa_root" ]] \
  || block installation_root_unsafe 'The selected Ishikawa installation root is missing or unsafe.' \
    'Use the canonical regular installation directory.'
[[ -f "$target" && ! -L "$target" ]] \
  || block target_file_unsafe 'The installed footer recognizer is missing or unsafe.' \
    'Restore the accepted v1.3.1 installation before applying this hotfix.'
[[ -f "$replacement" && ! -L "$replacement" && -f "$verifier" && ! -L "$verifier" ]] \
  || block payload_file_unsafe 'The hotfix payload or verifier is missing or unsafe.' \
    'Re-extract the hotfix archive.'

replacement_sha256="$(sha256sum -- "$replacement" | awk '{print $1}')"
[[ "$replacement_sha256" == "$expected_replacement_sha256" ]] \
  || block payload_identity_mismatch 'The replacement checksum is not the accepted hotfix identity.' \
    'Discard this extraction and use the accepted hotfix archive.'

current_sha256="$(sha256sum -- "$target" | awk '{print $1}')"
if [[ "$current_sha256" == "$expected_replacement_sha256" ]]; then
  verify_installed \
    || block installed_self_test_failed 'The already-applied correction failed focused verification.' \
      'Preserve the installation and review its retained hotfix state.'
  printf '%s\n' '[HOTFIX] state=pass;change=already_applied;verification=pass'
  result pass
  exit 0
fi
[[ "$current_sha256" == "$expected_original_sha256" ]] \
  || block target_identity_mismatch 'The installed file is neither the accepted original nor this hotfix.' \
    'Do not overwrite it; reconcile the installed application identity first.'

mkdir -p -- "$state_root"
if [[ -e "$backup" || -L "$backup" ]]; then
  backup_sha256="$(sha256sum -- "$backup" 2>/dev/null | awk '{print $1}')"
  [[ -f "$backup" && ! -L "$backup" && "$backup_sha256" == "$expected_original_sha256" ]] \
    || block rollback_identity_mismatch 'The retained rollback file is not the accepted original.' \
      'Preserve the state directory and reconcile it before retrying.'
else
  install -m 0644 -- "$target" "$backup"
fi

temporary_target="$target.hotfix.$$"
cleanup() { rm -f -- "$temporary_target"; }
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
install -m 0644 -- "$replacement" "$temporary_target"
mv -f -- "$temporary_target" "$target"

if ! verify_installed; then
  install -m 0644 -- "$backup" "$temporary_target"
  mv -f -- "$temporary_target" "$target"
  block replacement_self_test_failed 'The correction failed verification and the original was restored.' \
    'Retain this terminal result and do not rerun ingestion.'
fi

installed_sha256="$(sha256sum -- "$target" | awk '{print $1}')"
[[ "$installed_sha256" == "$expected_replacement_sha256" ]] \
  || block publication_identity_mismatch 'The installed hotfix identity changed after publication.' \
    'Preserve the installation and review filesystem integrity.'

{
  printf 'hotfix=v1.3.1-footer-fallback\n'
  printf 'applied_utc=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  printf 'original_sha256=%s\n' "$expected_original_sha256"
  printf 'installed_sha256=%s\n' "$installed_sha256"
  printf 'verification=pass\n'
} >"$receipt"
chmod 0600 "$receipt"

printf '%s\n' '[HOTFIX] state=pass;change=applied;verification=pass' "receipt=$receipt"
result pass
