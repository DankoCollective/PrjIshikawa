#!/usr/bin/env bash
set -Eeuo pipefail

# Initialize one native PostgreSQL cluster with deterministic local-only
# settings. The cluster remains stopped and boot-disabled. Application
# databases, roles, schemas, extensions, and credentials are separate work.

umask 022
export SYSTEMD_PAGER=cat
export SYSTEMD_LESS=FRX
export NO_COLOR=1

emit() {
  printf '%s\n' "$1"
}

block() {
  emit "native_database_cluster_initialization=blocked;reason=$1"
  exit 1
}

unexpected_failure() {
  local status="$1" line="$2"
  trap - ERR
  set +e
  emit "native_database_cluster_initialization=blocked;reason=unexpected_failure;exit_code=$status;line=$line"
  exit "$status"
}
trap 'status=$?; unexpected_failure "$status" "$LINENO"' ERR

if (( $# != 2 )); then
  block invalid_argument_count
fi

expected_hostname="$1"
expected_os_version="$2"

[[ "$expected_hostname" =~ ^[A-Za-z0-9][A-Za-z0-9.-]*$ ]] \
  || block invalid_expected_hostname
[[ "$expected_os_version" =~ ^[0-9]{2}\.[0-9]{2}$ ]] \
  || block invalid_expected_os_version
(( EUID == 0 )) || block root_authority_required

for required in awk chmod chown df dpkg-query find getent grep hostname locale pg_conftool pg_createcluster pg_lsclusters runuser sed ss stat systemctl; do
  command -v "$required" >/dev/null 2>&1 || block "missing_command_$required"
done
[[ -x /usr/lib/postgresql/16/bin/pg_controldata ]] \
  || block pg_controldata_missing

actual_hostname="$(hostname -s)"
[[ "$actual_hostname" == "$expected_hostname" ]] || block hostname_mismatch

# shellcheck disable=SC1091
source /etc/os-release
[[ "${ID:-}" == ubuntu && "${VERSION_ID:-}" == "$expected_os_version" ]] \
  || block os_version_mismatch
architecture="$(dpkg --print-architecture)"
[[ "$architecture" == amd64 ]] || block architecture_mismatch

expected_packages=(
  'libjson-perl|4.10000-1|all'
  'libllvm19|1:19.1.1-1ubuntu1~24.04.2|amd64'
  'libpq5|16.15-0ubuntu0.24.04.1|amd64'
  'postgresql-16|16.15-1.pgdg24.04+2|amd64'
  'postgresql-16-pgvector|0.8.7-1.pgdg24.04+1|amd64'
  'postgresql-client-16|16.15-0ubuntu0.24.04.1|amd64'
  'postgresql-client-common|257build1.1|all'
  'postgresql-common|257build1.1|all'
  'python3-psycopg|3.1.17-2|all'
)
package_validation_count=0
for package_contract in "${expected_packages[@]}"; do
  IFS='|' read -r package_name expected_version expected_architecture \
    <<<"$package_contract"
  installed="$(dpkg-query -W -f='${db:Status-Abbrev}|${Version}|${Architecture}' "$package_name" 2>/dev/null || true)"
  IFS='|' read -r installed_status installed_version installed_architecture \
    <<<"$installed"
  [[ "$installed_status" == ii* && "$installed_version" == "$expected_version" \
      && "$installed_architecture" == "$expected_architecture" ]] \
    || block installed_package_contract_mismatch
  package_validation_count=$((package_validation_count + 1))
done
(( package_validation_count == 9 )) || block installed_package_count_mismatch

postgresql_version="$(/usr/lib/postgresql/16/bin/postgres --version | awk '{print $3}')"
psql_version="$(/usr/lib/postgresql/16/bin/psql --version | awk '{print $3}')"
psycopg_version="$(/usr/bin/python3 -c 'import psycopg; print(psycopg.__version__)')"
[[ "$postgresql_version" == 16.15 && "$psql_version" == 16.15 \
    && "$psycopg_version" == 3.1.17 ]] \
  || block installed_runtime_version_mismatch
[[ -f /usr/share/postgresql/16/extension/vector.control ]] \
  || block pgvector_extension_control_missing

cluster_policy="$(pg_conftool /etc/postgresql-common/createcluster.conf show -bs create_main_cluster 2>/dev/null || true)"
[[ "$cluster_policy" == off ]] || block automatic_cluster_policy_not_disabled
cluster_count_before="$(pg_lsclusters --no-header 2>/dev/null | awk 'NF {count++} END {print count+0}')"
(( cluster_count_before == 0 )) || block existing_database_cluster
[[ ! -e /etc/postgresql/16/main ]] || block existing_cluster_configuration
[[ ! -e /var/lib/postgresql/16/main ]] || block existing_cluster_data
if ss -H -ltn 'sport = :5432' 2>/dev/null | grep -q .; then
  block postgresql_port_in_use
fi
service_active_before="$(systemctl is-active postgresql.service 2>/dev/null || true)"
service_enabled_before="$(systemctl is-enabled postgresql.service 2>/dev/null || true)"
[[ "$service_active_before" != active ]] || block postgresql_service_active
[[ "$service_enabled_before" == disabled ]] || block postgresql_service_not_disabled

getent passwd postgres >/dev/null 2>&1 || block postgres_account_missing
getent group postgres >/dev/null 2>&1 || block postgres_group_missing
available_var_kib="$(df -Pk /var | awk 'NR == 2 {print $4}')"
[[ "$available_var_kib" =~ ^[0-9]+$ ]] || block invalid_var_capacity
(( available_var_kib >= 2097152 )) || block insufficient_var_capacity

if locale -a | grep -Fxiq 'C.UTF-8'; then
  cluster_locale='C.UTF-8'
elif locale -a | grep -Fxiq 'C.utf8'; then
  cluster_locale='C.utf8'
else
  block required_utf8_locale_missing
fi

emit 'purpose=initialize_native_database_cluster'
emit "host=$actual_hostname;os_version=$VERSION_ID;architecture=$architecture"
emit "postgresql_version=$postgresql_version;psql_version=$psql_version;pgvector_version=0.8.7;psycopg_version=$psycopg_version"
emit "validated_package_count=$package_validation_count;cluster_count_before=$cluster_count_before;postgresql_port_5432_before=free"
emit "automatic_cluster_creation=$cluster_policy;postgresql_service_active_before=$service_active_before;postgresql_service_enabled_before=$service_enabled_before"
emit 'authorized_actions=initialize_postgresql_16_main_cluster_enable_data_checksums_set_loopback_binding_set_manual_start_validate_stopped_cluster'
emit 'non_actions=no_network_access_no_package_change_no_database_start_no_application_database_role_schema_extension_or_secret_creation'

pg_createcluster \
  --user postgres \
  --start-conf manual \
  --locale "$cluster_locale" \
  --port 5432 \
  16 main -- \
  --encoding=UTF8 \
  --data-checksums \
  --auth-local=peer \
  --auth-host=scram-sha-256 \
  >/dev/null

pg_conftool 16 main set listen_addresses 127.0.0.1 >/dev/null
pg_conftool 16 main set password_encryption scram-sha-256 >/dev/null

# postgresql-common 257build1.1 treats dotted numeric strings as numbers when
# writing configuration. Canonicalize the single setting as a quoted string,
# then require the PostgreSQL server itself to parse the complete file.
postgresql_conf=/etc/postgresql/16/main/postgresql.conf
active_listen_line_count="$(awk '/^[[:space:]]*listen_addresses[[:space:]]*=/ {count++} END {print count+0}' "$postgresql_conf")"
(( active_listen_line_count == 1 )) || block unexpected_active_listen_address_line_count
sed -Ei "s|^([[:space:]]*listen_addresses[[:space:]]*=[[:space:]]*)127[.]0[.]0[.]1([[:space:]]*(#.*)?)$|\1'127.0.0.1'\2|" "$postgresql_conf"
chown postgres:postgres "$postgresql_conf"
chmod 644 "$postgresql_conf"
quoted_loopback_line_count="$(awk '/^[[:space:]]*listen_addresses[[:space:]]*=[[:space:]]*'\''127[.]0[.]0[.]1'\''([[:space:]]*#.*)?$/ {count++} END {print count+0}' "$postgresql_conf")"
(( quoted_loopback_line_count == 1 )) || block quoted_loopback_configuration_failed
configuration_probe="$(runuser -u postgres -- /usr/lib/postgresql/16/bin/postgres \
  -D /var/lib/postgresql/16/main \
  --config-file="$postgresql_conf" \
  -C data_directory 2>/dev/null || true)"
[[ "$configuration_probe" == /var/lib/postgresql/16/main ]] \
  || block postgresql_configuration_probe_failed
systemctl disable postgresql.service >/dev/null 2>&1 \
  || block postgresql_service_disable_failed

cluster_count_after="$(pg_lsclusters --no-header 2>/dev/null | awk 'NF {count++} END {print count+0}')"
(( cluster_count_after == 1 )) || block initialized_cluster_count_mismatch
cluster_line="$(pg_lsclusters --no-header 2>/dev/null)"
read -r cluster_version cluster_name cluster_port cluster_status cluster_owner cluster_data_directory cluster_log_file \
  <<<"$cluster_line"
[[ "$cluster_version" == 16 && "$cluster_name" == main && "$cluster_port" == 5432 \
    && "$cluster_status" == down && "$cluster_owner" == postgres \
    && "$cluster_data_directory" == /var/lib/postgresql/16/main \
    && "$cluster_log_file" == /var/log/postgresql/postgresql-16-main.log ]] \
  || block initialized_cluster_contract_mismatch

[[ "$(sed -n 's/^[[:space:]]*\([^#[:space:]][^#[:space:]]*\)[[:space:]]*$/\1/p' /etc/postgresql/16/main/start.conf)" == manual ]] \
  || block cluster_start_policy_mismatch
listen_addresses="$(pg_conftool 16 main show -s listen_addresses 2>/dev/null || true)"
password_encryption="$(pg_conftool 16 main show -s password_encryption 2>/dev/null || true)"
[[ "$listen_addresses" == 127.0.0.1 ]] || block listen_address_mismatch
[[ "$password_encryption" == scram-sha-256 ]] || block password_encryption_mismatch

hba_path=/etc/postgresql/16/main/pg_hba.conf
[[ -f "$hba_path" && ! -L "$hba_path" ]] || block pg_hba_missing_or_unsafe
awk '$1 == "local" && $2 == "all" && $3 == "all" && $4 == "peer" {found=1} END {exit found ? 0 : 1}' "$hba_path" \
  || block local_peer_authentication_missing
awk '$1 == "host" && $2 == "all" && $3 == "all" && $4 == "127.0.0.1/32" && $5 == "scram-sha-256" {found=1} END {exit found ? 0 : 1}' "$hba_path" \
  || block ipv4_scram_authentication_missing
awk '$1 == "host" && $2 == "all" && $3 == "all" && $4 == "::1/128" && $5 == "scram-sha-256" {found=1} END {exit found ? 0 : 1}' "$hba_path" \
  || block ipv6_scram_authentication_missing

control_data="$(/usr/lib/postgresql/16/bin/pg_controldata /var/lib/postgresql/16/main)"
checksum_version="$(awk -F: '/^Data page checksum version:/ {sub(/^[[:space:]]+/, "", $2); print $2}' <<<"$control_data")"
cluster_state="$(awk -F: '/^Database cluster state:/ {sub(/^[[:space:]]+/, "", $2); gsub(/[[:space:]]+/, "_", $2); print $2}' <<<"$control_data")"
[[ "$checksum_version" == 1 ]] || block data_checksums_not_enabled
[[ "$cluster_state" == shut_down ]] || block initialized_cluster_not_shut_down
data_directory_identity="$(stat -c '%U:%G|%a' /var/lib/postgresql/16/main)"
[[ "$data_directory_identity" == 'postgres:postgres|700' ]] \
  || block data_directory_identity_mismatch

if ss -H -ltn 'sport = :5432' 2>/dev/null | grep -q .; then
  block unexpected_postgresql_listener
fi
service_active_after="$(systemctl is-active postgresql.service 2>/dev/null || true)"
service_enabled_after="$(systemctl is-enabled postgresql.service 2>/dev/null || true)"
[[ "$service_active_after" != active ]] || block postgresql_service_unexpectedly_active
[[ "$service_enabled_after" == disabled ]] || block postgresql_service_unexpectedly_enabled

emit "cluster_version=$cluster_version;cluster_name=$cluster_name;cluster_port=$cluster_port;cluster_status=$cluster_status"
emit "cluster_owner=$cluster_owner;cluster_data_directory=$cluster_data_directory;cluster_log_file=$cluster_log_file"
emit "cluster_locale=$cluster_locale;cluster_encoding=UTF8;data_page_checksum_version=$checksum_version;database_cluster_state=$cluster_state"
emit "cluster_start_policy=manual;listen_addresses=$listen_addresses;password_encryption=$password_encryption"
emit 'listen_address_storage=quoted_ipv4_literal;configuration_probe=pass'
emit 'local_authentication=peer;host_authentication=scram-sha-256'
emit "data_directory_owner=postgres;data_directory_group=postgres;data_directory_mode=700"
emit "postgresql_clusters=$cluster_count_after;postgresql_port_5432=free;postgresql_service_active=$service_active_after;postgresql_service_enabled=$service_enabled_after"
emit 'application_database_created=false;application_role_created=false;application_schema_created=false;pgvector_extension_created=false;secret_created=false'
emit 'native_database_cluster_initialization=pass'
