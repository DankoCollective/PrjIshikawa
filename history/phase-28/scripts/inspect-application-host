#!/usr/bin/env bash
set -uo pipefail

# Read-only application-host inventory. The script emits bounded key/value
# records only. It performs no network access, package installation, service
# mutation, configuration change, or persistent write.

expected_hostname="${1:-}"
expected_os_version="${2:-24.04}"
failure_count=0
readiness_issue_count=0

emit() {
  printf '%s\n' "$1"
}

sanitize() {
  local value="${1:-unknown}"
  value="${value//$'\n'/_}"
  value="${value//$'\r'/_}"
  value="$(printf '%s' "$value" | tr -c 'A-Za-z0-9._:+@/~,-' '_')"
  [[ -n "$value" ]] || value=unknown
  printf '%s' "$value"
}

fail_inventory() {
  failure_count=$((failure_count + 1))
  emit "inventory_failure=$(sanitize "$1")"
}

flag_readiness() {
  readiness_issue_count=$((readiness_issue_count + 1))
  emit "readiness_issue=$(sanitize "$1")"
}

tool_state() {
  local name="$1"
  if command -v "$name" >/dev/null 2>&1; then
    emit "tool_${name}=present"
  else
    emit "tool_${name}=missing"
  fi
}

package_state() {
  local label="$1" package="$2" status=absent version=absent candidate=unknown
  if command -v dpkg-query >/dev/null 2>&1; then
    status="$(dpkg-query -W -f='${Status}' "$package" 2>/dev/null || true)"
    version="$(dpkg-query -W -f='${Version}' "$package" 2>/dev/null || true)"
    [[ "$status" == 'install ok installed' ]] || { status=absent; version=absent; }
  fi
  if command -v apt-cache >/dev/null 2>&1; then
    candidate="$(apt-cache policy "$package" 2>/dev/null | awk '/Candidate:/ {print $2; exit}' || true)"
    [[ -n "$candidate" ]] || candidate=unknown
  fi
  emit "package_${label}=$(sanitize "$status");installed_version=$(sanitize "$version");candidate_version=$(sanitize "$candidate")"
}

port_state() {
  local port="$1" state=false
  if command -v ss >/dev/null 2>&1 \
      && ss -H -ltn 2>/dev/null | awk -v suffix=":${port}" '$4 ~ suffix "$" {found=1} END {exit !found}'; then
    state=true
  fi
  emit "tcp_port_${port}_listening=$state"
}

image_state() {
  local label="$1" reference="$2" details
  if details="$("${docker_command[@]}" image inspect --format '{{.Architecture}}|{{.Os}}|{{.Id}}' "$reference" 2>/dev/null)"; then
    local architecture os image_id
    IFS='|' read -r architecture os image_id <<<"$details"
    emit "image_${label}=present;reference=$(sanitize "$reference");architecture=$(sanitize "$architecture");os=$(sanitize "$os");image_id=$(sanitize "$image_id")"
  else
    emit "image_${label}=absent;reference=$(sanitize "$reference")"
  fi
}

emit 'schema=application-host-inventory/v1'
emit 'persistent_mutation=false'
emit 'network_access=false'
emit 'sudo_prompted=false'
emit 'content_or_secret_capture=false'

if [[ ! "$expected_hostname" =~ ^[A-Za-z0-9][A-Za-z0-9.-]*$ ]]; then
  fail_inventory invalid_expected_hostname
fi
if [[ ! "$expected_os_version" =~ ^[0-9]{2}(\.[0-9]{2})?$ ]]; then
  fail_inventory invalid_expected_os_version
fi

observed_hostname="$(hostname -s 2>/dev/null || true)"
if [[ "$observed_hostname" == "$expected_hostname" ]]; then
  emit 'hostname_match=true'
else
  emit 'hostname_match=false'
  fail_inventory hostname_mismatch
fi

os_id=unknown
os_version=unknown
os_pretty=unknown
if [[ -r /etc/os-release ]]; then
  # shellcheck disable=SC1091
  . /etc/os-release
  os_id="${ID:-unknown}"
  os_version="${VERSION_ID:-unknown}"
  os_pretty="${PRETTY_NAME:-unknown}"
fi
machine="$(uname -m 2>/dev/null || true)"
dpkg_arch="$(dpkg --print-architecture 2>/dev/null || true)"
kernel="$(uname -r 2>/dev/null || true)"
emit "os_id=$(sanitize "$os_id")"
emit "os_version=$(sanitize "$os_version")"
emit "expected_os_version=$(sanitize "$expected_os_version")"
emit "os_pretty=$(sanitize "$os_pretty")"
emit "kernel=$(sanitize "$kernel")"
emit "machine=$(sanitize "$machine")"
emit "dpkg_architecture=$(sanitize "$dpkg_arch")"

if [[ "$os_id" != ubuntu \
    || !( "$os_version" == "$expected_os_version" \
      || "$os_version" == "$expected_os_version".* ) ]]; then
  flag_readiness unsupported_os
fi
[[ "$machine" == x86_64 && "$dpkg_arch" == amd64 ]] || flag_readiness unsupported_architecture

for tool in apt-cache awk bash df docker dpkg dpkg-query hostname python3 sha256sum ss tar uname; do
  tool_state "$tool"
done

cpu_count="$(nproc 2>/dev/null || printf unknown)"
mem_total_kib="$(awk '/^MemTotal:/ {print $2; exit}' /proc/meminfo 2>/dev/null || true)"
home_available_kib="$(df -Pk "$HOME" 2>/dev/null | awk 'NR == 2 {print $4}' || true)"
emit "cpu_count=$(sanitize "$cpu_count")"
emit "mem_total_kib=$(sanitize "${mem_total_kib:-unknown}")"
emit "home_filesystem_available_kib=$(sanitize "${home_available_kib:-unknown}")"

python_version=missing
venv_available=false
pip_available=false
if command -v python3 >/dev/null 2>&1; then
  python_version="$(python3 -V 2>&1 || true)"
  python3 -m venv --help >/dev/null 2>&1 && venv_available=true
  python3 -m pip --version >/dev/null 2>&1 && pip_available=true
fi
emit "python_version=$(sanitize "${python_version:-missing}")"
emit "python_venv_available=$venv_available"
emit "python_pip_available=$pip_available"

poppler_pdftotext_version=missing
poppler_pdfinfo_version=missing
psql_version=missing
if command -v pdftotext >/dev/null 2>&1; then
  poppler_pdftotext_version="$(pdftotext -v 2>&1 | sed -n '1p' || true)"
fi
if command -v pdfinfo >/dev/null 2>&1; then
  poppler_pdfinfo_version="$(pdfinfo -v 2>&1 | sed -n '1p' || true)"
fi
if command -v psql >/dev/null 2>&1; then
  psql_version="$(psql --version 2>/dev/null || true)"
fi
emit "pdftotext_version=$(sanitize "${poppler_pdftotext_version:-missing}")"
emit "pdfinfo_version=$(sanitize "${poppler_pdfinfo_version:-missing}")"
emit "psql_version=$(sanitize "${psql_version:-missing}")"

package_state ca_certificates ca-certificates
package_state curl curl
package_state docker_ce docker-ce
package_state docker_ce_cli docker-ce-cli
package_state containerd containerd.io
package_state docker_buildx docker-buildx-plugin
package_state docker_compose docker-compose-plugin
package_state python3 python3
package_state python3_venv python3-venv
package_state python3_pip python3-pip
package_state python3_yaml python3-yaml
package_state python3_psycopg2 python3-psycopg2
package_state poppler_utils poppler-utils
package_state postgresql_client postgresql-client
package_state postgresql_common postgresql-common

docker_command=(docker)
docker_access=unavailable
if command -v docker >/dev/null 2>&1 && docker version >/dev/null 2>&1; then
  docker_access=user
elif command -v sudo >/dev/null 2>&1 && sudo -n docker version >/dev/null 2>&1; then
  docker_command=(sudo -n docker)
  docker_access=sudo_noninteractive
fi
emit "docker_access=$docker_access"

if [[ "$docker_access" == unavailable ]]; then
  docker_client_version=missing
  if command -v docker >/dev/null 2>&1; then
    docker_client_version="$(docker --version 2>/dev/null || true)"
  fi
  emit "docker_client_version=$(sanitize "${docker_client_version:-missing}")"
  emit 'docker_server_version=unavailable'
  emit 'docker_compose_version=unavailable'
  emit 'docker_buildx_version=unavailable'
  flag_readiness docker_daemon_access_unavailable
else
  docker_client_version="$("${docker_command[@]}" version --format '{{.Client.Version}}' 2>/dev/null || true)"
  docker_server_version="$("${docker_command[@]}" version --format '{{.Server.Version}}' 2>/dev/null || true)"
  docker_compose_version="$("${docker_command[@]}" compose version --short 2>/dev/null || true)"
  docker_buildx_version="$("${docker_command[@]}" buildx version 2>/dev/null | awk '{print $2; exit}' || true)"
  docker_arch="$("${docker_command[@]}" info --format '{{.Architecture}}' 2>/dev/null || true)"
  emit "docker_client_version=$(sanitize "${docker_client_version:-unknown}")"
  emit "docker_server_version=$(sanitize "${docker_server_version:-unknown}")"
  emit "docker_compose_version=$(sanitize "${docker_compose_version:-missing}")"
  emit "docker_buildx_version=$(sanitize "${docker_buildx_version:-missing}")"
  emit "docker_architecture=$(sanitize "${docker_arch:-unknown}")"
  [[ "$docker_arch" == x86_64 || "$docker_arch" == amd64 ]] || flag_readiness docker_architecture_mismatch
  [[ -n "$docker_compose_version" ]] || flag_readiness docker_compose_plugin_unavailable

  image_state node_next_amd64 node-24-slim-nextjs-16-4-1:amd64
  image_state node_next_latest node-24-slim-nextjs-16-4-1:latest
  image_state python_3_12_slim python:3.12-slim
  image_state python_3_13_slim python:3.13-slim
  image_state pgvector_pg16 pgvector/pgvector:pg16
  image_state pgvector_pg17 pgvector/pgvector:pg17
  image_state pgvector_pg18 pgvector/pgvector:pg18
fi

port_state 3000
port_state 1384
port_state 5432

emit "failure_count=$failure_count"
emit "readiness_issue_count=$readiness_issue_count"
if (( failure_count == 0 )); then
  emit 'application_host_inventory=pass'
  if (( readiness_issue_count == 0 )); then
    emit 'implementation_readiness=ready_for_source_scaffold'
  else
    emit 'implementation_readiness=review_inventory_issues'
  fi
  exit 0
fi
emit 'application_host_inventory=blocked'
emit 'implementation_readiness=blocked'
exit 1
