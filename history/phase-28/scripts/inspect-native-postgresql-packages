#!/usr/bin/env bash
set -uo pipefail

# Read-only native PostgreSQL package inventory. Emits bounded key/value
# records only. Performs no network access, apt update, package download,
# install, database initialization, service mutation, configuration change,
# secret read, content read, or persistent write.

expected_hostname="${1:-}"
expected_os_version="${2:-24.04}"
failure_count=0
readiness_issue_count=0

emit() {
  printf '%s\n' "$1"
}

sanitize() {
  local value="${1:-unknown}"
  value="${value//$'\n'/_}"
  value="${value//$'\r'/_}"
  value="$(printf '%s' "$value" | tr -c 'A-Za-z0-9._:+@/~,-' '_')"
  [[ -n "$value" ]] || value=unknown
  printf '%s' "$value"
}

fail_inventory() {
  failure_count=$((failure_count + 1))
  emit "inventory_failure=$(sanitize "$1")"
}

flag_readiness() {
  readiness_issue_count=$((readiness_issue_count + 1))
  emit "readiness_issue=$(sanitize "$1")"
}

candidate_for() {
  local package="$1" candidate
  candidate="$(apt-cache policy "$package" 2>/dev/null | awk '/Candidate:/ {print $2; exit}' || true)"
  if [[ -z "$candidate" || "$candidate" == '(none)' ]]; then
    printf 'absent'
  else
    printf '%s' "$candidate"
  fi
}

installed_version_for() {
  local package="$1" status version
  status="$(dpkg-query -W -f='${Status}' "$package" 2>/dev/null || true)"
  if [[ "$status" == 'install ok installed' ]]; then
    version="$(dpkg-query -W -f='${Version}' "$package" 2>/dev/null || true)"
    printf '%s' "${version:-unknown}"
  else
    printf 'absent'
  fi
}

candidate_field() {
  local package="$1" candidate="$2" field="$3"
  if [[ "$candidate" == absent ]]; then
    printf 'absent'
    return
  fi
  apt-cache show "${package}=${candidate}" 2>/dev/null \
    | awk -F': ' -v wanted="$field" '$1 == wanted {print substr($0, length($1) + 3); exit}'
}

package_record() {
  local label="$1" package="$2" candidate installed architecture source filename size sha256
  candidate="$(candidate_for "$package")"
  installed="$(installed_version_for "$package")"
  architecture="$(candidate_field "$package" "$candidate" Architecture)"
  source="$(candidate_field "$package" "$candidate" Source)"
  filename="$(candidate_field "$package" "$candidate" Filename)"
  size="$(candidate_field "$package" "$candidate" Size)"
  sha256="$(candidate_field "$package" "$candidate" SHA256)"
  [[ -n "$architecture" ]] || architecture=unknown
  [[ -n "$source" ]] || source="$package"
  [[ -n "$filename" ]] || filename=unknown
  [[ -n "$size" ]] || size=unknown
  [[ -n "$sha256" ]] || sha256=unknown
  emit "package_${label}=observed;name=$(sanitize "$package");installed_version=$(sanitize "$installed");candidate_version=$(sanitize "$candidate");architecture=$(sanitize "$architecture");source=$(sanitize "$source");filename=$(sanitize "$filename");size=$(sanitize "$size");sha256=$(sanitize "$sha256")"
}

port_state() {
  local port="$1" state=false
  if ss -H -ltn 2>/dev/null \
      | awk -v suffix=":${port}" '$4 ~ suffix "$" {found=1} END {exit !found}'; then
    state=true
  fi
  emit "tcp_port_${port}_listening=$state"
}

emit 'schema=native-postgresql-package-inventory/v1'
emit 'persistent_mutation=false'
emit 'network_access=false'
emit 'apt_metadata_update=false'
emit 'package_download=false'
emit 'package_install=false'
emit 'database_initialization=false'
emit 'service_mutation=false'
emit 'configuration_mutation=false'
emit 'content_or_secret_capture=false'

if [[ ! "$expected_hostname" =~ ^[A-Za-z0-9][A-Za-z0-9.-]*$ ]]; then
  fail_inventory invalid_expected_hostname
fi
if [[ ! "$expected_os_version" =~ ^[0-9]{2}(\.[0-9]{2})?$ ]]; then
  fail_inventory invalid_expected_os_version
fi

for required in apt-cache awk bash date df dpkg dpkg-query find head hostname sed sort ss systemctl tail tr uname wc; do
  command -v "$required" >/dev/null 2>&1 || fail_inventory "missing_tool_${required}"
done

observed_hostname="$(hostname -s 2>/dev/null || true)"
if [[ "$observed_hostname" == "$expected_hostname" ]]; then
  emit 'hostname_match=true'
else
  emit 'hostname_match=false'
  fail_inventory hostname_mismatch
fi

os_id=unknown
os_version=unknown
os_pretty=unknown
if [[ -r /etc/os-release ]]; then
  # shellcheck disable=SC1091
  . /etc/os-release
  os_id="${ID:-unknown}"
  os_version="${VERSION_ID:-unknown}"
  os_pretty="${PRETTY_NAME:-unknown}"
fi
machine="$(uname -m 2>/dev/null || true)"
dpkg_arch="$(dpkg --print-architecture 2>/dev/null || true)"
emit "os_id=$(sanitize "$os_id")"
emit "os_version=$(sanitize "$os_version")"
emit "expected_os_version=$(sanitize "$expected_os_version")"
emit "os_pretty=$(sanitize "$os_pretty")"
emit "machine=$(sanitize "$machine")"
emit "dpkg_architecture=$(sanitize "$dpkg_arch")"

if [[ "$os_id" != ubuntu \
    || !( "$os_version" == "$expected_os_version" \
      || "$os_version" == "$expected_os_version".* ) ]]; then
  flag_readiness unsupported_os
fi
[[ "$machine" == x86_64 && "$dpkg_arch" == amd64 ]] \
  || flag_readiness unsupported_architecture

apt_lists_newest_epoch="$(find /var/lib/apt/lists -maxdepth 1 -type f -printf '%T@\n' 2>/dev/null \
  | sort -n | tail -n 1 | sed 's/\..*$//' || true)"
emit "apt_lists_newest_epoch=$(sanitize "${apt_lists_newest_epoch:-unknown}")"
var_available_kib="$(df -Pk /var 2>/dev/null | awk 'NR == 2 {print $4}' || true)"
emit "var_filesystem_available_kib=$(sanitize "${var_available_kib:-unknown}")"

package_record postgresql_meta postgresql
package_record postgresql_client_meta postgresql-client
package_record postgresql_contrib_meta postgresql-contrib
package_record postgresql_common postgresql-common
package_record postgresql_client_common postgresql-client-common
package_record libpq5 libpq5
package_record python3_psycopg2 python3-psycopg2
package_record python3_psycopg python3-psycopg

for major in 16 17 18; do
  package_record "postgresql_${major}" "postgresql-${major}"
  package_record "postgresql_client_${major}" "postgresql-client-${major}"
  package_record "postgresql_contrib_${major}" "postgresql-contrib-${major}"
  package_record "postgresql_server_dev_${major}" "postgresql-server-dev-${major}"
  package_record "postgresql_pgvector_${major}" "postgresql-${major}-pgvector"
done

default_major="$(apt-cache show --no-all-versions postgresql 2>/dev/null \
  | sed -nE 's/^Depends:.*postgresql-([0-9]+).*/\1/p' | head -n 1 || true)"
emit "default_postgresql_major=$(sanitize "${default_major:-unknown}")"

if [[ -z "$default_major" ]]; then
  flag_readiness default_postgresql_major_unresolved
  pgvector_package=unknown
  pgvector_candidate=absent
else
  pgvector_package="postgresql-${default_major}-pgvector"
  pgvector_candidate="$(candidate_for "$pgvector_package")"
  if [[ "$pgvector_candidate" == absent ]]; then
    flag_readiness matching_pgvector_package_unavailable
  fi
fi
emit "matching_pgvector_package=$(sanitize "$pgvector_package");candidate_version=$(sanitize "$pgvector_candidate")"

postgresql_active="$(systemctl is-active postgresql.service 2>/dev/null || true)"
postgresql_enabled="$(systemctl is-enabled postgresql.service 2>/dev/null || true)"
emit "postgresql_service_active=$(sanitize "${postgresql_active:-absent}")"
emit "postgresql_service_enabled=$(sanitize "${postgresql_enabled:-absent}")"
port_state 5432

cluster_count=0
if command -v pg_lsclusters >/dev/null 2>&1; then
  cluster_count="$(pg_lsclusters --no-header 2>/dev/null | wc -l | tr -d ' ' || true)"
fi
emit "postgresql_cluster_count=$(sanitize "${cluster_count:-0}")"

vector_control_count="$(find /usr/share/postgresql -type f -path '*/extension/vector.control' 2>/dev/null \
  | wc -l | tr -d ' ' || true)"
emit "vector_extension_control_count=$(sanitize "${vector_control_count:-0}")"

if [[ "$(installed_version_for postgresql)" != absent \
    || "${cluster_count:-0}" != 0 \
    || "$postgresql_active" == active \
    || "${vector_control_count:-0}" != 0 ]]; then
  flag_readiness existing_postgresql_state_requires_review
fi

[[ "$(candidate_for postgresql)" != absent ]] \
  || flag_readiness postgresql_candidate_unavailable

emit "failure_count=$failure_count"
emit "readiness_issue_count=$readiness_issue_count"
if (( failure_count == 0 )); then
  emit 'native_postgresql_package_inventory=pass'
  if (( readiness_issue_count == 0 )); then
    emit 'capture_readiness=ready_for_package_root_review'
  else
    emit 'capture_readiness=review_inventory_issues'
  fi
  exit 0
fi
emit 'native_postgresql_package_inventory=blocked'
emit 'capture_readiness=blocked'
exit 1
