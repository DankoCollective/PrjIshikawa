#!/usr/bin/env bash
set -Eeuo pipefail

# Purpose:
#   Install and qualify one checksum-bound Ishikawa application candidate on
#   its intended Ubuntu AMD64 host without changing the active installation.
#
# Mental model:
#   Verify the host and archive, inspect the closed final-state package,
#   install or exactly reuse one sibling candidate directory, and validate its
#   application, configuration, command, web, and service-definition shape.
#
# Inputs or prerequisites:
#   Expected host identity, package archive and digest, Python 3.12 with the
#   native runtime modules, and an absent or byte-identical candidate path.
#
# Outputs:
#   A persistent ~/Documents/Ishikawa-v1-candidate directory and one bounded
#   content-free result. The active Ishikawa directory remains unchanged.
#
# Usage:
#   install-and-qualify-ishikawa-candidate HOST 24.04 ARCHIVE SHA256 RESULT

usage() {
  printf '%s\n' \
    'Usage: install-and-qualify-ishikawa-candidate EXPECTED-HOSTNAME EXPECTED-OS-VERSION ARCHIVE SHA256 RESULT'
}

fail() {
  local reason="$1"
  if [[ -n "${result_path:-}" && -n "${working_root:-}" && "$result_path" == "$working_root"/* ]]; then
    printf 'ishikawa_candidate_install_qualification=blocked;reason=%s\n' "$reason" >>"$result_path" 2>/dev/null || true
  fi
  exit 1
}

[[ "${1:-}" != '--help' && "${1:-}" != '-h' ]] || { usage; exit 0; }
(( $# == 5 )) || { usage >&2; exit 2; }

readonly expected_hostname="$1"
readonly expected_os_version="$2"
readonly archive_path="$3"
readonly expected_archive_sha256="$4"
result_path="$5"
readonly working_root="$(pwd -P)"
readonly install_root="$HOME/Documents/Ishikawa-v1-candidate"

[[ "$expected_hostname" =~ ^[A-Za-z0-9][A-Za-z0-9.-]*$ ]] || fail 'expected_hostname_invalid'
[[ "$expected_os_version" =~ ^[0-9]{2}\.[0-9]{2}$ ]] || fail 'expected_os_version_invalid'
[[ "$archive_path" == "$working_root"/* && -f "$archive_path" && ! -L "$archive_path" ]] || fail 'archive_path_invalid'
[[ "$result_path" == "$working_root"/* && ! -e "$result_path" && ! -L "$result_path" ]] || fail 'result_path_invalid'
[[ "$expected_archive_sha256" =~ ^[0-9a-f]{64}$ ]] || fail 'archive_digest_invalid'

for required in awk bash cmp dpkg find grep hostname mktemp pdfinfo pdffonts pdftoppm pdftotext psql python3 rm sha256sum sort tar uname; do
  command -v "$required" >/dev/null 2>&1 || fail 'required_command_missing'
done
python3 -B -c 'import sys,yaml,psycopg; raise SystemExit(0 if sys.version_info >= (3, 12) else 1)' || \
  fail 'python_runtime_dependency_missing'

source /etc/os-release
[[ "${ID:-}" == ubuntu && "${VERSION_ID:-}" == "$expected_os_version" ]] || fail 'operating_system_mismatch'
actual_hostname="$(hostname -s)"
[[ "$actual_hostname" == "$expected_hostname" ]] || fail 'hostname_mismatch'
[[ "$(dpkg --print-architecture)" == amd64 && "$(uname -m)" == x86_64 ]] || fail 'architecture_mismatch'

actual_archive_sha256="$(sha256sum "$archive_path" | awk '{print $1}')"
[[ "$actual_archive_sha256" == "$expected_archive_sha256" ]] || fail 'archive_checksum_mismatch'

extract_root="$(mktemp -d "$working_root/extracted.XXXXXX")"
cleanup() {
  local status="$?"
  trap - EXIT INT TERM
  if [[ "$extract_root" == "$working_root"/extracted.* && -d "$extract_root" ]]; then
    rm -rf -- "$extract_root"
  fi
  exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

tar -xzf "$archive_path" -C "$extract_root" || fail 'archive_extraction_failed'
readonly bundle_root="$extract_root/ishikawa-application-package"
[[ -d "$bundle_root" && ! -L "$bundle_root" ]] || fail 'bundle_root_invalid'
(cd -- "$bundle_root" && sha256sum --check --strict SHA256SUMS >/dev/null) || fail 'package_checksum_failed'

bundle_file_count="$(find "$bundle_root" -type f | awk 'END {print NR}')"
payload_file_count="$(find "$bundle_root/payload" -type f | awk 'END {print NR}')"
[[ "$bundle_file_count" == 97 && "$payload_file_count" == 94 ]] || fail 'package_file_inventory_invalid'
if find "$bundle_root" -type l -print -quit | grep -q .; then fail 'package_symlink_found'; fi
if find "$bundle_root" \( -type f -o -type d \) \
  \( -iname '*migration*' -o -iname '*mutation*' -o -iname '*repair*' -o -iname '*patch*' \) \
  -print -quit | grep -q .; then
  fail 'historical_mutation_material_packaged'
fi

installation_action='installed_new'
if [[ -e "$install_root" || -L "$install_root" ]]; then
  [[ -d "$install_root" && ! -L "$install_root" ]] || fail 'existing_candidate_unsafe'
  if ! cmp -s \
    <(cd "$bundle_root/payload" && find . -type f -print | sort | while IFS= read -r name; do sha256sum "$name"; done) \
    <(cd "$install_root" && find . -type f -print | sort | while IFS= read -r name; do sha256sum "$name"; done); then
    fail 'existing_candidate_identity_conflict'
  fi
  installation_action='reused_exact'
else
  install_result="$working_root/install-result.txt"
  [[ ! -e "$install_result" && ! -L "$install_result" ]] || fail 'install_result_path_invalid'
  bash "$bundle_root/install-ishikawa" --install-root "$install_root" >"$install_result" || fail 'installer_failed'
  grep -Fq 'ishikawa_install=pass;' "$install_result" || fail 'installer_pass_marker_absent'
fi

installed_file_count="$(find "$install_root" -type f | awk 'END {print NR}')"
installed_python_modules="$(find "$install_root/application/python/ishikawa" -maxdepth 1 -type f -name '*.py' | awk 'END {print NR}')"
installed_web_files="$(find "$install_root/application/web" -type f | awk 'END {print NR}')"
installed_config_files="$(find "$install_root/config" -type f | awk 'END {print NR}')"
installed_command_files="$(find "$install_root/scripts" -maxdepth 1 -type f | awk 'END {print NR}')"
installed_documentation_files="$(find "$install_root/docs" -maxdepth 1 -type f | awk 'END {print NR}')"
installed_unit_files="$(find "$install_root/systemd" -maxdepth 1 -type f | awk 'END {print NR}')"
installed_sql_files="$(find "$install_root" -type f -name '*.sql' | awk 'END {print NR}')"
historical_mutation_files="$(find "$install_root" \( -type f -o -type d \) \
  \( -iname '*migration*' -o -iname '*mutation*' -o -iname '*repair*' -o -iname '*patch*' \) | awk 'END {print NR}')"
[[ "$installed_file_count" == 94 \
  && "$installed_python_modules" == 47 \
  && "$installed_web_files" == 11 \
  && "$installed_config_files" == 19 \
  && "$installed_command_files" == 10 \
  && "$installed_documentation_files" == 4 \
  && "$installed_unit_files" == 3 \
  && "$installed_sql_files" == 0 \
  && "$historical_mutation_files" == 0 ]] || fail 'installed_final_state_contract_failed'

validation_result="$working_root/installed-validation.txt"
PYTHONDONTWRITEBYTECODE=1 PYTHONPATH="$install_root/application/python" python3 -B - "$install_root" >"$validation_result" <<'PY' || \
  fail 'installed_application_validation_failed'
import json
from pathlib import Path
import sys

from ishikawa.installed_ingestion import InstalledIngestionLayout
from ishikawa.validators import validate_class_registry, validate_document_catalog
from ishikawa.yaml_loader import load_restricted_yaml

root = Path(sys.argv[1]).resolve(strict=True)
InstalledIngestionLayout.from_product_root(root)
classes = validate_class_registry(
    load_restricted_yaml(root / "config/document_classes.yaml", label="document class registry")
)
catalog = validate_document_catalog(
    load_restricted_yaml(root / "config/document_catalog.yaml", label="document catalog")
)
product = load_restricted_yaml(root / "config/product.yaml", label="product profile")
web_package = json.loads((root / "application/web/package.json").read_text(encoding="utf-8"))
if product != {"schema_version": 1, "display_name": "Ishikawa"}:
    raise SystemExit(1)
if web_package.get("dependencies") != {
    "next": "16.4.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
}:
    raise SystemExit(1)
print(f"document_classes={len(classes.classes)};catalog_documents={len(catalog.documents)}")
PY

grep -Fxq 'document_classes=3;catalog_documents=0' "$validation_result" || fail 'installed_configuration_contract_failed'
PYTHONDONTWRITEBYTECODE=1 "$install_root/scripts/ishikawa-ingest" --help >/dev/null || fail 'ingestion_help_failed'
PYTHONDONTWRITEBYTECODE=1 "$install_root/scripts/ishikawa-retrieval-api" --check-config >/dev/null || fail 'retrieval_config_failed'
PYTHONDONTWRITEBYTECODE=1 "$install_root/scripts/ishikawa-observability-retention" --check-config >/dev/null || fail 'retention_config_failed'
"$install_root/scripts/ishikawa-stack" --help >/dev/null || fail 'stack_help_failed'

{
  printf 'target_hostname=%s;os_id=ubuntu;os_version=%s;architecture=amd64\n' "$actual_hostname" "$expected_os_version"
  printf 'archive_sha256=%s;package_checksums=pass;bundle_files=97;payload_files=94\n' "$actual_archive_sha256"
  printf 'installation_action=%s;install_root=HOME/Documents/Ishikawa-v1-candidate;active_installation_overwritten=false\n' "$installation_action"
  printf 'installed_files=94;python_modules=47;web_files=11;config_files=19;command_files=10;documentation_files=4;unit_files=3\n'
  printf 'installed_sql_files=0;historical_mutation_files=0\n'
  printf 'product_display_name=Ishikawa;document_classes=3;catalog_documents=0;next_version=16.4.1\n'
  printf 'native_runtime_dependencies=pass;python_minimum=3.12;installed_configuration=pass\n'
  printf 'database_changed=false;service_changed=false;model_contact=false;credential_read=false;source_documents_copied=false\n'
  printf 'ishikawa_candidate_install_qualification=pass\n'
} >"$result_path"
