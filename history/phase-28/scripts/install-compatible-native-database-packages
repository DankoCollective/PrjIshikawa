#!/usr/bin/env bash
set -Eeuo pipefail

# Install one checksum-bound native database package bundle without using a
# package network. The package runtime is installed, but no database cluster is
# initialized and no database service is left running or enabled at boot.

umask 022
export DEBIAN_FRONTEND=noninteractive
export SYSTEMD_PAGER=cat
export SYSTEMD_LESS=FRX
export NO_COLOR=1

emit() {
  printf '%s\n' "$1"
}

block() {
  emit "native_database_compatible_package_installation=blocked;reason=$1"
  exit 1
}

unexpected_failure() {
  local status="$1" line="$2"
  trap - ERR
  set +e
  emit "native_database_compatible_package_installation=blocked;reason=unexpected_failure;exit_code=$status;line=$line"
  exit "$status"
}
trap 'status=$?; unexpected_failure "$status" "$LINENO"' ERR

if (( $# != 4 )); then
  block invalid_argument_count
fi

expected_hostname="$1"
expected_os_version="$2"
bundle_name="$3"
expected_bundle_sha256="$4"

[[ "$expected_hostname" =~ ^[A-Za-z0-9][A-Za-z0-9.-]*$ ]] \
  || block invalid_expected_hostname
[[ "$expected_os_version" =~ ^[0-9]{2}\.[0-9]{2}$ ]] \
  || block invalid_expected_os_version
[[ "$bundle_name" =~ ^[A-Za-z0-9._+-]+\.tar\.gz$ && "$bundle_name" != */* ]] \
  || block invalid_bundle_name
[[ "$expected_bundle_sha256" =~ ^[0-9a-f]{64}$ ]] \
  || block invalid_bundle_sha256
(( EUID == 0 )) || block root_authority_required

for required in apt-get awk bash chmod cmp cut df dpkg-deb dpkg-query find grep hostname mkdir mktemp rm sed sha256sum sort ss systemctl tar tr wc; do
  command -v "$required" >/dev/null 2>&1 || block "missing_command_$required"
done

actual_hostname="$(hostname -s)"
[[ "$actual_hostname" == "$expected_hostname" ]] || block hostname_mismatch

# shellcheck disable=SC1091
source /etc/os-release
[[ "${ID:-}" == ubuntu && "${VERSION_ID:-}" == "$expected_os_version" ]] \
  || block os_version_mismatch
architecture="$(dpkg --print-architecture)"
[[ "$architecture" == amd64 ]] || block architecture_mismatch

bundle_path="$PWD/$bundle_name"
[[ -f "$bundle_path" && ! -L "$bundle_path" && -r "$bundle_path" ]] \
  || block bundle_missing_or_unsafe
actual_bundle_sha256="$(sha256sum "$bundle_path" | awk '{print $1}')"
[[ "$actual_bundle_sha256" == "$expected_bundle_sha256" ]] \
  || block bundle_checksum_mismatch

work_root="$(mktemp -d /tmp/native-database-compatible-install.XXXXXX)"
policy_created=false
install_started=false

cleanup() {
  local status="$?"
  trap - EXIT INT TERM ERR
  set +e
  if [[ "$install_started" == true ]] && command -v systemctl >/dev/null 2>&1; then
    systemctl stop postgresql.service >/dev/null 2>&1 || true
    systemctl disable postgresql.service >/dev/null 2>&1 || true
  fi
  if [[ "$policy_created" == true && -f /usr/sbin/policy-rc.d ]]; then
    rm -f -- /usr/sbin/policy-rc.d
  fi
  if [[ "$work_root" == /tmp/native-database-compatible-install.* && -d "$work_root" ]]; then
    rm -rf -- "$work_root"
  fi
  exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'status=$?; unexpected_failure "$status" "$LINENO"' ERR

emit 'purpose=install_verified_compatible_native_database_packages_offline'
emit "host=$actual_hostname;os_version=$VERSION_ID;architecture=$architecture"
emit "bundle_sha256=$actual_bundle_sha256"
emit 'authorized_actions=verify_bundle_install_eight_missing_native_packages_disable_automatic_cluster_creation_keep_service_stopped_and_disabled_validate_runtime_remove_temporary_files'
emit 'non_actions=no_network_download_no_database_cluster_initialization_no_database_start_no_database_schema_or_role_creation_no_secret_or_content_read'

if tar -tzf "$bundle_path" \
    | awk '$0 ~ /^\// || $0 ~ /(^|\/)\.\.($|\/)/ {bad=1} END {exit bad ? 0 : 1}'; then
  block unsafe_archive_path
fi

extract_root="$work_root/extracted"
mkdir -p -- "$extract_root"
tar -xzf "$bundle_path" -C "$extract_root"
mapfile -t roots < <(find "$extract_root" -mindepth 1 -maxdepth 1 -type d -print | sort)
(( ${#roots[@]} == 1 )) || block invalid_bundle_root_count
root="${roots[0]}"
chmod 0755 "$work_root" "$extract_root" "$root" "$root/packages"

for required_file in capture_summary.env package_register.tsv license_manifest.tsv advisories/review.tsv SHA256SUMS; do
  [[ -f "$root/$required_file" && ! -L "$root/$required_file" ]] \
    || block "missing_$required_file"
done
(cd "$root" && sha256sum -c SHA256SUMS) >"$work_root/checksums.out" 2>"$work_root/checksums.err" \
  || block internal_checksum_failure
internal_checksum_count="$(wc -l <"$root/SHA256SUMS" | tr -d ' ')"

for expected_summary in \
  'schema=native-postgresql-compatible-capture/v1' \
  'target_os=ubuntu24.04' \
  'target_architecture=amd64' \
  'captured_package_count=9' \
  'postgresql_version=16.15-1.pgdg24.04+2' \
  'pgvector_version=0.8.7-1.pgdg24.04+1' \
  'llvm_version=1:19.1.1-1ubuntu1~24.04.2' \
  'pre_download_advisory_gate=pass' \
  'advisory_reviewed_source_count=7'; do
  grep -Fxq "$expected_summary" "$root/capture_summary.env" \
    || block capture_summary_mismatch
done

mapfile -t package_files < <(find "$root/packages" -maxdepth 1 -type f -name '*.deb' -print | sort)
(( ${#package_files[@]} == 9 )) || block package_count_mismatch
chmod 0644 "${package_files[@]}"

expected_packages="$work_root/expected-packages.tsv"
actual_packages="$work_root/actual-packages.tsv"
expected_names="$work_root/expected-package-names.txt"
required_install_names="$work_root/required-install-names.txt"
actual_plan_names="$work_root/actual-plan-names.txt"
printf '%s\n' \
  $'libjson-perl\t4.10000-1\tall' \
  $'libllvm19\t1:19.1.1-1ubuntu1~24.04.2\tamd64' \
  $'libpq5\t16.15-0ubuntu0.24.04.1\tamd64' \
  $'postgresql-16\t16.15-1.pgdg24.04+2\tamd64' \
  $'postgresql-16-pgvector\t0.8.7-1.pgdg24.04+1\tamd64' \
  $'postgresql-client-16\t16.15-0ubuntu0.24.04.1\tamd64' \
  $'postgresql-client-common\t257build1.1\tall' \
  $'postgresql-common\t257build1.1\tall' \
  $'python3-psycopg\t3.1.17-2\tall' \
  | sort >"$expected_packages"
: >"$actual_packages"
for package_file in "${package_files[@]}"; do
  printf '%s\t%s\t%s\n' \
    "$(dpkg-deb -f "$package_file" Package)" \
    "$(dpkg-deb -f "$package_file" Version)" \
    "$(dpkg-deb -f "$package_file" Architecture)" \
    >>"$actual_packages"
done
sort -o "$actual_packages" "$actual_packages"
cmp -s "$expected_packages" "$actual_packages" || block package_identity_mismatch
cut -f1 "$expected_packages" >"$expected_names"
grep -Fvx 'libllvm19' "$expected_names" >"$required_install_names"

register_rows="$(awk -F '\t' 'NR > 1 {count++} END {print count+0}' "$root/package_register.tsv")"
register_hash_mismatches="$(awk -F '\t' 'NR > 1 && $7 != $8 {count++} END {print count+0}' "$root/package_register.tsv")"
license_rows="$(awk -F '\t' 'NR > 1 {count++} END {print count+0}' "$root/license_manifest.tsv")"
missing_license_rows="$(awk -F '\t' 'NR > 1 && $3 != "present" {count++} END {print count+0}' "$root/license_manifest.tsv")"
advisory_rows="$(awk -F '\t' 'NR > 1 {count++} END {print count+0}' "$root/advisories/review.tsv")"
unaccepted_advisory_rows="$(awk -F '\t' 'NR > 1 && $5 !~ /^accepted/ {count++} END {print count+0}' "$root/advisories/review.tsv")"
[[ "$register_rows" == 9 && "$register_hash_mismatches" == 0 \
    && "$license_rows" == 9 && "$missing_license_rows" == 0 \
    && "$advisory_rows" == 7 && "$unaccepted_advisory_rows" == 0 ]] \
  || block review_manifest_mismatch

server_file="$root/packages/postgresql-16_16.15-1.pgdg24.04+2_amd64.deb"
vector_file="$root/packages/postgresql-16-pgvector_0.8.7-1.pgdg24.04+1_amd64.deb"
[[ "$(dpkg-deb -f "$server_file" Provides)" == *'postgresql-16-jit-llvm (= 19)'* \
    && "$(dpkg-deb -f "$server_file" Depends)" == *'libllvm19'* ]] \
  || block postgresql_jit_contract_mismatch
[[ "$(dpkg-deb -f "$vector_file" Breaks)" == *'postgresql-16-jit-llvm (<< 19)'* \
    && "$(dpkg-deb -f "$vector_file" Depends)" == *'postgresql-16'* ]] \
  || block pgvector_jit_contract_mismatch

llvm_state="$(dpkg-query -W -f='${db:Status-Abbrev}\t${Version}' libllvm19 2>/dev/null || true)"
IFS=$'\t' read -r llvm_status llvm_version <<<"$llvm_state"
[[ "$llvm_status" == ii* && "$llvm_version" == '1:19.1.1-1ubuntu1~24.04.2' ]] \
  || block libllvm19_installed_state_mismatch

unexpected_installed_count=0
while IFS= read -r package_name; do
  status="$(dpkg-query -W -f='${db:Status-Abbrev}' "$package_name" 2>/dev/null || true)"
  if [[ "$status" == ii* ]]; then
    unexpected_installed_count=$((unexpected_installed_count + 1))
  fi
done <"$required_install_names"
(( unexpected_installed_count == 0 )) || block selected_package_state_drift

if ss -H -ltn 'sport = :5432' 2>/dev/null | grep -q .; then
  block postgresql_port_in_use
fi
[[ "$(systemctl is-active postgresql.service 2>/dev/null || true)" != active ]] \
  || block postgresql_service_active
if command -v pg_lsclusters >/dev/null 2>&1; then
  cluster_count="$(pg_lsclusters --no-header 2>/dev/null | awk 'NF {count++} END {print count+0}')"
  (( cluster_count == 0 )) || block postgresql_cluster_state_drift
fi
[[ ! -e /usr/sbin/policy-rc.d ]] || block existing_service_start_policy_requires_review

available_var_kib="$(df -Pk /var | awk 'NR == 2 {print $4}')"
[[ "$available_var_kib" =~ ^[0-9]+$ ]] || block invalid_var_capacity
(( available_var_kib >= 2097152 )) || block insufficient_var_capacity

apt_options=(
  --no-install-recommends
  -o Dir::Etc::sourcelist=/dev/null
  -o Dir::Etc::sourceparts=/dev/null
  -o APT::Get::List-Cleanup=0
  -o Acquire::Languages=none
  -o Acquire::Retries=0
  -o Acquire::http::Proxy=http://127.0.0.1:9
  -o Acquire::https::Proxy=http://127.0.0.1:9
  -o Acquire::ftp::Proxy=ftp://127.0.0.1:9
)
simulation_stdout="$work_root/apt-simulation.stdout"
simulation_stderr="$work_root/apt-simulation.stderr"
if apt-get -s "${apt_options[@]}" install "${package_files[@]}" \
    >"$simulation_stdout" 2>"$simulation_stderr"; then
  simulation_exit_code=0
else
  simulation_exit_code=$?
fi
(( simulation_exit_code == 0 )) || block offline_apt_simulation_failed
awk '/^Inst / {print $2}' "$simulation_stdout" | sort -u >"$actual_plan_names"
simulation_install_count="$(wc -l <"$actual_plan_names" | tr -d ' ')"
simulation_remove_count="$(grep -Ec '^Remv ' "$simulation_stdout" || true)"
[[ "$simulation_install_count" == 8 && "$simulation_remove_count" == 0 ]] \
  || block offline_apt_simulation_plan_mismatch
grep -Fvx -f "$expected_names" "$actual_plan_names" | grep -q . \
  && block offline_apt_simulation_unexpected_package
while IFS= read -r required_name; do
  grep -Fxq "$required_name" "$actual_plan_names" \
    || block offline_apt_simulation_required_package_missing
done <"$required_install_names"

printf '%s\n' '#!/bin/sh' 'exit 101' >/usr/sbin/policy-rc.d
chmod 0755 /usr/sbin/policy-rc.d
policy_created=true
install_started=true

support_packages=(
  "$root/packages/libjson-perl_4.10000-1_all.deb"
  "$root/packages/libpq5_16.15-0ubuntu0.24.04.1_amd64.deb"
  "$root/packages/postgresql-client-16_16.15-0ubuntu0.24.04.1_amd64.deb"
  "$root/packages/postgresql-client-common_257build1.1_all.deb"
  "$root/packages/postgresql-common_257build1.1_all.deb"
  "$root/packages/python3-psycopg_3.1.17-2_all.deb"
)
server_packages=(
  "$server_file"
  "$vector_file"
)

support_stdout="$work_root/support-install.stdout"
support_stderr="$work_root/support-install.stderr"
if apt-get --yes "${apt_options[@]}" install "${support_packages[@]}" \
    >"$support_stdout" 2>"$support_stderr"; then
  support_exit_code=0
else
  support_exit_code=$?
fi
emit "support_package_install_exit_code=$support_exit_code;stdout_sha256=$(sha256sum "$support_stdout" | awk '{print $1}');stderr_sha256=$(sha256sum "$support_stderr" | awk '{print $1}')"
(( support_exit_code == 0 )) || block support_package_install_failed

command -v pg_conftool >/dev/null 2>&1 || block pg_conftool_missing_after_support_install
pg_conftool /etc/postgresql-common/createcluster.conf set create_main_cluster false \
  >"$work_root/cluster-policy.stdout" 2>"$work_root/cluster-policy.stderr" \
  || block automatic_cluster_policy_configuration_failed
cluster_policy="$(pg_conftool /etc/postgresql-common/createcluster.conf show -bs create_main_cluster 2>/dev/null || true)"
[[ "$cluster_policy" == off ]] || block automatic_cluster_policy_not_disabled

server_stdout="$work_root/server-install.stdout"
server_stderr="$work_root/server-install.stderr"
if apt-get --yes "${apt_options[@]}" install "${server_packages[@]}" \
    >"$server_stdout" 2>"$server_stderr"; then
  server_exit_code=0
else
  server_exit_code=$?
fi
emit "server_package_install_exit_code=$server_exit_code;stdout_sha256=$(sha256sum "$server_stdout" | awk '{print $1}');stderr_sha256=$(sha256sum "$server_stderr" | awk '{print $1}')"
(( server_exit_code == 0 )) || block server_package_install_failed
if grep -Eiq 'https?://|ftp://' "$support_stdout" "$support_stderr" "$server_stdout" "$server_stderr"; then
  block unexpected_network_package_source
fi

systemctl stop postgresql.service >/dev/null 2>&1 || true
systemctl disable postgresql.service >"$work_root/systemctl-disable.stdout" 2>"$work_root/systemctl-disable.stderr" \
  || block postgresql_service_disable_failed

package_validation_count=0
while IFS=$'\t' read -r package_name expected_version expected_architecture; do
  installed="$(dpkg-query -W -f='${db:Status-Abbrev}\t${Version}\t${Architecture}' "$package_name" 2>/dev/null || true)"
  IFS=$'\t' read -r installed_status installed_version installed_architecture <<<"$installed"
  [[ "$installed_status" == ii* && "$installed_version" == "$expected_version" \
      && "$installed_architecture" == "$expected_architecture" ]] \
    || block installed_package_validation_failed
  package_validation_count=$((package_validation_count + 1))
done <"$expected_packages"
(( package_validation_count == 9 )) || block installed_package_count_mismatch

apt_check_stdout="$work_root/apt-check.stdout"
apt_check_stderr="$work_root/apt-check.stderr"
apt-get check \
  -o Dir::Etc::sourcelist=/dev/null \
  -o Dir::Etc::sourceparts=/dev/null \
  -o APT::Get::List-Cleanup=0 \
  >"$apt_check_stdout" 2>"$apt_check_stderr" \
  || block apt_dependency_check_failed

command -v pg_lsclusters >/dev/null 2>&1 || block pg_lsclusters_missing_after_install
cluster_count="$(pg_lsclusters --no-header 2>/dev/null | awk 'NF {count++} END {print count+0}')"
(( cluster_count == 0 )) || block unexpected_database_cluster_created
[[ ! -d /var/lib/postgresql/16/main ]] || block unexpected_database_data_directory_created
if ss -H -ltn 'sport = :5432' 2>/dev/null | grep -q .; then
  block unexpected_postgresql_listener
fi
service_active="$(systemctl is-active postgresql.service 2>/dev/null || true)"
service_enabled="$(systemctl is-enabled postgresql.service 2>/dev/null || true)"
[[ "$service_active" != active ]] || block postgresql_service_unexpectedly_active
[[ "$service_enabled" == disabled ]] || block postgresql_service_unexpectedly_enabled

postgresql_version="$(/usr/lib/postgresql/16/bin/postgres --version | awk '{print $3}')"
psql_version="$(/usr/lib/postgresql/16/bin/psql --version | awk '{print $3}')"
psycopg_version="$(/usr/bin/python3 -c 'import psycopg; print(psycopg.__version__)')"
[[ "$postgresql_version" == 16.15 && "$psql_version" == 16.15 && "$psycopg_version" == 3.1.17 ]] \
  || block installed_runtime_version_mismatch
[[ -f /usr/share/postgresql/16/extension/vector.control ]] \
  || block pgvector_extension_control_missing

package_set="$(tr '\n' ',' <"$expected_names" | sed 's/,$//')"
emit "internal_checksum_count=$internal_checksum_count;reviewed_package_count=$register_rows;installed_package_count=$package_validation_count"
emit "package_set=$package_set"
emit "postgresql_version=$postgresql_version;psql_version=$psql_version;pgvector_version=0.8.7;psycopg_version=$psycopg_version"
emit "automatic_cluster_creation=$cluster_policy;postgresql_clusters=$cluster_count;postgresql_port_5432=free"
emit "postgresql_service_active=$service_active;postgresql_service_enabled=$service_enabled;network_download=disabled"
emit 'package_acquisition=local_file_paths;package_sources=disabled;network_proxies=loopback_reject'
emit 'database_initialization=false;database_schema_or_role_creation=false'
emit 'native_database_compatible_package_installation=pass'
