#!/usr/bin/env bash
set -Eeuo pipefail

# Measure one synthetic grounded request with the tokenizer bound to the
# installed generation profile. This environment-neutral helper runs through
# attended sudo. It reads no credential and calls no model endpoint.

readonly SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
readonly MEASURER="$SCRIPT_DIR/measure_composed_generation_request.py"

[[ "$EUID" -eq 0 ]] || {
  printf '[composed-request] result=BLOCKED reason=root_execution_required\n' >&2
  exit 1
}
[[ -f "$MEASURER" && ! -L "$MEASURER" ]] || {
  printf '[composed-request] result=BLOCKED reason=measurer_missing_or_unsafe\n' >&2
  exit 1
}

status=0
python3 "$MEASURER" "$@" || status=$?

output_path=""
expect_output=false
for argument in "$@"; do
  if [[ "$expect_output" == true ]]; then
    output_path="$argument"
    expect_output=false
  elif [[ "$argument" == --output ]]; then
    expect_output=true
  elif [[ "$argument" == --output=* ]]; then
    output_path="${argument#--output=}"
  fi
done
if (( status == 0 )) && [[ -n "$output_path" && -f "$output_path" ]]; then
  if [[ "${SUDO_UID:-}" =~ ^[0-9]+$ && "${SUDO_GID:-}" =~ ^[0-9]+$ ]]; then
    chown "$SUDO_UID:$SUDO_GID" -- "$output_path" || {
      printf '[composed-request] result=BLOCKED reason=artifact_ownership_return_failed\n' >&2
      status=1
    }
  fi
fi
exit "$status"
