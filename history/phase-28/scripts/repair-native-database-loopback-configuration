#!/usr/bin/env bash
set -Eeuo pipefail

# Repair the one known invalid PostgreSQL listen_addresses line. The helper
# validates the complete replacement configuration while the cluster remains
# stopped. It does not start PostgreSQL or create any database object.

umask 077
export SYSTEMD_PAGER=cat
export SYSTEMD_LESS=FRX
export NO_COLOR=1

emit() {
  printf '%s\n' "$1"
}

block() {
  emit "native_database_loopback_configuration_repair=blocked;reason=$1"
  exit 1
}

unexpected_failure() {
  local status="$1" line="$2"
  trap - ERR
  set +e
  emit "native_database_loopback_configuration_repair=blocked;reason=unexpected_failure;exit_code=$status;line=$line"
  exit "$status"
}
trap 'status=$?; unexpected_failure "$status" "$LINENO"' ERR

if (( $# != 2 )); then
  block invalid_argument_count
fi

expected_hostname="$1"
expected_os_version="$2"
[[ "$expected_hostname" =~ ^[A-Za-z0-9][A-Za-z0-9.-]*$ ]] \
  || block invalid_expected_hostname
[[ "$expected_os_version" =~ ^[0-9]{2}\.[0-9]{2}$ ]] \
  || block invalid_expected_os_version
(( EUID == 0 )) || block root_authority_required

for required in awk chmod chown dpkg dpkg-query grep hostname mktemp mv pg_conftool pg_lsclusters rm runuser sed sha256sum ss stat systemctl tr wc; do
  command -v "$required" >/dev/null 2>&1 || block "missing_command_$required"
done
[[ -x /usr/lib/postgresql/16/bin/pg_controldata ]] \
  || block pg_controldata_missing
[[ -x /usr/lib/postgresql/16/bin/postgres ]] \
  || block postgres_binary_missing

actual_hostname="$(hostname -s)"
[[ "$actual_hostname" == "$expected_hostname" ]] || block hostname_mismatch
# shellcheck disable=SC1091
source /etc/os-release
[[ "${ID:-}" == ubuntu && "${VERSION_ID:-}" == "$expected_os_version" ]] \
  || block os_version_mismatch
architecture="$(dpkg --print-architecture)"
[[ "$architecture" == amd64 ]] || block architecture_mismatch

postgresql_version="$(/usr/lib/postgresql/16/bin/postgres --version | awk '{print $3}')"
support_version="$(dpkg-query -W -f='${Version}' postgresql-client-common 2>/dev/null || true)"
[[ "$postgresql_version" == 16.15 ]] || block postgresql_version_mismatch
[[ "$support_version" == 257build1.1 ]] || block postgresql_support_version_mismatch

cluster_line="$(pg_lsclusters --no-header 2>/dev/null || true)"
cluster_count="$(awk 'NF {count++} END {print count+0}' <<<"$cluster_line")"
(( cluster_count == 1 )) || block database_cluster_count_mismatch
read -r cluster_version cluster_name cluster_port cluster_status cluster_owner cluster_data_directory cluster_log_file \
  <<<"$cluster_line"
[[ "$cluster_version" == 16 && "$cluster_name" == main && "$cluster_port" == 5432 \
    && "$cluster_status" == down && "$cluster_owner" == postgres \
    && "$cluster_data_directory" == /var/lib/postgresql/16/main \
    && "$cluster_log_file" == /var/log/postgresql/postgresql-16-main.log ]] \
  || block database_cluster_contract_mismatch

config_path=/etc/postgresql/16/main/postgresql.conf
[[ -f "$config_path" && ! -L "$config_path" ]] \
  || block postgresql_configuration_missing_or_unsafe
config_identity_before="$(stat -c '%U:%G|%a' "$config_path")"
[[ "$config_identity_before" == 'postgres:postgres|644' ]] \
  || block postgresql_configuration_identity_mismatch
[[ "$(sed -n 's/^[[:space:]]*\([^#[:space:]][^#[:space:]]*\)[[:space:]]*$/\1/p' /etc/postgresql/16/main/start.conf)" == manual ]] \
  || block database_cluster_start_policy_mismatch
[[ "$(pg_conftool 16 main show -s listen_addresses 2>/dev/null || true)" == 127.0.0.1 ]] \
  || block unexpected_listen_address_value
[[ "$(pg_conftool 16 main show -s password_encryption 2>/dev/null || true)" == scram-sha-256 ]] \
  || block password_encryption_mismatch

active_listen_line_count="$(awk '/^[[:space:]]*listen_addresses[[:space:]]*=/ {count++} END {print count+0}' "$config_path")"
(( active_listen_line_count == 1 )) || block unexpected_active_listen_address_line_count

[[ "$(systemctl is-active postgresql.service 2>/dev/null || true)" != active ]] \
  || block postgresql_service_active
[[ "$(systemctl is-enabled postgresql.service 2>/dev/null || true)" == disabled ]] \
  || block postgresql_service_not_disabled
[[ "$(systemctl is-active postgresql@16-main.service 2>/dev/null || true)" != active ]] \
  || block postgresql_cluster_service_active
if ss -H -ltn 'sport = :5432' 2>/dev/null | grep -q .; then
  block postgresql_port_in_use
fi

control_data="$(/usr/lib/postgresql/16/bin/pg_controldata /var/lib/postgresql/16/main 2>/dev/null || true)"
cluster_control_state="$(awk -F: '/^Database cluster state:/ {sub(/^[[:space:]]+/, "", $2); gsub(/[[:space:]]+/, "_", $2); print $2}' <<<"$control_data")"
[[ "$cluster_control_state" == shut_down ]] || block database_cluster_not_shut_down

config_sha256_before="$(sha256sum "$config_path" | awk '{print $1}')"
non_target_sha256_before="$(awk '!/^[[:space:]]*listen_addresses[[:space:]]*=/' "$config_path" | sha256sum | awk '{print $1}')"
line_count_before="$(wc -l <"$config_path" | tr -d ' ')"
candidate="$(mktemp /etc/postgresql/16/main/postgresql.conf.loopback-repair.XXXXXX)"

cleanup() {
  local status="$?"
  trap - EXIT INT TERM ERR
  set +e
  if [[ "$candidate" == /etc/postgresql/16/main/postgresql.conf.loopback-repair.* && -f "$candidate" ]]; then
    rm -f -- "$candidate"
  fi
  exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'status=$?; unexpected_failure "$status" "$LINENO"' ERR

emit 'purpose=repair_native_database_loopback_configuration'
emit "host=$actual_hostname;os_version=$VERSION_ID;architecture=$architecture"
emit "postgresql_version=$postgresql_version;postgresql_support_version=$support_version"
emit "cluster_version=$cluster_version;cluster_name=$cluster_name;cluster_port=$cluster_port;cluster_status=$cluster_status"
emit "active_listen_address_lines_before=$active_listen_line_count;effective_listen_address_before=127.0.0.1"
emit "configuration_sha256_before=$config_sha256_before;configuration_line_count_before=$line_count_before"
emit 'identified_cause=unquoted_ipv4_listen_address_written_by_configuration_helper'
emit 'authorized_actions=replace_one_invalid_listen_address_line_validate_complete_configuration_preserve_configuration_identity'
emit 'non_actions=no_network_access_no_package_change_no_database_start_stop_restart_enable_disable_or_reset_no_database_query_or_object_change_no_secret_or_content_read'

awk '
  /^[[:space:]]*listen_addresses[[:space:]]*=/ {
    count++
    comment=""
    if (match($0, /[[:space:]]*#/)) {
      comment=substr($0, RSTART)
    }
    print "listen_addresses = '\''127.0.0.1'\''" comment
    next
  }
  { print }
  END { if (count != 1) exit 42 }
' "$config_path" >"$candidate" || block loopback_configuration_candidate_generation_failed

chown --reference="$config_path" "$candidate"
chmod --reference="$config_path" "$candidate"
[[ "$(stat -c '%U:%G|%a' "$candidate")" == "$config_identity_before" ]] \
  || block candidate_configuration_identity_mismatch
line_count_candidate="$(wc -l <"$candidate" | tr -d ' ')"
[[ "$line_count_candidate" == "$line_count_before" ]] \
  || block candidate_configuration_line_count_mismatch
non_target_sha256_candidate="$(awk '!/^[[:space:]]*listen_addresses[[:space:]]*=/' "$candidate" | sha256sum | awk '{print $1}')"
[[ "$non_target_sha256_candidate" == "$non_target_sha256_before" ]] \
  || block candidate_contains_unexpected_change
quoted_loopback_line_count="$(awk '/^[[:space:]]*listen_addresses[[:space:]]*=[[:space:]]*'\''127[.]0[.]0[.]1'\''([[:space:]]*#.*)?$/ {count++} END {print count+0}' "$candidate")"
(( quoted_loopback_line_count == 1 )) || block quoted_loopback_candidate_missing

candidate_probe="$(runuser -u postgres -- /usr/lib/postgresql/16/bin/postgres \
  -D /var/lib/postgresql/16/main \
  --config-file="$candidate" \
  -C data_directory 2>/dev/null || true)"
[[ "$candidate_probe" == /var/lib/postgresql/16/main ]] \
  || block candidate_configuration_probe_failed

mv -- "$candidate" "$config_path"

[[ "$(stat -c '%U:%G|%a' "$config_path")" == "$config_identity_before" ]] \
  || block repaired_configuration_identity_mismatch
[[ "$(pg_conftool 16 main show -s listen_addresses 2>/dev/null || true)" == 127.0.0.1 ]] \
  || block repaired_listen_address_value_mismatch
quoted_loopback_line_count_after="$(awk '/^[[:space:]]*listen_addresses[[:space:]]*=[[:space:]]*'\''127[.]0[.]0[.]1'\''([[:space:]]*#.*)?$/ {count++} END {print count+0}' "$config_path")"
(( quoted_loopback_line_count_after == 1 )) \
  || block repaired_quoted_loopback_line_missing

final_probe="$(runuser -u postgres -- /usr/lib/postgresql/16/bin/postgres \
  -D /var/lib/postgresql/16/main \
  --config-file="$config_path" \
  -C data_directory 2>/dev/null || true)"
[[ "$final_probe" == /var/lib/postgresql/16/main ]] \
  || block repaired_configuration_probe_failed

config_sha256_after="$(sha256sum "$config_path" | awk '{print $1}')"
configuration_content_changed=true
[[ "$config_sha256_after" != "$config_sha256_before" ]] \
  || configuration_content_changed=false
[[ "$(systemctl is-active postgresql@16-main.service 2>/dev/null || true)" != active ]] \
  || block postgresql_cluster_service_unexpectedly_active
if ss -H -ltn 'sport = :5432' 2>/dev/null | grep -q .; then
  block postgresql_listener_unexpectedly_present
fi

emit "quoted_loopback_lines_after=$quoted_loopback_line_count_after;configuration_probe=pass"
emit "configuration_sha256_after=$config_sha256_after;configuration_line_count_after=$line_count_candidate"
emit "configuration_content_changed=$configuration_content_changed"
emit "configuration_owner=postgres;configuration_group=postgres;configuration_mode=644"
emit 'listen_addresses=127.0.0.1;listen_address_storage=quoted_ipv4_literal'
emit 'cluster_status=down;postgresql_port_5432=free;service_start_attempted=false'
emit 'database_query_performed=false;database_change_performed=false;secret_processed=false'
emit 'native_database_loopback_configuration_repair=pass'
