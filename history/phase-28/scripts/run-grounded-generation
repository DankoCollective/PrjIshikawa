#!/usr/bin/env bash
set -Eeuo pipefail
export PYTHONDONTWRITEBYTECODE=1

# Run one bounded synthetic grounded-generation request while preserving the
# initial managed generation-service state. Run as root through attended sudo.

readonly SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
readonly QUALIFIER="$SCRIPT_DIR/run_grounded_generation.py"
readonly UNIT="vllm-gemma.service"
readonly START_COMMAND="/usr/local/sbin/start-vllm"
readonly STOP_COMMAND="/usr/local/sbin/stop-vllm"

[[ "$EUID" -eq 0 ]] || {
  printf '[grounded-generation] result=BLOCKED reason=root_execution_required\n' >&2
  exit 1
}
[[ -f "$QUALIFIER" && ! -L "$QUALIFIER" ]] || {
  printf '[grounded-generation] result=BLOCKED reason=qualifier_missing_or_unsafe\n' >&2
  exit 1
}

started_by_qualifier=false
gemma_api_key=""
cleanup() {
  local original_status="$?"
  trap - EXIT INT TERM
  unset gemma_api_key
  if [[ "$started_by_qualifier" == true ]]; then
    if "$STOP_COMMAND" gemma >/dev/null 2>&1; then
      printf '[grounded-generation] cleanup=pass service_state=restored_inactive\n'
    else
      printf '[grounded-generation] cleanup=failed service_state=review_required\n' >&2
      original_status=1
    fi
  else
    printf '[grounded-generation] cleanup=not_required service_state=left_active\n'
  fi
  exit "$original_status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

if systemctl is-active --quiet "$UNIT"; then
  printf '[grounded-generation] initial_service_state=active action=preserve\n'
else
  [[ -x "$START_COMMAND" && -x "$STOP_COMMAND" ]] || {
    printf '[grounded-generation] result=BLOCKED reason=managed_service_commands_missing\n' >&2
    exit 1
  }
  printf '[grounded-generation] initial_service_state=inactive action=temporary_start\n'
  if ! "$START_COMMAND" gemma >/dev/null 2>&1; then
    printf '[grounded-generation] result=BLOCKED reason=temporary_service_start_failed\n' >&2
    exit 1
  fi
  started_by_qualifier=true
fi

[[ -r /dev/tty && -w /dev/tty ]] || {
  printf '[grounded-generation] result=BLOCKED reason=attended_tty_unavailable\n' >&2
  exit 1
}
printf 'Enter the Gemma API key: ' >/dev/tty
if ! IFS= read -r -s gemma_api_key </dev/tty; then
  printf '\n' >/dev/tty
  printf '[grounded-generation] result=BLOCKED reason=credential_entry_failed\n' >&2
  exit 1
fi
printf '\n' >/dev/tty
if (( ${#gemma_api_key} < 32 || ${#gemma_api_key} > 1024 )); then
  unset gemma_api_key
  printf '[grounded-generation] result=BLOCKED reason=operator_credential_format_invalid\n' >&2
  exit 1
fi

printf '[grounded-generation] credential_source=operator_attended_tty stored_credential_read=false\n'
qualification_status=0
printf '%s' "$gemma_api_key" \
  | python3 "$QUALIFIER" --credential-stdin "$@" \
  || qualification_status=$?
unset gemma_api_key

output_path=""
rejected_output_path=""
expect_output=false
expect_rejected_output=false
for argument in "$@"; do
  if [[ "$expect_output" == true ]]; then
    output_path="$argument"
    expect_output=false
  elif [[ "$expect_rejected_output" == true ]]; then
    rejected_output_path="$argument"
    expect_rejected_output=false
  elif [[ "$argument" == --output ]]; then
    expect_output=true
  elif [[ "$argument" == --rejected-output ]]; then
    expect_rejected_output=true
  elif [[ "$argument" == --output=* ]]; then
    output_path="${argument#--output=}"
  elif [[ "$argument" == --rejected-output=* ]]; then
    rejected_output_path="${argument#--rejected-output=}"
  fi
done
for artifact_path in "$output_path" "$rejected_output_path"; do
  [[ -n "$artifact_path" && -f "$artifact_path" ]] || continue
  if [[ "${SUDO_UID:-}" =~ ^[0-9]+$ && "${SUDO_GID:-}" =~ ^[0-9]+$ ]]; then
    chown "$SUDO_UID:$SUDO_GID" -- "$artifact_path" || {
      printf '[grounded-generation] result=BLOCKED reason=artifact_ownership_return_failed\n' >&2
      qualification_status=1
    }
  fi
done
exit "$qualification_status"
