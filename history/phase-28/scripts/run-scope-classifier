#!/usr/bin/env bash
set -Eeuo pipefail
export PYTHONDONTWRITEBYTECODE=1

# Run one bounded synthetic scope-classifier request while preserving the
# initial managed generation-service state. Run as root through attended sudo.

readonly SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
readonly QUALIFIER="$SCRIPT_DIR/run_scope_classifier.py"
readonly UNIT="vllm-gemma.service"
readonly START_COMMAND="/usr/local/sbin/start-vllm"
readonly STOP_COMMAND="/usr/local/sbin/stop-vllm"

[[ "$EUID" -eq 0 ]] || { printf '[scope-classifier] result=BLOCKED reason=root_execution_required\n' >&2; exit 1; }
[[ -f "$QUALIFIER" && ! -L "$QUALIFIER" ]] || { printf '[scope-classifier] result=BLOCKED reason=qualifier_missing_or_unsafe\n' >&2; exit 1; }

started_by_qualifier=false
gemma_api_key=""
cleanup() {
  local original_status="$?"
  trap - EXIT INT TERM
  unset gemma_api_key
  if [[ "$started_by_qualifier" == true ]]; then
    if "$STOP_COMMAND" gemma >/dev/null 2>&1; then
      printf '[scope-classifier] cleanup=pass service_state=restored_inactive\n'
    else
      printf '[scope-classifier] cleanup=failed service_state=review_required\n' >&2
      original_status=1
    fi
  else
    printf '[scope-classifier] cleanup=not_required service_state=left_active\n'
  fi
  exit "$original_status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

if systemctl is-active --quiet "$UNIT"; then
  printf '[scope-classifier] initial_service_state=active action=preserve\n'
else
  [[ -x "$START_COMMAND" && -x "$STOP_COMMAND" ]] || { printf '[scope-classifier] result=BLOCKED reason=managed_service_commands_missing\n' >&2; exit 1; }
  printf '[scope-classifier] initial_service_state=inactive action=temporary_start\n'
  "$START_COMMAND" gemma >/dev/null 2>&1 || { printf '[scope-classifier] result=BLOCKED reason=temporary_service_start_failed\n' >&2; exit 1; }
  started_by_qualifier=true
fi

[[ -r /dev/tty && -w /dev/tty ]] || { printf '[scope-classifier] result=BLOCKED reason=attended_tty_unavailable\n' >&2; exit 1; }
printf 'Enter the Gemma API key: ' >/dev/tty
if ! IFS= read -r -s gemma_api_key </dev/tty; then
  printf '\n' >/dev/tty
  printf '[scope-classifier] result=BLOCKED reason=credential_entry_failed\n' >&2
  exit 1
fi
printf '\n' >/dev/tty
if (( ${#gemma_api_key} < 32 || ${#gemma_api_key} > 1024 )); then
  unset gemma_api_key
  printf '[scope-classifier] result=BLOCKED reason=operator_credential_format_invalid\n' >&2
  exit 1
fi

printf '[scope-classifier] credential_source=operator_attended_tty stored_credential_read=false\n'
qualification_status=0
printf '%s' "$gemma_api_key" | python3 "$QUALIFIER" --credential-stdin "$@" || qualification_status=$?
unset gemma_api_key

for option in --output --rejected-output; do
  value=""
  expect=false
  for argument in "$@"; do
    if [[ "$expect" == true ]]; then value="$argument"; expect=false
    elif [[ "$argument" == "$option" ]]; then expect=true
    elif [[ "$argument" == "$option="* ]]; then value="${argument#*=}"
    fi
  done
  [[ -n "$value" && -f "$value" ]] || continue
  if [[ "${SUDO_UID:-}" =~ ^[0-9]+$ && "${SUDO_GID:-}" =~ ^[0-9]+$ ]]; then
    chown "$SUDO_UID:$SUDO_GID" -- "$value" || { printf '[scope-classifier] result=BLOCKED reason=artifact_ownership_return_failed\n' >&2; qualification_status=1; }
  fi
done
exit "$qualification_status"
